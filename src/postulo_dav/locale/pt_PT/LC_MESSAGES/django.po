#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d eventos do calendário não vêm do Postulo e ficaram como estavam."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s removida do calendário noutro dispositivo; mantida aqui."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sem empresa)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Um contacto eliminado aqui tinha sido alterado no telemóvel desde a última sincronização. O cartão ficou no livro de endereços e volta como contacto na próxima execução."

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Livro de endereços"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Uma palavra-passe de aplicação se o servidor a oferecer. Guardada cifrada."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Uma entrevista mudou dos dois lados ao mesmo tempo; a próxima execução decide."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Uma entrevista eliminada aqui tinha sido alterada no telemóvel desde a última sincronização. O evento ficou no calendário."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Uma entrevista mudou para outro endereço no calendário; continua emparelhada."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendário"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Cancelado no calendário."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV e CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Alterado aqui em %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Alterado aqui, mas alterado no telemóvel mais tarde; ficou a deles."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Alterado no telemóvel em %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Alterado no telemóvel, mas alterado aqui mais tarde; ficou a nossa versão."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Encontrados o livro de endereços «%(book)s» e o calendário «%(calendar)s»."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it could not be saved here"
msgstr "não foi possível guardá-lo aqui"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it has no time zone"
msgstr "não tem fuso horário"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it is an all-day event"
msgstr "é um evento de dia inteiro"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "its address or identifier is too long"
msgstr "o seu endereço ou identificador é demasiado longo"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "its time cannot be read"
msgstr "não é possível ler a sua hora"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "o seu fuso horário “%(zone)s” não é conhecido aqui"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Criado no servidor pela primeira sincronização se não existir, exceto com a opção Só leitura ativada. Só este livro de endereços é tocado."

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Criado no servidor pela primeira sincronização se não existir, exceto com a opção Só leitura ativada. Só este calendário é tocado."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nunca escrever no servidor — nem sequer para criar o livro de endereços ou o calendário. Os contactos e as entrevistas continuam a entrar; nada sai."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Em http:// a palavra-passe atravessa a rede em claro, e «%(host)s» não é um endereço da sua própria rede. Use https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Palavra-passe ou palavra-passe de aplicação"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Só leitura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "só leitura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "A opção Só leitura está ativada, por isso nada é criado: crie-o no servidor, ou indique um que já exista."

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Endereço do servidor"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "O %(kind)s no calendário termina antes de começar, por isso não foi movido."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "O livro de endereços «%(name)s» não está no servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "O endereço tem de começar por https:// — por exemplo %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "O calendário «%(name)s» não está no servidor."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "A primeira sincronização cria o que falta."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "O servidor respondeu HTTP %(status)d a %(method)s %(path)s."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "O servidor não indica uma pasta de calendários."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "O servidor não indica uma pasta de livros de endereços."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "O servidor não indica onde está a conta de %(kind)s."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "O servidor apontou para um endereço fora do seu domínio (%(host)s); não foi seguido."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server redirected %(path)s too many times."
msgstr "O servidor redirecionou %(path)s demasiadas vezes."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server refused the user name or password."
msgstr "O servidor recusou o nome de utilizador ou a palavra-passe."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "O endereço do servidor, p. ex. https://cloud.example.org, ou o endereço do seu serviço DAV quando este está num caminho, p. ex. https://example.org/dav.php/. O Postulo encontra a partir daí as pastas de livros de endereços e de calendários."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Não foi possível ler a resposta do servidor: %(error)s"

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "A resposta do servidor para %(path)s era demasiado grande ou demasiado lenta e não foi lida."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Não foi possível usar a hora do %(kind)s no calendário (%(why)s), por isso não foi movido."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Nome de utilizador"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» mudou dos dois lados ao mesmo tempo; a próxima execução decide."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "“%(name)s” foi alterado nos dois lados e o cartão do telemóvel não indica hora: foi usada a versão do telemóvel."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "“%(name)s” é compartilhado com você apenas para ler; a mudança no telefone não foi aplicada."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "“%(name)s” foi movido para outro endereço no servidor; ainda emparelhado."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» foi removido do livro de endereços; mantido aqui."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "“%(name)s” foi ignorado: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "“%(name)s”: o número no cartão já é mantido por outro registro aqui, por isso não foi tomado."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "“%(name)s”: o número no cartão não foi tomado."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "“%(name)s”: o endereço web no cartão não é um endereço web, por isso não foi tomado."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "“%(name)s”: o endereço web no cartão não foi tomado."
