#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d events on the calendar are not from Postulo and were left alone."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s removed from the calendar on another device; kept here."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(no company)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Address book"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "An app password where the server offers one. Stored encrypted."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "An interview changed on both sides at once; next run decides."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "An interview moved to another address on the calendar; still paired."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendar"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Cancelled on the calendar."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV and CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Changed here on %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Changed here, but changed on the phone later; took theirs."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Changed on the phone on %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Changed on the phone, but changed here later; kept ours."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Found the address book “%(book)s” and the calendar “%(calendar)s”."

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "it could not be saved here"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "it has no time zone"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "it is an all-day event"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "its address or identifier is too long"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "its time cannot be read"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "its time zone “%(zone)s” is not known here"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Password or app password"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Read only"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "read only"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Read only is on, so nothing is made: create it on the server, or name one that is already there."

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Server address"

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "The %(kind)s on the calendar ends before it starts, so it was not moved."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "The address book “%(name)s” is not on the server."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "The address must start with https:// — for example %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "The calendar “%(name)s” is not on the server."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "The first sync will make what is missing."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "The server answered HTTP %(status)d for %(method)s %(path)s."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "The server does not name a calendar home."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "The server does not name an address book home."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "The server does not say where the %(kind)s account is."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "The server pointed to an address outside its own (%(host)s); it was not followed."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "The server redirected %(path)s too many times."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "The server refused the user name or password."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "The server's answer could not be read: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "The server's answer for %(path)s was too large or too slow, and was not read."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Username"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "“%(name)s” changed on both sides at once; next run decides."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "“%(name)s” is shared with you to read only; the change on the phone was not applied."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "“%(name)s” moved to another address on the server; still paired."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” was removed from the address book; kept here."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "“%(name)s” was skipped: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "“%(name)s”: the number on the card is already held by another record here, so it was not taken."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "“%(name)s”: the number on the card was not taken."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "“%(name)s”: the web address on the card is not a web address, so it was not taken."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "“%(name)s”: the web address on the card was not taken."
