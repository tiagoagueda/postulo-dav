#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d coleção escolhida"
msgstr[1] "%(count)d coleções escolhidas"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d eventos do calendário não vêm do Postulo e ficaram como estavam."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d registos estão pareados com algo fora da coleção escolhida e foram deixados como estavam."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d registos não foram enviados, porque o envio desse tipo está desativado."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d tarefa na lista de tarefas não é do Postulo e foi deixada como estava."
msgstr[1] "%(count)d tarefas na lista de tarefas não são do Postulo e foram deixadas como estavam."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: removido do calendário em outro dispositivo; mantido aqui."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s não é um dos backups que este destino guarda, por isso não foi excluído."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sem empresa)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(sem título)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Um cartão não pode ser convertido nisso."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Um contato excluído aqui tinha sido alterado no celular desde a última sincronização. O cartão ficou no catálogo de endereços e volta como contato na próxima execução."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Já existe outro arquivo chamado %(name)s na pasta, e ele não foi sobrescrito."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Um lembrete foi alterado nos dois lados ao mesmo tempo; a próxima execução decide."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Um lembrete excluído aqui tinha sido alterado no celular desde a última sincronização. A tarefa foi deixada na lista de tarefas."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Um pedido fora das coleções escolhidas não foi enviado."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Uma tarefa foi alterada nos dois lados ao mesmo tempo; a próxima execução decide."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Uma tarefa mudou para outro endereço; continua pareada."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "catálogo de endereços"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Catálogo de endereços"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Catálogos de endereços"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "endereços"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Tudo na pasta, com nomes descritivos"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Todos"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Manter também duas tarefas por candidatura na lista de tarefas: uma para candidatar-se, que ao ser marcada lhe envia uma sugestão, e outra para obter resposta, que se fecha quando a candidatura termina. Os lembretes sobre uma candidatura ficam sob a respetiva tarefa em aberto."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Grave também os dias inteiros da página Calendário (prazos de candidaturas, datas de encerramento de vagas e datas até as quais uma oferta deve ser respondida) no calendário como eventos de dia inteiro, em um só sentido: uma alteração feita no celular é sobrescrita. Requer que a instância conheça o próprio endereço."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Uma senha de app, se o servidor oferecer uma. Armazenada criptografada."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Uma entrevista mudou dos dois lados ao mesmo tempo; a próxima execução decide."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Uma entrevista excluída aqui tinha sido alterada no celular desde a última sincronização. O evento ficou no calendário."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Uma entrevista mudou para outro endereço no calendário; continua pareada."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Candidatar-se a %(role)s em %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Por empresa e cargo, cada um em sua própria pasta"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "calendário"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendário"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Calendários"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Cancelado no calendário."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV e CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Alterado aqui em %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Alterado aqui, mas alterado depois no celular; ficou a versão de lá."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Alterado no celular em %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Alterado no celular, mas alterado depois aqui; ficou a nossa versão."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Coleções"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Prazos e datas"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Endereço da pasta"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Encontrado: %(what)s “%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Encontrado o catálogo de endereços “%(book)s” (%(book_href)s) e o calendário “%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Encontrada a lista de tarefas “%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Do cartão “%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Obter resposta de %(company)s sobre %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Como os arquivos são organizados"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "não foi possível salvá-lo aqui"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "não tem fuso horário"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "é um evento de dia inteiro"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "seu endereço ou identificador é muito longo"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "o horário dele não pode ser lido"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "o fuso horário “%(zone)s” dele não é conhecido aqui"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Marcada como candidatada na lista de tarefas"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Há mais de um item do tipo «%(what)s» escolhido, e uma ligação sincroniza apenas um: nenhum foi usado. Adicione uma ligação para cada um, ou deixe os outros de lado."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Mais de uma coleção se chama “%(name)s”. Escolha uma delas pelo endereço, em vez de pelo nome."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nunca escrever no servidor — nem sequer para criar o catálogo de endereços, o calendário ou a lista de tarefas. Os contatos, as entrevistas e os lembretes continuam a entrar; nada sai."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Nenhum"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Nenhuma das coleções escolhidas existe no servidor."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "números"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Em http:// a senha trafega pela rede em texto puro, e “%(host)s” não é um endereço da sua própria rede. Use https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Senha ou senha de app"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Pressione Procurar no servidor e escolha um catálogo de endereços, um calendário e uma lista de tarefas. Só esses são lidos ou escritos, e um modo definido aqui é uma palavra do Postulo, não um bloqueio do servidor: uma senha de aplicação não pode ser limitada a uma só coleção. As coleções são sincronizadas por inteiro."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Leitura e escrita"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "leitura e escrita"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Somente leitura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "somente leitura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "O modo somente leitura está ligado, então nada é criado: crie-o no servidor, ou informe um que já exista."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Só de leitura no servidor"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Os lembretes não foram sincronizados: não foi possível usar a lista de tarefas. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Enviar empresas"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Enviar contatos"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Enviar o meu cartão"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Endereço do servidor"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Guardada criptografada. Ela abre uma pasta com os backups de todas as contas, e excluir é como os antigos são removidos: use uma que alcance somente esta pasta, como uma subconta de um Hetzner Storage Box ou uma conta criada para backups, e nada mais."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Guardada criptografada. A maioria dos servidores não consegue limitar uma senha a uma pasta; um compartilhamento público do Nextcloud que permite uploads, ou uma subconta de um Hetzner Storage Box, consegue."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "lista de tarefas"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Lista de tarefas"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Listas de tarefas"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Tarefas sobre candidaturas"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Esse cartão foi alterado desde que foi listado."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Esse cartão não está no catálogo de endereços escolhido."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Essa tarefa foi alterada desde que foi listada."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Essa tarefa não está na lista de tarefas escolhida."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "O item «%(kind)s» está pareado com um evento que tem organizador, por isso é lido do calendário e nunca escrito nele."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "O evento (%(kind)s) no calendário termina antes de começar, por isso não foi movido."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "O catálogo de endereços “%(name)s” não está no servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "O endereço precisa começar com https:// — por exemplo %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "O backup não está na pasta após o upload."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "O calendário “%(name)s” não aceita eventos, por isso não foi usado."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "O calendário “%(name)s” não está no servidor."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Não foi possível ler o cartão, por isso não foi alterado."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "O cartão não tem nome para criar uma empresa."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "O cartão não tem nome para criar um contato."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "A coleção “%(href)s” já não existe no servidor. Não foi criada de novo; escolha outra ou deixe-a de lado."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "A primeira sincronização cria o que falta."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "A pasta %(path)s não pôde ser criada: a pasta acima dela não existe."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "A pasta %(path)s não existe no servidor. Crie-a lá primeiro: o Postulo não cria a pasta onde os backups são guardados."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "A pasta %(path)s não existe no servidor. Crie-a lá primeiro: o Postulo cria apenas as pastas abaixo dela."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "A pasta %(path)s existe, com %(count)d itens."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "A pasta %(path)s existe, com %(count)d backups do Postulo."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "A pasta tem espaço para %(free)s e o backup precisa de %(needed)s, então nada foi enviado."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "A pasta contém %(found)d bytes dele e o backup tem %(size)d: não confirmado."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "A pasta está cheia: o servidor não tem espaço para o arquivo."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "O servidor respondeu HTTP %(status)d para %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "O servidor não permite escrever em “%(name)s”: só de leitura."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "O servidor não informa onde ficam os calendários."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "O servidor não informa onde ficam os catálogos de endereços."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "O servidor não informa o tamanho do arquivo, então não consegue confirmar."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "O servidor não diz onde está a conta %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "O servidor não indica se é possível escrever"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "O servidor apontou para um endereço que não é dele (%(host)s); ele não foi seguido."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "O servidor redirecionou %(path)s vezes demais."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "O servidor redirecionou um upload, e o redirecionamento não é seguido."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "O servidor recusou o nome de usuário ou a senha."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "O servidor não quis criar uma lista de tarefas, por isso pode não salvar tarefas."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "O endereço do servidor, por exemplo https://cloud.example.org, ou o endereço do serviço DAV dele, quando fica em um caminho, por exemplo https://example.org/dav.php/. A partir daí, o Postulo encontra onde ficam os catálogos de endereços e os calendários."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Não foi possível ler a resposta do servidor: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "A resposta do servidor para %(path)s era grande ou lenta demais e não foi lida."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Não foi possível ler a tarefa, por isso não foi alterada."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "A tarefa de “%(name)s” foi removida da lista de tarefas; o lembrete foi mantido."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "A tarefa não tem hora limite para criar um lembrete."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "A lista de tarefas “%(name)s” não existe no servidor."

#: src/postulo_dav/sync.py
#, python-format
