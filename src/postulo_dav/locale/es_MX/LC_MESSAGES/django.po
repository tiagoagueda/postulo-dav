#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d eventos del calendario no son de Postulo y no se tocaron."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s se quitó del calendario en otro dispositivo; se conserva aquí."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sin empresa)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacto eliminado aquí se había cambiado en el teléfono desde la última sincronización. La ficha se dejó en la libreta de direcciones y vuelve como contacto en la siguiente ejecución."

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Libreta de direcciones"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Una contraseña de aplicación, si el servidor la ofrece. Se guarda cifrada."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Una entrevista cambió en ambos lados a la vez; la siguiente ejecución decide."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Una entrevista eliminada aquí se había cambiado en el teléfono desde la última sincronización. El evento se dejó en el calendario."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Una entrevista se trasladó a otra dirección del calendario; aún emparejado."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendario"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Cancelada en el calendario."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV y CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Cambiado aquí el %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Cambiado aquí, pero después se cambió en el teléfono; se tomó la versión del teléfono."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Cambiado en el teléfono el %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Cambiado en el teléfono, pero después se cambió aquí; se conservó la nuestra."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Se encontraron la libreta de direcciones \"%(book)s\" y el calendario \"%(calendar)s\"."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it could not be saved here"
msgstr "no se puede salvar aquí"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it has no time zone"
msgstr "no tiene zona horaria"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it is an all-day event"
msgstr "es un evento todo el día"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "its address or identifier is too long"
msgstr "su dirección o identificador es demasiado largo"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "its time cannot be read"
msgstr "su tiempo no se puede leer"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "su zona de tiempo “%(zone)s” no se conoce aquí"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "La crea en el servidor la primera sincronización si no existe, salvo que Solo lectura esté activado. Solo se toca esta libreta de direcciones."

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Lo crea en el servidor la primera sincronización si no existe, salvo que Solo lectura esté activado. Solo se toca este calendario."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "No escribir nunca en el servidor — ni siquiera para crear la libreta de direcciones o el calendario. Los contactos y las entrevistas siguen entrando; no sale nada."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Por http:// la contraseña viaja por la red sin cifrar, y \"%(host)s\" no es una dirección de tu propia red. Usa https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Contraseña o contraseña de aplicación"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Solo lectura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "solo lectura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Solo lectura está activado, así que no se crea nada: créalo en el servidor o indica uno que ya exista."

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Dirección del servidor"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "El %(kind)s en el calendario termina antes de que comience, por lo que no fue movido."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "La libreta de direcciones \"%(name)s\" no está en el servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "La dirección debe empezar con https:// — por ejemplo, %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "El calendario \"%(name)s\" no está en el servidor."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "La primera sincronización creará lo que falte."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "El servidor respondió HTTP %(status)d para %(method)s %(path)s."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "El servidor no nombre un hogar calendario."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "El servidor no nombre un libro de direcciones en casa."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "El servidor no dice dónde está la cuenta %(kind)s."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "El servidor señaló una dirección fuera de sí (%(host)s); no fue seguida."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server redirected %(path)s too many times."
msgstr "El servidor redireccionó %(path)s demasiadas veces."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server refused the user name or password."
msgstr "El servidor rechazó el nombre de usuario o contraseña."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "La dirección del servidor, por ejemplo: https://cloud.example.org, o la dirección de su servicio DAV donde vive bajo un camino, por ejemplo: https://example.org/dav.php/. Postulo encuentra el libro de direcciones y casas de calendario desde allí."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "La respuesta del servidor no se podía leer: %(error)s"

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "La respuesta del servidor para %(path)s era demasiado grande o demasiado lenta, y no se leía."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "El tiempo del %(kind)s en el calendario no se pudo utilizar (%(why)s), por lo que no se movió."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Nombre de usuario"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "\"%(name)s\" cambió en ambos lados a la vez; la siguiente ejecución decide."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "“%(name)s” cambió en ambos lados, y la tarjeta del teléfono no da tiempo: la versión del teléfono fue tomada."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "“%(name)s” es compartido con usted para leer solamente; el cambio en el teléfono no fue aplicado."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "“%(name)s” se trasladó a otra dirección en el servidor; aún emparejado."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "\"%(name)s\" se quitó de la libreta de direcciones; se conserva aquí."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "“%(name)s” fue saltado: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "“%(name)s”: el número de la tarjeta ya está retenido por otro registro aquí, por lo que no fue tomado."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "“%(name)s”: no se tomó el número de la tarjeta."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "“%(name)s”: la dirección web de la tarjeta no es una dirección web, por lo que no fue tomada."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "“%(name)s”: no se tomó la dirección web de la tarjeta."
