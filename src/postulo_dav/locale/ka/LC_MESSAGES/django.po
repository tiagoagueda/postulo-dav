#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "კალენდარში %(count)d ღონისძიება Postulo-დან არ არის და ხელუხლებლად დარჩა."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s მოიხსნა კალენდრიდან სხვა მოწყობილობაზე; აქ დარჩა."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(კომპანიის გარეშე)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "აქ წაშლილი კონტაქტი ბოლო სინქრონიზაციის შემდეგ ტელეფონზე შეიცვალა. ბარათი მისამართების წიგნში დარჩა და შემდეგი გაშვებისას კონტაქტად დაბრუნდება."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "მისამართების წიგნი"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "აპლიკაციის პაროლი, თუ სერვერი მას გთავაზობთ. ინახება დაშიფრულად."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "გასაუბრება ორივე მხარეს ერთდროულად შეიცვალა; შემდეგი გაშვება გადაწყვეტს."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "აქ წაშლილი გასაუბრება ბოლო სინქრონიზაციის შემდეგ ტელეფონზე შეიცვალა. ღონისძიება კალენდარში დარჩა."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "კალენდარი"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "გაუქმდა კალენდარში."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV და CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "შეიცვალა აქ %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "შეიცვალა აქ, მაგრამ მოგვიანებით ტელეფონზეც შეიცვალა; აღებულია მათი ვერსია."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "შეიცვალა ტელეფონზე %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "შეიცვალა ტელეფონზე, მაგრამ მოგვიანებით აქაც შეიცვალა; დარჩა ჩვენი ვერსია."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "ნაპოვნია მისამართების წიგნი „%(book)s“ და კალენდარი „%(calendar)s“."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "თუ სერვერზე არ არსებობს, მას პირველი სინქრონიზაცია შექმნის, თუ „მხოლოდ წასაკითხი“ ჩართული არ არის. იცვლება მხოლოდ ეს მისამართების წიგნი."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "თუ სერვერზე არ არსებობს, მას პირველი სინქრონიზაცია შექმნის, თუ „მხოლოდ წასაკითხი“ ჩართული არ არის. იცვლება მხოლოდ ეს კალენდარი."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "სერვერზე არასოდეს ჩაიწეროს არაფერი — არც მისამართების წიგნის ან კალენდრის შესაქმნელად. კონტაქტები და გასაუბრებები მაინც შემოდის; არაფერი გადის."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// პროტოკოლით პაროლი ქსელში ღია სახით გადაიცემა, „%(host)s“ კი თქვენი საკუთარი ქსელის მისამართი არ არის. გამოიყენეთ https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "პაროლი ან აპლიკაციის პაროლი"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "მხოლოდ წასაკითხი"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "მხოლოდ წასაკითხი"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "„მხოლოდ წასაკითხი“ ჩართულია, ამიტომ არაფერი იქმნება: შექმენით ის სერვერზე ან მიუთითეთ უკვე არსებული."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "სერვერის მისამართი"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "მისამართების წიგნი „%(name)s“ სერვერზე არ არის."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "მისამართი უნდა იწყებოდეს https:// პრეფიქსით — მაგ., %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "კალენდარი „%(name)s“ სერვერზე არ არის."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "რაც აკლია, პირველი სინქრონიზაცია შექმნის."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "სერვერის ძირეული მისამართი, მაგ. https://cloud.example.org. Postulo იქიდან პოულობს მისამართების წიგნისა და კალენდრის საწყის საქაღალდეებს."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "მომხმარებლის სახელი"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ ორივე მხარეს ერთდროულად შეიცვალა; შემდეგი გაშვება გადაწყვეტს."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ მოიხსნა მისამართების წიგნიდან; აქ დარჩა."
