#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Löytyi: %(what)s ”%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Löytyi osoitekirja ”%(book)s” (%(book_href)s) ja kalenteri ”%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Löytyi tehtävälista ”%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Kortista ”%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Odota vastausta yritykseltä %(company)s tehtävästä %(role)s"

