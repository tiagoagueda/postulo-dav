msgstr "Kohdetta ”%(href)s” ei voitu lukea: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "”%(name)s” muuttui täällä, mutta muuttui myöhemmin puhelimessa; otettiin puhelimen versio."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "”%(name)s” muuttui molemmilla puolilla yhtä aikaa; seuraava synkronointi ratkaisee."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "”%(name)s” muuttui molemmilla puolilla, eikä puhelimen kortissa ole aikaa: puhelimen versio otettiin käyttöön."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "”%(name)s” muuttui puhelimessa, mutta muuttui myöhemmin täällä; säilytettiin oma versiomme."

#: src/postulo_dav/sync.py
#, python-format
