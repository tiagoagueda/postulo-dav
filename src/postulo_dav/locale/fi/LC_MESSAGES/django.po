msgstr ""

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "sitä ei voitu tallentaa tänne"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "sillä ei ole aikavyöhykettä"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "se on koko päivän tapahtuma"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "sen osoite tai tunniste on liian pitkä"

