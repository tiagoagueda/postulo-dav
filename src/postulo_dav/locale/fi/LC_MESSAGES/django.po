msgid "That task has changed since it was listed."
msgstr "Tehtävä on muuttunut sen jälkeen, kun se listattiin."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Tehtävä ei ole valitussa tehtävälistassa."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Kohde ”%(kind)s” on pariutettu tapahtumaan, jolla on järjestäjä, joten se luetaan kalenterista eikä sitä kirjoiteta koskaan sinne."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Kalenterissa oleva %(kind)s päättyy ennen kuin se alkaa, joten sitä ei siirretty."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Osoitekirjaa ”%(name)s” ei ole palvelimella."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Osoitteen on alettava https:// — esimerkiksi %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalenteri ”%(name)s” ei ota vastaan tapahtumia, joten sitä ei käytetty."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenteria ”%(name)s” ei ole palvelimella."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Korttia ei voitu lukea, joten sitä ei muutettu."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kortilla ei ole nimeä, josta tehdä yritys."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kortilla ei ole nimeä, josta tehdä yhteyshenkilö."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Kokoelmaa ”%(href)s” ei enää ole palvelimella. Sitä ei luotu uudelleen; valitse toinen tai jätä se pois."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Ensimmäinen synkronointi luo sen, mikä puuttuu."

