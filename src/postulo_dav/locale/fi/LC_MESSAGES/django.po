#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Mille yhteyshenkilöille tehdään kortti osoitekirjaan. Jo olemassa olevat kortit jäävät, eikä niille lähetetä enää mitään, kun tämä on pois päältä."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Kirjoita jokainen yritys omana korttinaan (yrityskortti, jossa on sen nimi ja verkkosivusto), jota pidetään yrityksen mukaisena."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Kirjoita omat tietosi omalle kortilleen yhteen suuntaan: puhelimessa tehty muutos ei koskaan päädy profiiliisi."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "oma korttisi"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Omaa korttiasi ei lähetetty: profiilillasi ei ole nimeä."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Oma korttisi poistettiin osoitekirjasta; se säilytettiin."

#: src/postulo_dav/sync.py
#, python-format
