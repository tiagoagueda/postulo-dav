#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d kalenterin tapahtumaa ei ole Postulosta, ja ne jätettiin rauhaan."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s poistettiin kalenterista toisella laitteella; säilytetty täällä."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(ei yritystä)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Täällä poistettu yhteyshenkilö oli vaihdettu puhelimessa edellisen synkronoinnin jälkeen. Kortti oli jätetty osoitekirjaan, ja se tuli takaisin yhteyshenkilönä seuraavalla lenkillä."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Osoitekirja"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Sovellussalasana, jos palvelin sellaisen tarjoaa. Tallennetaan salattuna."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Haastattelu muuttui molemmilla puolilla yhtä aikaa; seuraava ajo ratkaisee."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Haastattelu, joka on poistettu täältä, on vaihdettu puhelimessa edellisen synkronoinnin jälkeen. Tapahtuma jätettiin kalenteriin."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalenteri"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Peruttu kalenterissa."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV ja CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Muutettu täällä %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Muutettu täällä, mutta myöhemmin puhelimessa; otettiin puhelimen versio."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Muutettu puhelimessa %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Muutettu puhelimessa, mutta myöhemmin täällä; säilytettiin oma versio."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Löydettiin osoitekirja ”%(book)s” ja kalenteri ”%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Valmistettu palvelimelle ensimmäisellä synkronointi, jos se ei ole siellä, ellei vain lukea on päällä. Vain tämä osoitekirja on kosketettu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Valmistettu palvelimelle ensimmäisellä synkronointi, jos se ei ole siellä, ellei vain lukea on päällä. Vain tämä kalenteri on kosketettu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Älä koskaan kirjoita palvelimelle  Kontakteja ja haastatteluja tulee yhä."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Http://:n yläpuolella salasana menee verkon poikki selkeästi, ja ...%(host)s... ei ole osoite omassa verkossasi. Käytä https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Salasana tai sovellussalasana"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Vain luku"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "vain luku"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Lue vain, joten mitään ei tehdä: luo se palvelimelle, tai nimeä yksi, joka on jo olemassa."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Palvelimen osoite"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Osoitekirjaa ei ole palvelimella."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Osoite on aloitettava esimerkiksi %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenteria ei ole palvelimella."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Ensimmäinen synkronointi tekee sen, mikä puuttuu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Palvelimen juuri, esim. https://cloud.example.org. Postulo löytää sieltä osoitekirjan ja kalenterin sijainnit."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Käyttäjänimi"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "”%(name)s” muuttui molemmilla puolilla yhtä aikaa; seuraava ajo ratkaisee."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "”%(name)s” poistettiin osoitekirjasta; säilytetty täällä."
