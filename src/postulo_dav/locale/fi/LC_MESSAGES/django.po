msgstr "Muutettu täällä %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Muutettu täällä, mutta myöhemmin puhelimessa; otettiin puhelimen versio."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Muutettu puhelimessa %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Muutettu puhelimessa, mutta myöhemmin täällä; säilytettiin oma versio."

