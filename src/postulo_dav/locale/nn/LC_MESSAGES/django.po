msgstr ""

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Kva kontaktar som får eit kort i adresseboka. Kort som allereie er der, blir, og ingenting meir blir sendt til dei medan dette er av."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Skriv kvart selskap som eit eige kort (eit selskapskort, med namn og nettstad), halde i takt med selskapet."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Skriv dine eigne opplysingar til eit eige kort, éin veg: ei endring på telefonen når aldri profilen din."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "ditt eige kort"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Det eigne kortet ditt vart ikkje sendt: profilen din har ikkje noko namn."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Ditt eige kort vart fjerna frå adresseboka; behalde."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "«%(href)s» kunne ikkje lesast: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "«%(name)s» vart endra her, men seinare endra på telefonen; tok deira."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» vart endra på begge sider samtidig; neste køyring avgjer."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» vart endra på begge sider, og kortet frå telefonen har inga tid: versjonen frå telefonen vart valt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "«%(name)s» vart endra på telefonen, men seinare endra her; behaldt vår."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "«%(name)s» kunne ikkje gjerast om til eit intervju: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "«%(name)s» kunne ikkje gjerast om til eit intervju: tidspunktet kan ikkje lesast."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "«%(name)s» er ikkje ein kalender."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "«%(name)s» er ikkje ei oppgåveliste."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "«%(name)s» er ikkje ei adressebok."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» er delt med deg med berre lesetilgang; endringa på telefonen vart ikkje teken i bruk."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» vart flytta til ei anna adresse på tenaren; framleis kopla saman."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "«%(name)s» vart ikkje endra ut frå kortet: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» vart fjerna frå adresseboka; behalden her."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "«%(name)s» vart hoppa over: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: nummeret på kortet høyrer alt til ei anna oppføring her, så det vart ikkje teke inn."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: nummeret på kortet vart ikkje teke inn."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: nettadressa på kortet er ikkje ei nettadresse, så ho vart ikkje teken inn."

