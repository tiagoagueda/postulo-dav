#: src/postulo_dav/sync.py:671
#, python-format, draft
msgid ""
"%(count)d events on the calendar are not from Postulo and were left alone."
msgstr ""
"Ní ó Postulo %(count)d imeacht ar an bhféilire agus fágadh gan athrú iad."

#: src/postulo_dav/sync.py:596
#, python-format, draft
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "Baineadh %(kind)s den fhéilire ar ghléas eile; coinnithe anseo."

#: src/postulo_dav/sync.py:80
#, draft
msgid "(no company)"
msgstr "(gan chuideachta)"

#: src/postulo_dav/sync.py:95
msgid ""
"A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr ""

#: src/postulo_dav/sync.py:252
#, draft
msgid "Address book"
msgstr "Leabhar seoltaí"

#: src/postulo_dav/sync.py:248
#, draft
msgid "An app password where the server offers one. Stored encrypted."
msgstr ""
"Pasfhocal aipe má thairgeann an freastalaí ceann. Stóráilte go criptithe."

#: src/postulo_dav/sync.py:650
#, draft
msgid "An interview changed on both sides at once; next run decides."
msgstr ""
"Athraíodh agallamh ar an dá thaobh ag an am céanna; socróidh an chéad rith eile é."

#: src/postulo_dav/sync.py:100
msgid ""
"An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr ""

#: src/postulo_dav/sync.py:264
#, draft
msgid "Calendar"
msgstr "Féilire"

#: src/postulo_dav/sync.py:215
#, draft
msgid "Cancelled on the calendar."
msgstr "Curtha ar ceal ar an bhféilire."

#: src/postulo_dav/sync.py:227
#, draft
msgid "CardDAV and CalDAV"
msgstr "CardDAV agus CalDAV"

#: src/postulo_dav/sync.py:489
#, python-format, draft
msgid "Changed here on %(when)s: %(text)s"
msgstr "Athraithe anseo ar %(when)s: %(text)s"

#: src/postulo_dav/sync.py:624
#, draft
msgid "Changed here, but changed on the phone later; took theirs."
msgstr ""
"Athraithe anseo, ach athraithe ar an bhfón níos déanaí; glacadh lena leagan siúd."

#: src/postulo_dav/sync.py:475
#, python-format, draft
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Athraithe ar an bhfón ar %(when)s: %(text)s"

#: src/postulo_dav/sync.py:614
#, draft
msgid "Changed on the phone, but changed here later; kept ours."
msgstr ""
"Athraithe ar an bhfón, ach athraithe anseo níos déanaí; coinníodh ár leagan féin."

#: src/postulo_dav/sync.py:360
#, python-format, draft
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Aimsíodh an leabhar seoltaí “%(book)s” agus an féilire “%(calendar)s”."

#: src/postulo_dav/sync.py:256
msgid ""
"Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr ""

#: src/postulo_dav/sync.py:268
msgid ""
"Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr ""

#: src/postulo_dav/sync.py:281
msgid ""
"Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr ""

#: src/postulo_dav/sync.py:327
#, python-format
msgid ""
"Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr ""

#: src/postulo_dav/sync.py:245
#, draft
msgid "Password or app password"
msgstr "Pasfhocal nó pasfhocal aipe"

#: src/postulo_dav/sync.py:276
#, draft
msgid "Read only"
msgstr "Inléite amháin"

#: src/postulo_dav/sync.py:295
#, draft
msgid "read only"
msgstr "inléite amháin"

#: src/postulo_dav/sync.py:84
msgid ""
"Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr ""

#: src/postulo_dav/sync.py:233
#, draft
msgid "Server address"
msgstr "Seoladh an fhreastalaí"

#: src/postulo_dav/sync.py:378
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr ""

#: src/postulo_dav/sync.py:319
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr ""

#: src/postulo_dav/sync.py:379
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr ""

#: src/postulo_dav/sync.py:82
msgid "The first sync will make what is missing."
msgstr ""

#: src/postulo_dav/sync.py:236
#, draft
msgid ""
"The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr ""
"Fréamh an fhreastalaí, m.sh. https://cloud.example.org. Aimsíonn Postulo an leabhar seoltaí agus an féilire as sin."

#: src/postulo_dav/sync.py:242
#, draft
msgid "Username"
msgstr "Ainm úsáideora"

#: src/postulo_dav/sync.py:511
#, python-format, draft
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr ""
"Athraíodh “%(name)s” ar an dá thaobh ag an am céanna; socróidh an chéad rith eile é."

#: src/postulo_dav/sync.py:463
#, python-format, draft
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "Baineadh “%(name)s” den leabhar seoltaí; coinnithe anseo."
