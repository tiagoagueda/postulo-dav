msgstr ""

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Quali contatti ottengono una scheda nella rubrica. Le schede già presenti restano, e finché questa opzione è disattivata non viene inviato altro."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Scrive ogni azienda come scheda a sé (una scheda azienda, con nome e sito web), mantenuta allineata all'azienda."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Scrive i tuoi dati in una scheda a sé, in un solo senso: una modifica sul telefono non raggiunge mai il tuo profilo."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "la tua scheda"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "La tua scheda non è stata inviata: il tuo profilo non ha un nome."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "La tua scheda è stata rimossa dalla rubrica; è stata mantenuta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "Impossibile leggere “%(href)s”: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "“%(name)s” è cambiato qui, ma più tardi è cambiato sul telefono; ha prevalso la versione del telefono."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» è cambiato da entrambe le parti nello stesso momento; decide la prossima esecuzione."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» è stato modificato da entrambe le parti e la scheda del telefono non indica un orario: è stata presa la versione del telefono."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "“%(name)s” è cambiato sul telefono, ma più tardi è cambiato qui; ha prevalso la nostra versione."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "Impossibile trasformare “%(name)s” in un colloquio: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "Impossibile trasformare “%(name)s” in un colloquio: non si riesce a leggerne l'orario."

