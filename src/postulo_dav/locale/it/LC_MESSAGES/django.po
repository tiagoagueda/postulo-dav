#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "“%(name)s” non è un calendario."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "“%(name)s” non è un elenco attività."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "“%(name)s” non è una rubrica."

#: src/postulo_dav/sync.py
