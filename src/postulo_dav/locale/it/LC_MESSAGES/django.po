msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Sono scelti più elementi di tipo %(what)s, e una connessione ne sincronizza uno solo: non ne è stato usato nessuno. Aggiungi una connessione per ciascuno, oppure lascia perdere gli altri."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Più di una raccolta si chiama “%(name)s”. Scegline una tramite il suo indirizzo, anziché il nome."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Non scrivere mai sul server, nemmeno per creare la rubrica, il calendario o l'elenco attività. Contatti, colloqui e promemoria continuano ad arrivare; nulla esce."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Nessuna"

#: src/postulo_dav/sync.py
