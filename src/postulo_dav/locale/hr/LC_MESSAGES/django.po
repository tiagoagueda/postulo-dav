#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d događaja u kalendaru nije stvorio Postulo pa su ostavljeni netaknuti."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s uklonjen iz kalendara na drugom uređaju; ovdje zadržan."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(bez tvrtke)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt izbrisan ovdje bio je promijenjen na telefonu nakon zadnje sinkronizacije. Kartica je ostavljena u adresaru i vraća se kao kontakt pri sljedećem pokretanju."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adresar"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Lozinka aplikacije gdje je poslužitelj nudi. Sprema se šifrirano."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Razgovor je promijenjen na obje strane istodobno; sljedeći prolaz odlučuje."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Razgovor izbrisan ovdje bio je promijenjen na telefonu nakon zadnje sinkronizacije. Događaj je ostavljen u kalendaru."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalendar"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Otkazano u kalendaru."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV i CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Promijenjeno ovdje %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Promijenjeno ovdje, ali kasnije i na telefonu; preuzeta je njihova verzija."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Promijenjeno na telefonu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Promijenjeno na telefonu, ali kasnije i ovdje; zadržana je naša verzija."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Pronađen je adresar „%(book)s” i kalendar „%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Prva sinkronizacija stvara ga na poslužitelju ako ondje ne postoji, osim ako je uključeno „samo za čitanje”. Dira se samo ovaj adresar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Prva sinkronizacija stvara ga na poslužitelju ako ondje ne postoji, osim ako je uključeno „samo za čitanje”. Dira se samo ovaj kalendar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikad se ne piše na poslužitelj — čak ni radi stvaranja adresara ili kalendara. Kontakti i razgovori i dalje dolaze; ništa ne odlazi."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Preko http:// lozinka putuje mrežom nešifrirana, a „%(host)s” nije adresa na vašoj vlastitoj mreži. Upotrijebite https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Lozinka ili lozinka aplikacije"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Samo za čitanje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "samo za čitanje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Uključeno je „samo za čitanje”, pa se ništa ne stvara: stvorite ga na poslužitelju ili navedite neki koji već postoji."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Adresa poslužitelja"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresar „%(name)s” ne postoji na poslužitelju."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa mora počinjati s https:// — na primjer %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendar „%(name)s” ne postoji na poslužitelju."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Prva sinkronizacija stvorit će ono što nedostaje."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Korijen poslužitelja, npr. https://cloud.example.org. Postulo odatle pronalazi početne lokacije adresara i kalendara."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Korisničko ime"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s” promijenjen na obje strane istodobno; sljedeći prolaz odlučuje."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s” uklonjen je iz adresara; ovdje zadržan."
