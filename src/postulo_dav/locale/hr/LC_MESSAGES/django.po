#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d zbirka odabrana"
msgstr[1] "%(count)d zbirke odabrane"
msgstr[2] "%(count)d zbirki odabrano"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d događaja u kalendaru nije stvorio Postulo pa su ostavljeni netaknuti."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "Zapisi povezani s nečim izvan odabrane zbirke (%(count)d) ostavljeni su netaknuti."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "Zapisi koji nisu poslani jer je slanje te vrste isključeno: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d zadatak na popisu zadataka nije iz Postula i ostavljen je netaknut."
msgstr[1] "%(count)d zadatka na popisu zadataka nisu iz Postula i ostavljena su netaknuta."
msgstr[2] "%(count)d zadataka na popisu zadataka nije iz Postula i ostavljeno je netaknuto."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s uklonjen iz kalendara na drugom uređaju; ovdje zadržan."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s nije jedna od sigurnosnih kopija koje ovo odredište čuva, pa nije obrisana."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(bez tvrtke)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(bez naslova)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Kartica se ne može pretvoriti u to."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt izbrisan ovdje bio je promijenjen na telefonu nakon zadnje sinkronizacije. Kartica je ostavljena u adresaru i vraća se kao kontakt pri sljedećem prolazu."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "U mapi već postoji druga datoteka pod nazivom %(name)s i nije prepisana."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Podsjetnik se promijenio na objema stranama istodobno; odlučit će sljedeće izvođenje."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Podsjetnik izbrisan ovdje promijenjen je na telefonu nakon posljednje sinkronizacije. Zadatak je ostavljen na popisu zadataka."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Zahtjev izvan odabranih zbirki nije poslan."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Zadatak se promijenio na objema stranama istodobno; odlučit će sljedeće izvođenje."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Zadatak je premješten na drugu adresu; i dalje je povezan."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "imenik"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adresar"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Imenici"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adrese"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Sve u mapi, s opisnim nazivima"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Sve"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Na popisu zadataka čuvajte i dva zadatka za svaku prijavu: jedan za prijavu, čijim se označavanjem kvačicom vama šalje prijedlog, i jedan za odgovor, koji se zatvara kada prijava završi. Podsjetnici o prijavi nalaze se pod njezinim otvorenim zadatkom."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Upiši u kalendar i cijele dane sa stranice Kalendar (rokovi za prijavu, datumi zatvaranja oglasa i datumi do kojih treba odgovoriti na ponudu) kao cjelodnevne događaje, u jednom smjeru: promjena napravljena na telefonu se prepisuje. Potrebno je da instanca zna vlastitu adresu."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Lozinka aplikacije gdje je poslužitelj nudi. Sprema se šifrirano."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Razgovor je promijenjen na obje strane istodobno; odlučit će sljedeći prolaz."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Razgovor izbrisan ovdje bio je promijenjen na telefonu nakon zadnje sinkronizacije. Događaj je ostavljen u kalendaru."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Razgovor za posao premješten je na drugu adresu u kalendaru; i dalje je uparen."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Prijavi se za %(role)s u %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Po tvrtki i radnom mjestu, svako u svojoj mapi"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalendar"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalendar"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendari"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Otkazano u kalendaru."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV i CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Promijenjeno ovdje %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Promijenjeno ovdje, ali kasnije i na telefonu; preuzeta je njihova verzija."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Promijenjeno na telefonu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Promijenjeno na telefonu, ali kasnije i ovdje; zadržana je naša verzija."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Zbirke"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Rokovi i datumi"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Adresa mape"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Pronađeno: %(what)s „%(name)s“ (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Pronađeni su imenik „%(book)s“ (%(book_href)s) i kalendar „%(calendar)s“ (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Pronađen je popis zadataka „%(name)s“ (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Iz kartice „%(name)s“: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Dobij odgovor od %(company)s o poziciji %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Kako su datoteke raspoređene"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "nije se mogao spremiti ovdje"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nema vremensku zonu"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "to je cjelodnevni događaj"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "njegova je adresa ili identifikator predug"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "njegovo se vrijeme ne može pročitati"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "njegova vremenska zona „%(zone)s“ ovdje nije poznata"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Označeno kao prijavljeno na popisu zadataka"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Odabrano je više od jednog elementa vrste %(what)s, a veza sinkronizira samo jedan: nijedan nije korišten. Dodajte vezu za svaki ili ostavite ostale."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Više od jedne zbirke zove se „%(name)s“. Odaberite jednu od njih po adresi, a ne po imenu."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nikada ne pišite na poslužitelj, čak ni radi stvaranja imenika, kalendara ili popisa zadataka. Kontakti, razgovori i podsjetnici i dalje dolaze; ništa ne odlazi."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Nema"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Nijedna od odabranih zbirki nije na poslužitelju."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "brojevi"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Preko http:// lozinka putuje mrežom nešifrirana, a „%(host)s“ nije adresa na vašoj vlastitoj mreži. Upotrijebite https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Lozinka ili lozinka aplikacije"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Pritisnite Pretraži poslužitelj, zatim odaberite jedan imenik, jedan kalendar i jedan popis zadataka. Samo se oni čitaju ili pišu, a način postavljen ovdje je riječ Postula, a ne brava poslužitelja: lozinka aplikacije ne može se ograničiti na jednu zbirku. Sinkroniziraju se cijele zbirke."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Čitanje i pisanje"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "čitanje i pisanje"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Samo za čitanje"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "samo za čitanje"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Uključeno je „samo za čitanje“, pa se ništa ne stvara: stvorite ga na poslužitelju ili navedite neki koji već postoji."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Samo za čitanje na poslužitelju"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Podsjetnici nisu sinkronizirani: popis zadataka nije se mogao koristiti. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Pošalji tvrtke"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Pošalji kontakte"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Pošalji moju vlastitu karticu"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adresa poslužitelja"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Pohranjuje se šifrirano. Otvara mapu sa sigurnosnim kopijama svih računa, a brisanjem se stare uklanjaju: koristite račun koji dopire samo do ove mape, poput podračuna Hetzner Storage Boxa ili računa napravljenog za sigurnosne kopije, i ništa drugo."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Pohranjuje se šifrirano. Većina poslužitelja ne može ograničiti lozinku na jednu mapu; javno dijeljenje na Nextcloudu koje dopušta prijenos ili podračun Hetzner Storage Boxa može."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "popis zadataka"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Popis zadataka"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Popisi zadataka"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Zadaci o prijavama"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Ta se kartica promijenila otkako je navedena."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Te kartice nema u odabranom imeniku."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Taj se zadatak promijenio otkako je naveden."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Tog zadatka nema na odabranom popisu zadataka."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Element „%(kind)s“ povezan je s događajem koji ima organizatora, pa se čita iz kalendara i nikada se ne zapisuje u njega."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s u kalendaru završava prije nego što počinje, pa nije premješten."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresar „%(name)s“ ne postoji na poslužitelju."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa mora počinjati s https:// — na primjer %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Sigurnosne kopije nema u mapi nakon prijenosa."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalendar „%(name)s“ ne prihvaća događaje, pa nije korišten."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendar „%(name)s“ ne postoji na poslužitelju."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kartica se nije mogla pročitati, pa nije promijenjena."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kartica nema ime od kojeg bi se napravila tvrtka."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kartica nema ime od kojeg bi se napravio kontakt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Zbirke „%(href)s“ više nema na poslužitelju. Nije ponovno stvorena; odaberite drugu ili je ostavite."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Prva sinkronizacija stvorit će ono što nedostaje."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Mapa %(path)s nije mogla biti stvorena: mapa iznad nje ne postoji."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Mapa %(path)s ne postoji na poslužitelju. Prvo je stvorite ondje: Postulo ne stvara mapu u kojoj se čuvaju sigurnosne kopije."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Mapa %(path)s ne postoji na poslužitelju. Prvo je stvorite ondje: Postulo stvara samo mape ispod nje."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Mapa %(path)s postoji, a u njoj je stavki: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Mapa %(path)s postoji, a u njoj je Postulovih sigurnosnih kopija: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Mapa ima mjesta za %(free)s, a sigurnosnoj kopiji treba %(needed)s, pa ništa nije poslano."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Mapa sadrži %(found)d bajtova kopije, a sigurnosna kopija ima %(size)d: nije potvrđeno."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Mapa je puna: poslužitelj nema mjesta za datoteku."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Puna adresa mape, koja mora postojati. Na Nextcloudu: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo stvara mape ispod nje prema potrebi i nikada ne piše izvan nje."

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr "Puna adresa mape, koja mora postojati. Na Nextcloudu: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Upotrijebite mapu samo za arhive."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Poslužitelj je odgovorio HTTP %(status)d za %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Poslužitelj vam ne dopušta pisanje u „%(name)s“: samo za čitanje."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Poslužitelj ne navodi početnu lokaciju kalendara."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Poslužitelj ne navodi početnu lokaciju adresara."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Poslužitelj ne kaže koliko je datoteka velika, pa to ne može potvrditi."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Poslužitelj ne navodi gdje se nalazi račun %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Poslužitelj ne kaže smije li se u njega pisati"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Poslužitelj je uputio na adresu izvan svoje vlastite (%(host)s); nije se slijedila."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Poslužitelj je %(path)s preusmjerio previše puta."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Poslužitelj je preusmjerio prijenos, što se ne slijedi."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Poslužitelj je odbio korisničko ime ili lozinku."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Poslužitelj nije htio stvoriti popis zadataka, pa možda ne čuva zadatke."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Adresa poslužitelja, npr. https://cloud.example.org, ili adresa njegove DAV usluge ako se nalazi pod nekom putanjom, npr. https://example.org/dav.php/. Postulo odande pronalazi početne lokacije adresara i kalendara."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Odgovor poslužitelja nije se mogao pročitati: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Odgovor poslužitelja za %(path)s bio je prevelik ili prespor, pa nije pročitan."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Zadatak se nije mogao pročitati, pa nije promijenjen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Zadatak za „%(name)s“ uklonjen je s popisa zadataka; podsjetnik je zadržan."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Zadatak nema rok od kojeg bi se napravio podsjetnik."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Popisa zadataka „%(name)s“ nema na poslužitelju."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Zadatak „%(name)s“ nema rok, pa nije pretvoren u podsjetnik."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Zadatak „%(name)s“ uklonjen je s popisa zadataka; ne stvara se ponovno."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Vrijeme za ovaj prijenos je isteklo."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Vrijeme za %(kind)s u kalendaru nije se moglo upotrijebiti (%(why)s), pa nije premješten."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Vrijeme zadatka „%(name)s“ nije se moglo koristiti (%(why)s), pa podsjetnik nije pomaknut."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Ima mjesta za još %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Ova je zbirka ovdje samo za čitanje, pa zahtjev %(method)s nije poslan."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Previše datoteka u toj mapi već ima naziv %(name)s."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Koristi se samo dok dolje nije odabrana nijedna zbirka. Ime ili adresa kalendara; ako ga nema, stvara ga prva sinkronizacija, osim ako je uključeno samo čitanje. Sinkronizira se cijeli kalendar, a ime koje dijele dva kalendara odbija se."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Koristi se samo dok dolje nije odabrana nijedna zbirka. Ime ili adresa popisa zadataka na kojem se čuvaju vaši podsjetnici; prazno, ne koristi se nijedan. Ime kojeg nema stvara prva sinkronizacija, osim ako je uključeno samo čitanje. Potreban je poslužitelj koji čuva zadatke."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Koristi se samo dok dolje nije odabrana nijedna zbirka. Ime ili adresa imenika; ako ga nema, stvara ga prva sinkronizacija, osim ako je uključeno samo čitanje. Sinkronizira se cijeli imenik, a ime koje dijele dva imenika odbija se."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Korisničko ime"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "web adrese"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV mapa"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Koji kontakti dobivaju karticu u imeniku. Kartice koje već postoje ostaju, a dok je ovo isključeno, njima se više ništa ne šalje."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Zapišite svaku tvrtku kao zasebnu karticu (karticu tvrtke, s njezinim imenom i web-stranicom), koja se održava usklađenom s tvrtkom."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Zapišite svoje podatke u zasebnu karticu, u jednom smjeru: promjena na telefonu nikada ne dolazi do vašeg profila."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "vaša vlastita kartica"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Vaša vlastita kartica nije poslana: vaš profil nema ime."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Vaša vlastita kartica uklonjena je iz imenika; zadržana je."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s“ nije se mogao pročitati: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s“ promijenjen je ovdje, ali je kasnije promijenjen na telefonu; uzeta je verzija s telefona."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ promijenjen je na obje strane istodobno; odlučit će sljedeći prolaz."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ promijenjen je na obje strane, a kartica s telefona ne navodi vrijeme: preuzeta je verzija s telefona."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s“ promijenjen je na telefonu, ali je kasnije promijenjen ovdje; zadržana je naša verzija."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s“ nije se mogao pretvoriti u razgovor: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s“ nije se mogao pretvoriti u razgovor: njegovo se vrijeme ne može pročitati."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s“ nije kalendar."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s“ nije popis zadataka."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s“ nije imenik."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s“ podijeljen je s vama samo za čitanje; promjena s telefona nije primijenjena."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s“ premješten je na drugu adresu na poslužitelju; i dalje je uparen."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s“ nije promijenjen prema kartici: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ uklonjen je iz adresara; ovdje zadržan."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "„%(name)s“ je preskočen: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "„%(name)s“: nije preuzeto s kartice: %(what)s, kako se ništa od ovdje pohranjenog ne bi izgubilo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "„%(name)s“: broj, adresa ili web adresa na kartici nije preuzeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "„%(name)s“: e-pošta na kartici nije preuzeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s”: broj na kartici već ima drugi zapis ovdje, pa nije preuzet."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s”: broj na kartici nije preuzet."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s”: web-adresa na kartici nije web-adresa, pa nije preuzeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s”: web-adresa na kartici nije preuzeta."
