#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "S' ha trobat la llibreta d' adreces √[ x24X] 2001- 2003 i el calendari 52[ X2X] 255."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Fet al servidor per la primera sincronització si no hi és, a menys que la lectura només estigui encesa. Només s' ha tocat aquesta llibreta d' adreces."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Fet al servidor per la primera sincronització si no hi és, a menys que la lectura només estigui encesa. Només s' ha tocat aquest calendari."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "No s' ha escrit mai al servidor o tan sols per fer la llibreta d' adreces o el calendari. Contactes i entrevistes encara entren; res sortirà."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
