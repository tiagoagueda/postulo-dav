#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d col·lecció triada"
msgstr[1] "%(count)d col·leccions triades"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d esdeveniments del calendari no són de Postulo i no s'han tocat."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d registres estan aparellats amb alguna cosa fora de la col·lecció triada i s'han deixat tal com eren."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d registres no s'han enviat, perquè l'enviament d'aquest tipus està desactivat."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d tasca de la llista de tasques no és de Postulo i s'ha deixat tal com era."
msgstr[1] "%(count)d tasques de la llista de tasques no són de Postulo i s'han deixat tal com eren."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "S'ha eliminat %(kind)s del calendari en un altre dispositiu; aquí es conserva."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s no és una de les còpies de seguretat que conserva aquesta destinació, per això no s’ha eliminat."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sense empresa)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(sense títol)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Una targeta no es pot convertir en això."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacte suprimit aquí s'havia modificat al telèfon des de l'última sincronització. La targeta s'ha deixat a la llibreta d'adreces, i tornarà com a contacte a la propera execució."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "A la carpeta ja hi ha un altre fitxer que es diu %(name)s, i no s’ha sobreescrit."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Un recordatori ha canviat als dos costats alhora; decidirà la propera execució."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Un recordatori eliminat aquí havia canviat al telèfon des de l'última sincronització. La tasca s'ha deixat a la llista de tasques."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "No s'ha enviat una sol·licitud fora de les col·leccions triades."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Una tasca ha canviat als dos costats alhora; decidirà la propera execució."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Una tasca s'ha mogut a una altra adreça; continua aparellada."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "llibreta d'adreces"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Llibreta d'adreces"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Llibretes d'adreces"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adreces"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Tot a la carpeta, amb noms descriptius"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Totes"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Desa també dues tasques per a cada candidatura a la llista de tasques: una per presentar-la, que en marcar-la us envia un suggeriment, i una per rebre resposta, que es tanca quan acaba la candidatura. Els recordatoris sobre una candidatura queden sota la seva tasca oberta."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Escriu també els dies sencers de la pàgina Calendari (terminis de sol·licitud, dates de tancament dels anuncis i dates abans de les quals cal respondre una oferta) al calendari com a esdeveniments de dia sencer, en un sol sentit: un canvi fet al telèfon se sobreescriu. Cal que la instància conegui la seva pròpia adreça."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Una contrasenya d'aplicació, si el servidor n'ofereix. Es desa xifrada."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Una entrevista ha canviat a tots dos costats alhora; la propera execució decidirà."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Una entrevista suprimida aquí s'havia modificat al telèfon des de l'última sincronització. L'esdeveniment s'ha deixat al calendari."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Una entrevista s'ha traslladat a una altra adreça del calendari; continua vinculada."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Presenta candidatura a %(role)s a %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Per empresa i lloc, cadascun en la seva carpeta"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "calendari"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendari"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Calendaris"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "S'ha cancel·lat al calendari."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV i CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Modificat aquí (%(when)s): %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Modificat aquí, però després modificat al telèfon; s'ha agafat la versió del telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Modificat al telèfon (%(when)s): %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Modificat al telèfon, però després modificat aquí; s'ha mantingut la versió d'aquí."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Col·leccions"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Terminis i dates"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Adreça de la carpeta"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "S'ha trobat %(what)s «%(name)s» (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "S'han trobat la llibreta d'adreces «%(book)s» (%(book_href)s) i el calendari «%(calendar)s» (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "S'ha trobat la llista de tasques «%(name)s» (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "De la targeta «%(name)s»: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Rep resposta de %(company)s sobre %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Com s’organitzen els fitxers"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "no s'ha pogut desar aquí"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "no té zona horària"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "és un esdeveniment de tot el dia"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "la seva adreça o el seu identificador és massa llarg"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "no se'n pot llegir l'hora"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "la seva zona horària «%(zone)s» no és coneguda aquí"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Marcada com a presentada a la llista de tasques"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Hi ha més d'un element de tipus «%(what)s» triat, i una connexió en sincronitza només un: no s'ha usat cap. Afegiu una connexió per a cadascun o deixeu els altres."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Més d'una col·lecció es diu «%(name)s». Trieu-ne una per la seva adreça, en lloc del nom."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "No escriguis mai al servidor, ni tan sols per crear la llibreta d'adreces, el calendari o la llista de tasques. Els contactes, les entrevistes i els recordatoris continuen entrant; no en surt res."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Cap"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Cap de les col·leccions triades és al servidor."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "números"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Per http:// la contrasenya viatja per la xarxa sense xifrar, i «%(host)s» no és una adreça de la vostra pròpia xarxa. Utilitzeu https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Contrasenya o contrasenya d'aplicació"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Premeu Cerca al servidor i trieu una llibreta d'adreces, un calendari i una llista de tasques. Només es llegeixen o s'escriuen aquests, i un mode definit aquí és paraula de Postulo, no un bloqueig del servidor: una contrasenya d'aplicació no es pot limitar a una sola col·lecció. Se sincronitzen col·leccions senceres."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Lectura i escriptura"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "lectura i escriptura"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Només lectura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "només lectura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "El mode de només lectura està activat, de manera que no es crea res: creeu-lo al servidor o indiqueu-ne un que ja hi sigui."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Només de lectura al servidor"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "No s'han sincronitzat els recordatoris: no s'ha pogut usar la llista de tasques. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Envia les empreses"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Envia els contactes"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Envia la meva targeta"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adreça del servidor"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Es desa xifrat. Obre una carpeta amb les còpies de seguretat de tots els comptes, i suprimir és com s’eliminen les antigues: feu servir un compte que només arribi a aquesta carpeta, com ara un subcompte de Hetzner Storage Box o un compte creat per a les còpies de seguretat, i res més."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Es desa xifrat. La majoria de servidors no poden restringir una contrasenya a una carpeta; un recurs públic de Nextcloud que permet pujades o un subcompte de Hetzner Storage Box sí que poden."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "llista de tasques"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Llista de tasques"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Llistes de tasques"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Tasques sobre candidatures"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Aquesta targeta ha canviat des que es va llistar."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Aquesta targeta no és a la llibreta d'adreces triada."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Aquesta tasca ha canviat des que es va llistar."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Aquesta tasca no és a la llista de tasques triada."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "L'element (%(kind)s) està aparellat amb un esdeveniment que té organitzador, de manera que es llegeix del calendari i mai no s'hi escriu."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "L'element del calendari (%(kind)s) acaba abans de començar, de manera que no s'ha traslladat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "La llibreta d'adreces «%(name)s» no és al servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "L'adreça ha de començar per https://; per exemple, %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Després de la pujada, la còpia de seguretat no és a la carpeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "El calendari «%(name)s» no admet esdeveniments, així que no s'ha usat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "El calendari «%(name)s» no és al servidor."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "No s'ha pogut llegir la targeta, així que no s'ha canviat."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "La targeta no té nom amb què crear una empresa."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "La targeta no té nom amb què crear un contacte."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "La col·lecció «%(href)s» ja no és al servidor. No s'ha tornat a crear; trieu-ne una altra o deixeu-la."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "La primera sincronització crearà el que falti."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "No s’ha pogut crear la carpeta %(path)s: la carpeta superior no hi és."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "La carpeta %(path)s no és al servidor. Creeu-la primer allà: Postulo no crea la carpeta on es desen les còpies de seguretat."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "La carpeta %(path)s no és al servidor. Creeu-la primer allà: Postulo només crea les carpetes que hi ha a sota."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "La carpeta %(path)s hi és, amb %(count)d elements."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "La carpeta %(path)s hi és, amb %(count)d còpies de seguretat de Postulo."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "La carpeta té espai per a %(free)s i la còpia de seguretat necessita %(needed)s, per això no s’ha enviat res."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "La carpeta conté %(found)d bytes de la còpia de seguretat, que en fa %(size)d: no confirmada."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "La carpeta és plena: el servidor no té espai per al fitxer."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "L’adreça completa de la carpeta, que ha d’existir. A Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo crea les carpetes que hi ha a sota quan les necessita i mai no escriu fora d’ella.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "L’adreça completa de la carpeta, que ha d’existir. A Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Feu servir una carpeta només per als arxius.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "El servidor ha respost HTTP %(status)d a %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "El servidor no us deixa escriure a «%(name)s»: només de lectura."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "El servidor no indica cap ubicació de calendaris."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "El servidor no indica cap ubicació de llibretes d'adreces."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "El servidor no diu quant fa el fitxer, per això no ho pot confirmar."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "El servidor no indica on és el compte de %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "El servidor no diu si s'hi pot escriure"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "El servidor ha remès a una adreça de fora del seu domini (%(host)s); no s'ha seguit."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "El servidor ha redirigit %(path)s massa vegades."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "El servidor ha redirigit una pujada, i això no se segueix."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "El servidor ha rebutjat el nom d'usuari o la contrasenya."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "El servidor no ha volgut crear una llista de tasques, així que potser no guarda tasques."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "L'adreça del servidor, p. ex. https://cloud.example.org, o l'adreça del seu servei DAV si és sota un camí, p. ex. https://example.org/dav.php/. Postulo hi troba les ubicacions de les llibretes d'adreces i dels calendaris."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "No s'ha pogut llegir la resposta del servidor: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "La resposta del servidor per a %(path)s era massa gran o massa lenta, i no s'ha llegit."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "No s'ha pogut llegir la tasca, així que no s'ha canviat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "La tasca de «%(name)s» s'ha eliminat de la llista de tasques; el recordatori s'ha conservat."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "La tasca no té data de venciment amb què crear un recordatori."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "La llista de tasques «%(name)s» no és al servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "La tasca «%(name)s» no té data de venciment, així que no s'ha convertit en recordatori."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "La tasca «%(name)s» s'ha eliminat de la llista de tasques; no es torna a crear."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "S’ha acabat el temps d’aquesta pujada."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "No s'ha pogut fer servir l'hora de l'element del calendari (%(kind)s) (%(why)s), de manera que no s'ha traslladat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "No s'ha pogut usar l'hora de la tasca «%(name)s» (%(why)s), així que no s'ha mogut el recordatori."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Hi ha espai per a %(size)s més."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Aquesta col·lecció és només de lectura aquí, així que no s'ha enviat %(method)s."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Massa fitxers ja tenen el nom %(name)s en aquesta carpeta."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Només s'usa mentre no hi hagi cap col·lecció triada a sota. Un nom o una adreça d'un calendari; si no existeix, la primera sincronització el crea, tret que el només de lectura estigui activat. Se sincronitza tot el calendari, i es refusa un nom que comparteixin dos calendaris."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Només s'usa mentre no hi hagi cap col·lecció triada a sota. Un nom o una adreça d'una llista de tasques on desar els recordatoris; en blanc, no se'n fa servir cap. Un nom que no existeix el crea la primera sincronització, tret que el només de lectura estigui activat. Cal un servidor que desi tasques."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Només s'usa mentre no hi hagi cap col·lecció triada a sota. Un nom o una adreça d'una llibreta d'adreces; si no existeix, la primera sincronització la crea, tret que el només de lectura estigui activat. Se sincronitza tota la llibreta, i es refusa un nom que comparteixin dues llibretes."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Nom d'usuari"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "adreces web"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Carpeta WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Quins contactes tenen una targeta a la llibreta d'adreces. Les targetes que ja hi són es queden, i no se'ls envia res més mentre això estigui desactivat."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Escriu cada empresa com a targeta pròpia (una targeta d'empresa, amb el seu nom i el seu lloc web), mantinguda al dia amb l'empresa."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Escriu les vostres dades a una targeta pròpia, en un sol sentit: un canvi al telèfon no arriba mai al vostre perfil."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "la vostra targeta"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "No s'ha enviat la vostra targeta: el vostre perfil no té nom."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "La vostra targeta s'ha eliminat de la llibreta d'adreces; es conserva."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "No s'ha pogut llegir «%(href)s»: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "«%(name)s» ha canviat aquí, però després ha canviat al telèfon; s'ha pres el d'allà."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» ha canviat als dos costats alhora; la propera execució ho decidirà."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» ha canviat als dos costats i la targeta del telèfon no indica cap hora: s'ha agafat la versió del telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "«%(name)s» ha canviat al telèfon, però després ha canviat aquí; s'ha conservat el nostre."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "«%(name)s» no s'ha pogut convertir en una entrevista: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "«%(name)s» no s'ha pogut convertir en una entrevista: no se'n pot llegir l'hora."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "«%(name)s» no és un calendari."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "«%(name)s» no és una llista de tasques."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "«%(name)s» no és una llibreta d'adreces."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» se us ha compartit només per a lectura; no s'ha aplicat el canvi fet al telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» s'ha traslladat a una altra adreça del servidor; continua vinculat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "«%(name)s» no s'ha canviat a partir de la targeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» s'ha suprimit de la llibreta d'adreces; aquí es conserva."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "S'ha omès «%(name)s»: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "«%(name)s»: %(what)s de la targeta no s’han agafat, perquè no es perdi res del que es guarda aquí."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "«%(name)s»: un número, una adreça o una adreça web de la targeta no s’ha agafat: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "«%(name)s»: el correu electrònic de la targeta no s’ha agafat: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: el número de la targeta ja el té un altre registre d'aquí, de manera que no s'ha agafat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: no s'ha agafat el número de la targeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: l'adreça web de la targeta no és una adreça web, de manera que no s'ha agafat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: no s'ha agafat l'adreça web de la targeta."
