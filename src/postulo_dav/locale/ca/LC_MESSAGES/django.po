#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d esdeveniments del calendari no són de Postulo i no s'han tocat."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr ""

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "S'ha eliminat %(kind)s del calendari en un altre dispositiu; aquí es conserva."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sense empresa)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacte suprimit aquí s'havia modificat al telèfon des de l'última sincronització. La targeta s'ha deixat a la llibreta d'adreces, i tornarà com a contacte a la propera execució."

#: src/postulo_dav/dav.py
msgid "A request outside the chosen collections was not sent."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Llibreta d'adreces"

#: src/postulo_dav/sync.py
msgid "address book"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr ""

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Una contrasenya d'aplicació, si el servidor n'ofereix. Es desa xifrada."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Una entrevista ha canviat a tots dos costats alhora; la propera execució decidirà."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Una entrevista suprimida aquí s'havia modificat al telèfon des de l'última sincronització. L'esdeveniment s'ha deixat al calendari."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Una entrevista s'ha traslladat a una altra adreça del calendari; continua vinculada."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendari"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "S'ha cancel·lat al calendari."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV i CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Modificat aquí (%(when)s): %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Modificat aquí, però després modificat al telèfon; s'ha agafat la versió del telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Modificat al telèfon (%(when)s): %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Modificat al telèfon, però després modificat aquí; s'ha mantingut la versió d'aquí."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr ""

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "no s'ha pogut desar aquí"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "no té zona horària"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "és un esdeveniment de tot el dia"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "la seva adreça o el seu identificador és massa llarg"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "no se'n pot llegir l'hora"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "la seva zona horària «%(zone)s» no és coneguda aquí"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "No escriu mai al servidor, ni tan sols per crear la llibreta d'adreces o el calendari. Els contactes i les entrevistes continuen entrant; no en surt res."

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Per http:// la contrasenya viatja per la xarxa sense xifrar, i «%(host)s» no és una adreça de la vostra pròpia xarxa. Utilitzeu https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Contrasenya o contrasenya d'aplicació"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book and one calendar. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr ""

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Només lectura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "només lectura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "El mode de només lectura està activat, de manera que no es crea res: creeu-lo al servidor o indiqueu-ne un que ja hi sigui."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adreça del servidor"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "L'element del calendari (%(kind)s) acaba abans de començar, de manera que no s'ha traslladat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "La llibreta d'adreces «%(name)s» no és al servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "L'adreça ha de començar per https://; per exemple, %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "El calendari «%(name)s» no és al servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr ""

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "La primera sincronització crearà el que falti."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "El servidor ha respost HTTP %(status)d a %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr ""

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "El servidor no indica cap ubicació de calendaris."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "El servidor no indica cap ubicació de llibretes d'adreces."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "El servidor no indica on és el compte de %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "El servidor ha remès a una adreça de fora del seu domini (%(host)s); no s'ha seguit."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "El servidor ha redirigit %(path)s massa vegades."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "El servidor ha rebutjat el nom d'usuari o la contrasenya."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "L'adreça del servidor, p. ex. https://cloud.example.org, o l'adreça del seu servei DAV si és sota un camí, p. ex. https://example.org/dav.php/. Postulo hi troba les ubicacions de les llibretes d'adreces i dels calendaris."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "No s'ha pogut llegir la resposta del servidor: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "La resposta del servidor per a %(path)s era massa gran o massa lenta, i no s'ha llegit."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "No s'ha pogut fer servir l'hora de l'element del calendari (%(kind)s) (%(why)s), de manera que no s'ha traslladat."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Nom d'usuari"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» ha canviat als dos costats alhora; la propera execució ho decidirà."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» ha canviat als dos costats i la targeta del telèfon no indica cap hora: s'ha agafat la versió del telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» se us ha compartit només per a lectura; no s'ha aplicat el canvi fet al telèfon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» s'ha traslladat a una altra adreça del servidor; continua vinculat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» s'ha suprimit de la llibreta d'adreces; aquí es conserva."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "S'ha omès «%(name)s»: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: el número de la targeta ja el té un altre registre d'aquí, de manera que no s'ha agafat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: no s'ha agafat el número de la targeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: l'adreça web de la targeta no és una adreça web, de manera que no s'ha agafat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: no s'ha agafat l'adreça web de la targeta."
