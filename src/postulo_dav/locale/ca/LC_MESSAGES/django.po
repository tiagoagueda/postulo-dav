msgstr "(sense companyia)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacte esborrat aquí ha estat canviat en el telèfon des de l' última sincronització. La carta es va deixar a la llibreta d' adreces, i torna com a contacte en la propera execució."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Llibreta d' adreces"

