#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d kolleksiya seçildi"
msgstr[1] "%(count)d kolleksiya seçildi"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Təqvimdəki %(count)d tədbir Postulo-dan deyil və onlara toxunulmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d qeyd seçilmiş kolleksiyadan kənardakı bir şeylə cütləşdirilib və toxunulmadan qalıb."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d qeyd göndərilmədi, çünki bu növün göndərilməsi söndürülüb."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "Tapşırıqlar siyahısındakı %(count)d tapşırıq Postulo-dan deyil və toxunulmadan qaldı."
msgstr[1] "Tapşırıqlar siyahısındakı %(count)d tapşırıq Postulo-dan deyil və toxunulmadan qaldı."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s başqa cihazda təqvimdən silindi; burada saxlanıldı."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(şirkət yoxdur)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(başlıqsız)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Kartdan bunu etmək olmur."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Burada silinən kontakt sonuncu sinxronlaşdırmadan sonra telefonda dəyişdirilmişdi. Kart ünvan kitabçasında saxlanıldı və növbəti icrada kontakt kimi geri qayıdır."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Xatırlatma hər iki tərəfdə eyni anda dəyişdi; növbəti işə salma qərar verəcək."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Burada silinmiş xatırlatma son sinxronlaşdırmadan sonra telefonda dəyişdirilmişdi. Tapşırıq tapşırıqlar siyahısında saxlanıldı."

#: src/postulo_dav/dav.py
msgid "A request outside the chosen collections was not sent."
msgstr "Seçilmiş kolleksiyalardan kənar sorğu göndərilmədi."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Tapşırıq hər iki tərəfdə eyni anda dəyişdi; növbəti işə salma qərar verəcək."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Tapşırıq başqa ünvana köçürüldü; hələ də cütləşdirilib."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "ünvan kitabçası"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Ünvan kitabçası"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Ünvan kitabçaları"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Hamısı"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Tapşırıqlar siyahısında hər müraciət üçün iki tapşırıq da saxla: biri müraciət etmək üçün, işarələnəndə sizə təklif göndərir, biri cavab almaq üçün, müraciət bitəndə bağlanır. Müraciətlə bağlı xatırlatmalar onun açıq tapşırığının altında yerləşir."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Server təklif edirsə, tətbiq parolu. Şifrələnmiş şəkildə saxlanılır."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Müsahibə eyni vaxtda hər iki tərəfdə dəyişdirildi; növbəti icra qərar verəcək."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Burada silinən müsahibə sonuncu sinxronlaşdırmadan sonra telefonda dəyişdirilmişdi. Tədbir təqvimdə saxlanıldı."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Müsahibə təqvimdə başqa ünvana köçürüldü; cütləşmə qalır."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "%(company)s şirkətində %(role)s üçün müraciət et"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "təqvim"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Təqvim"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Təqvimlər"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Təqvimdə ləğv edildi."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV və CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Burada %(when)s tarixində dəyişdirildi: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Burada dəyişdirildi, lakin sonra telefonda yenidən dəyişdirildi; telefondakı versiya götürüldü."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonda %(when)s tarixində dəyişdirildi: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonda dəyişdirildi, lakin sonra burada yenidən dəyişdirildi; buradakı versiya saxlanıldı."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Kolleksiyalar"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "%(what)s “%(name)s” tapıldı (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "“%(book)s” ünvan kitabçası (%(book_href)s) və “%(calendar)s” təqvimi (%(calendar_href)s) tapıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "“%(name)s” tapşırıqlar siyahısı (%(href)s) tapıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "“%(name)s” kartından: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "%(company)s şirkətindən %(role)s barədə cavab al"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "onu burada saxlamaq mümkün olmadı"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "onun saat qurşağı yoxdur"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "bu, bütün günlük tədbirdir"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "onun ünvanı və ya identifikatoru çox uzundur"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "onun vaxtını oxumaq mümkün deyil"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "onun «%(zone)s» saat qurşağı burada məlum deyil"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Tapşırıqlar siyahısında müraciət edilmiş kimi qeyd olundu"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Birdən çox “%(what)s” seçilib, bir bağlantı isə yalnız birini sinxronlaşdırır: heç biri istifadə olunmadı. Hər biri üçün bağlantı əlavə edin və ya digərlərini buraxın."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Birdən çox kolleksiyanın adı “%(name)s”-dir. Onlardan birini adla yox, ünvanla seçin."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Serverə heç vaxt yazma, hətta ünvan kitabçasını, təqvimi və ya tapşırıqlar siyahısını yaratmaq üçün belə. Kontaktlar, müsahibələr və xatırlatmalar yenə daxil olur; heç nə çıxmır."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Heç biri"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Seçilmiş kolleksiyaların heç biri serverdə yoxdur."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// üzərindən parol şəbəkədə açıq şəkildə ötürülür və «%(host)s» sizin öz şəbəkənizdəki ünvan deyil. https:// istifadə edin."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Parol və ya tətbiq parolu"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Serverdə axtar düyməsini basın, sonra bir ünvan kitabçası, bir təqvim və bir tapşırıqlar siyahısı seçin. Yalnız onlar oxunur və ya yazılır, burada təyin edilən rejim isə Postulo-nun sözüdür, serverin kilidi deyil: tətbiq parolunu bir kolleksiya ilə məhdudlaşdırmaq olmur. Bütöv kolleksiyalar sinxronlaşdırılır."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Oxuma və yazma"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "oxuma və yazma"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Yalnız oxuma"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "yalnız oxuma"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "«Yalnız oxuma» aktivdir, ona görə heç nə yaradılmır: onu serverdə yaradın və ya artıq mövcud olanın adını göstərin."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Serverdə yalnız oxumaq üçün"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Xatırlatmalar sinxronlaşdırılmadı: tapşırıqlar siyahısından istifadə etmək mümkün olmadı. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Şirkətləri göndər"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Kontaktları göndər"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Öz kartımı göndər"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Server ünvanı"

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "tapşırıqlar siyahısı"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Tapşırıqlar siyahısı"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Tapşırıqlar siyahıları"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Müraciətlərlə bağlı tapşırıqlar"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Həmin kart siyahıya salınandan sonra dəyişib."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Həmin kart seçilmiş ünvan kitabçasında yoxdur."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Həmin tapşırıq siyahıya salınandan sonra dəyişib."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Həmin tapşırıq seçilmiş tapşırıqlar siyahısında yoxdur."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Bu element (%(kind)s) təşkilatçısı olan tədbirlə cütləşdirilib, buna görə təqvimdən oxunur və ora heç vaxt yazılmır."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Təqvimdəki %(kind)s tədbiri başlamazdan əvvəl bitir, ona görə köçürülmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "«%(name)s» ünvan kitabçası serverdə yoxdur."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Ünvan https:// ilə başlamalıdır (məsələn, %(example)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "“%(name)s” təqvimi tədbir qəbul etmir, buna görə istifadə olunmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "«%(name)s» təqvimi serverdə yoxdur."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kart oxuna bilmədi, buna görə dəyişdirilmədi."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kartda şirkət yaratmaq üçün ad yoxdur."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kartda kontakt yaratmaq üçün ad yoxdur."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "“%(href)s” kolleksiyası artıq serverdə yoxdur. Yenidən yaradılmadı; başqasını seçin və ya buraxın."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "İlk sinxronlaşdırma çatışmayanları yaradacaq."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Server %(method)s %(path)s üçün HTTP %(status)d cavabını verdi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Server “%(name)s” kolleksiyasına yazmağa icazə vermir: yalnız oxumaq üçün."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Server təqvimlərin əsas qovluğunu göstərmir."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Server ünvan kitabçalarının əsas qovluğunu göstərmir."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Server %(kind)s hesabının harada olduğunu bildirmir."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Server ora yazmağın mümkün olub-olmadığını bildirmir"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Server öz ünvanından kənar bir ünvana (%(host)s) yönləndirdi; bu yönləndirməyə əməl edilmədi."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Server %(path)s ünvanını həddindən çox yönləndirdi."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Server istifadəçi adını və ya parolu rədd etdi."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Server tapşırıqlar siyahısı yaratmaq istəmədi, buna görə tapşırıqları saxlamaya bilər."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serverin ünvanı (məsələn, https://cloud.example.org) və ya DAV xidməti hansısa yolda yerləşirsə, onun ünvanı (məsələn, https://example.org/dav.php/). Postulo ünvan kitabçalarının və təqvimlərin əsas qovluqlarını oradan tapır."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serverin cavabını oxumaq mümkün olmadı: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serverin %(path)s üçün cavabı çox böyük və ya çox gec idi və oxunmadı."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Tapşırıq oxuna bilmədi, buna görə dəyişdirilmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "“%(name)s” üçün tapşırıq tapşırıqlar siyahısından silindi; xatırlatma saxlanıldı."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Tapşırığın xatırlatma yaratmaq üçün son tarixi yoxdur."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "“%(name)s” tapşırıqlar siyahısı serverdə yoxdur."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "“%(name)s” tapşırığının son tarixi yoxdur, buna görə xatırlatmaya çevrilmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "“%(name)s” tapşırığı tapşırıqlar siyahısından silindi; yenidən yaradılmır."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Təqvimdəki %(kind)s tədbirinin vaxtından istifadə etmək mümkün olmadı (%(why)s), ona görə köçürülmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "“%(name)s” tapşırığının vaxtından istifadə etmək mümkün olmadı (%(why)s), buna görə xatırlatma köçürülmədi."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Bu kolleksiya burada yalnız oxumaq üçündür, buna görə %(method)s göndərilmədi."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Yalnız aşağıda heç bir kolleksiya seçilməyənə qədər istifadə olunur. Təqvimin adı və ya ünvanı; yoxdursa, “yalnız oxumaq üçün” aktiv olmadıqda ilk sinxronlaşdırma onu yaradır. Bütün təqvim sinxronlaşdırılır, iki təqvimin paylaşdığı ad isə rədd edilir."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Yalnız aşağıda heç bir kolleksiya seçilməyənə qədər istifadə olunur. Xatırlatmalarınızın saxlanacağı tapşırıqlar siyahısının adı və ya ünvanı; boş olarsa, heç biri istifadə olunmur. Olmayan ad ilk sinxronlaşdırma ilə yaradılır, “yalnız oxumaq üçün” aktiv olmadıqda. Tapşırıqları saxlayan server tələb olunur."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Yalnız aşağıda heç bir kolleksiya seçilməyənə qədər istifadə olunur. Ünvan kitabçasının adı və ya ünvanı; yoxdursa, “yalnız oxumaq üçün” aktiv olmadıqda ilk sinxronlaşdırma onu yaradır. Bütün ünvan kitabçası sinxronlaşdırılır, iki ünvan kitabçasının paylaşdığı ad isə rədd edilir."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "İstifadəçi adı"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Hansı kontaktlar ünvan kitabçasında kart alır. Artıq orada olan kartlar qalır və bu söndürülü olduğu müddətdə onlara başqa heç nə göndərilmir."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Hər şirkəti ayrıca kart kimi yaz (adı və vebsaytı olan şirkət kartı), şirkətlə uyğun saxlanılır."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Öz məlumatlarınızı ayrıca karta yaz, yalnız bir istiqamətdə: telefondakı dəyişiklik profilinizə heç vaxt çatmır."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "öz kartınız"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Öz kartınız göndərilmədi: profilinizdə ad yoxdur."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Öz kartınız ünvan kitabçasından silindi; saxlanıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "“%(href)s” oxuna bilmədi: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "“%(name)s” burada dəyişdi, lakin sonra telefonda dəyişdi; onların versiyası götürüldü."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» eyni vaxtda hər iki tərəfdə dəyişdirildi; növbəti icra qərar verəcək."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» hər iki tərəfdə dəyişdirildi və telefondan gələn kartda vaxt göstərilmir: telefondakı versiya götürüldü."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "“%(name)s” telefonda dəyişdi, lakin sonra burada dəyişdi; bizimki saxlanıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "“%(name)s” müsahibəyə çevrilə bilmədi: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "“%(name)s” müsahibəyə çevrilə bilmədi: vaxtı oxuna bilmir."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "“%(name)s” təqvim deyil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "“%(name)s” tapşırıqlar siyahısı deyil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "“%(name)s” ünvan kitabçası deyil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» sizinlə yalnız oxumaq üçün paylaşılıb; telefondakı dəyişiklik tətbiq edilmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» serverdə başqa ünvana köçürüldü; cütləşmə qalır."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "“%(name)s” kartdan dəyişdirilmədi: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» ünvan kitabçasından silindi; burada saxlanıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "«%(name)s» buraxıldı: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: kartdakı nömrə artıq buradakı başqa qeydə aiddir, ona görə götürülmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: kartdakı nömrə götürülmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: kartdakı veb ünvan veb ünvan deyil, ona görə götürülmədi."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: kartdakı veb ünvan götürülmədi."
