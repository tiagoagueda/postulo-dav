msgstr "Schimbat aici pe %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Schimbat aici, dar schimbat mai târziu pe telefon; s-a păstrat versiunea lor."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Schimbat pe telefon pe %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Schimbat pe telefon, dar schimbat mai târziu aici; s-a păstrat versiunea noastră."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
