msgstr "Schimbat pe telefon pe %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Schimbat pe telefon, dar schimbat mai târziu aici; s-a păstrat versiunea noastră."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "S-au găsit agenda de contacte „%(book)s” și calendarul „%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Made on the server by the first sync if it is not there, exceptly read only is on. Numai această carte de adrese este atins."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Made on the server by the first sync if it is not there, exceptly read only is on. Numai acest calendar este atins."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nu scrieți niciodată serverului nici măcar pentru a face cartea de adrese sau calendarul. Contactele și interviurile încă vin; nimic nu iese."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
