#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d colecție aleasă"
msgstr[1] "%(count)d colecții alese"
msgstr[2] "%(count)d de colecții alese"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d evenimente din calendar nu sunt de la Postulo și au fost lăsate neatinse."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d înregistrări sunt asociate cu ceva din afara colecției alese și au fost lăsate neatinse."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d înregistrări nu au fost trimise, pentru că trimiterea acelui fel este dezactivată."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d sarcină din lista de sarcini nu provine de la Postulo și a fost lăsată neatinsă."
msgstr[1] "%(count)d sarcini din lista de sarcini nu provin de la Postulo și au fost lăsate neatinse."
msgstr[2] "%(count)d de sarcini din lista de sarcini nu provin de la Postulo și au fost lăsate neatinse."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "Eveniment (%(kind)s) eliminat din calendar pe alt dispozitiv; păstrat aici."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s nu este una dintre copiile de rezervă pe care le păstrează această destinație, așa că nu a fost ștearsă."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(fără companie)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(fără titlu)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Un card nu poate fi transformat în aceasta."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contact șters aici fusese modificat pe telefon de la ultima sincronizare. Fișa a fost lăsată în agendă și revine ca contact la următoarea rulare."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Un alt fișier se numește deja %(name)s în dosar și nu a fost suprascris."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Un memento a fost modificat pe ambele părți deodată; decide următoarea rulare."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Un memento șters aici fusese modificat pe telefon de la ultima sincronizare. Sarcina a fost lăsată în lista de sarcini."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "O cerere din afara colecțiilor alese nu a fost trimisă."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "O sarcină a fost modificată pe ambele părți deodată; decide următoarea rulare."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "O sarcină a fost mutată la altă adresă; rămâne asociată."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "carnet de adrese"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Agendă de contacte"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Carnete de adrese"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adrese"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Totul în dosar, cu nume descriptive"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Toate"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Păstrează în plus în lista de sarcini două sarcini pentru fiecare candidatură: una pentru a candida, care, bifată, vă trimite o sugestie, și una pentru a primi răspuns, care se închide când candidatura se încheie. Mementourile despre o candidatură stau sub sarcina ei deschisă."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Scrie în calendar, ca evenimente pe toată ziua, și zilele întregi din pagina Calendar (termenele candidaturilor, datele de închidere ale anunțurilor și datele până la care trebuie să răspunzi unei oferte), într-un singur sens: o modificare făcută pe telefon este suprascrisă. Necesită ca instanța să își cunoască propria adresă."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "O parolă de aplicație acolo unde serverul oferă una. Stocată criptat."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Un interviu s-a schimbat pe ambele părți deodată; următoarea rulare decide."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Un interviu șters aici fusese modificat pe telefon de la ultima sincronizare. Evenimentul a fost lăsat în calendar."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Un interviu a fost mutat la o altă adresă în calendar; asocierea se păstrează."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Candidează pentru %(role)s la %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "După companie și rol, fiecare în propriul dosar"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "calendar"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendar"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Calendare"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Anulat în calendar."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV și CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Modificat aici la %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Modificat aici, dar modificat ulterior pe telefon; s-a preluat versiunea de pe telefon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Modificat pe telefon la %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Modificat pe telefon, dar modificat ulterior aici; s-a păstrat versiunea de aici."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Colecții"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Termene și date"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Adresa dosarului"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "A fost găsit: %(what)s „%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "A fost găsit carnetul de adrese „%(book)s” (%(book_href)s) și calendarul „%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "A fost găsită lista de sarcini „%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Din cardul „%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Primește răspuns de la %(company)s despre %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Cum sunt aranjate fișierele"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "nu a putut fi salvat aici"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nu are fus orar"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "este un eveniment de o zi întreagă"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "adresa sau identificatorul său este prea lung"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "ora sa nu poate fi citită"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "fusul său orar „%(zone)s” nu este cunoscut aici"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Marcată ca aplicată în lista de sarcini"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Mai multe de tipul „%(what)s” sunt alese, iar o conexiune sincronizează doar una: niciunul nu a fost folosit. Adăugați câte o conexiune pentru fiecare sau renunțați la celelalte."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Mai multe colecții se numesc „%(name)s”. Alegeți una dintre ele după adresă, nu după nume."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nu scrie niciodată pe server, nici măcar pentru a crea carnetul de adrese, calendarul sau lista de sarcini. Contactele, interviurile și mementourile tot vin; nimic nu pleacă."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Niciuna"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Nicio colecție aleasă nu se află pe server."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numere"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Prin http:// parola trece prin rețea necriptată, iar „%(host)s” nu este o adresă din propria dumneavoastră rețea. Folosiți https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Parolă sau parolă de aplicație"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Apăsați Caută pe server, apoi alegeți un carnet de adrese, un calendar și o listă de sarcini. Doar acestea sunt citite sau scrise, iar un mod stabilit aici este cuvântul Postulo, nu lacătul serverului: o parolă de aplicație nu poate fi limitată la o singură colecție. Colecțiile se sincronizează întregi."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Citire și scriere"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "citire și scriere"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Doar citire"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "doar citire"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Modul doar citire este activ, așa că nu se creează nimic: creați pe server ceea ce lipsește sau indicați ceva ce există deja."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Doar citire pe server"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Mementourile nu au fost sincronizate: lista de sarcini nu a putut fi folosită. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Trimite companiile"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Trimite contactele"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Trimite propriul meu card"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adresa serverului"

#: src/postulo_dav/backup.py
#, fuzzy
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Păstrat criptat. Deschide un dosar cu copiile de rezervă ale tuturor conturilor, iar ștergerea este modul în care sunt eliminate cele vechi: folosește unul care ajunge doar la acest dosar, precum un subcont Hetzner Storage Box sau un cont creat pentru copii de rezervă, și nimic altceva."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Păstrată criptat. Majoritatea serverelor nu pot limita o parolă la un singur dosar; o pot face o partajare publică Nextcloud care permite încărcări sau un subcont Hetzner Storage Box."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "listă de sarcini"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Listă de sarcini"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Liste de sarcini"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Sarcini despre candidaturi"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Cardul s-a modificat de când a fost listat."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Cardul nu se află în carnetul de adrese ales."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Sarcina s-a modificat de când a fost listată."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Sarcina nu se află în lista de sarcini aleasă."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Elementul „%(kind)s” este asociat cu un eveniment care are organizator, așa că este citit din calendar și niciodată scris în el."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Evenimentul (%(kind)s) din calendar se termină înainte de a începe, așa că nu a fost mutat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Agenda „%(name)s” nu se află pe server."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa trebuie să înceapă cu https:// — de exemplu %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Copia de rezervă nu se află în dosar după încărcare."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Calendarul „%(name)s” nu primește evenimente, așa că nu a fost folosit."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Calendarul „%(name)s” nu se află pe server."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Cardul nu a putut fi citit, așa că nu a fost modificat."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Cardul nu are un nume din care să se facă o companie."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Cardul nu are un nume din care să se facă un contact."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Colecția „%(href)s” nu mai este pe server. Nu a fost creată din nou; alegeți alta sau renunțați la ea."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Prima sincronizare va crea ceea ce lipsește."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Dosarul %(path)s nu a putut fi creat: dosarul de deasupra lui nu există."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Dosarul %(path)s nu există pe server. Creează-l mai întâi acolo: Postulo nu creează dosarul în care sunt păstrate copiile de rezervă."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Dosarul %(path)s nu există pe server. Creează-l mai întâi acolo: Postulo creează doar dosarele de sub el."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Dosarul %(path)s există și conține %(count)d elemente."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Dosarul %(path)s există și conține %(count)d copii de rezervă Postulo."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Dosarul are loc pentru %(free)s, iar copia de rezervă are nevoie de %(needed)s, așa că nu s-a trimis nimic."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Dosarul conține %(found)d octeți din ea, iar copia de rezervă are %(size)d: neconfirmat."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Dosarul este plin: serverul nu mai are loc pentru fișier."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Serverul a răspuns HTTP %(status)d pentru %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Serverul nu vă lasă să scrieți în „%(name)s”: doar citire."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Serverul nu indică locația calendarelor."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Serverul nu indică locația agendelor."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Serverul nu spune cât de mare este fișierul, deci nu poate confirma."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Serverul nu spune unde este contul %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Serverul nu spune dacă se poate scrie"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Serverul a indicat o adresă din afara propriului domeniu (%(host)s); aceasta nu a fost urmată."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Serverul a redirecționat %(path)s de prea multe ori."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Serverul a redirecționat o încărcare, iar redirecționarea nu este urmată."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Serverul a refuzat numele de utilizator sau parola."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Serverul nu a vrut să creeze o listă de sarcini, așa că s-ar putea să nu păstreze sarcini."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Adresa serverului, de exemplu https://cloud.example.org, sau adresa serviciului său DAV, dacă acesta se află sub o cale, de exemplu https://example.org/dav.php/. Postulo găsește de acolo locațiile agendelor și ale calendarelor."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Răspunsul serverului nu a putut fi citit: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Răspunsul serverului pentru %(path)s a fost prea mare sau prea lent și nu a fost citit."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Sarcina nu a putut fi citită, așa că nu a fost modificată."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Sarcina pentru „%(name)s” a fost eliminată din lista de sarcini; mementoul a fost păstrat."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Sarcina nu are termen din care să se facă un memento."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Lista de sarcini „%(name)s” nu se află pe server."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Sarcina „%(name)s” nu are termen, așa că nu a fost transformată în memento."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Sarcina „%(name)s” a fost eliminată din lista de sarcini; nu este creată din nou."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Timpul pentru această încărcare a expirat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Ora evenimentului (%(kind)s) din calendar nu a putut fi folosită (%(why)s), așa că evenimentul nu a fost mutat."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Ora sarcinii „%(name)s” nu a putut fi folosită (%(why)s), așa că mementoul nu a fost mutat."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Mai este loc pentru încă %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Această colecție este doar pentru citire aici, așa că o cerere %(method)s nu a fost trimisă."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Prea multe fișiere se numesc deja %(name)s în acel dosar."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Folosit doar cât timp nu este aleasă nicio colecție mai jos. Un nume sau o adresă de calendar; unul care nu există este creat la prima sincronizare, cu excepția cazului în care este activat doar citire. Întregul calendar se sincronizează, iar un nume pe care îl au două calendare este refuzat."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Folosit doar cât timp nu este aleasă nicio colecție mai jos. Un nume sau o adresă a unei liste de sarcini în care să se păstreze mementourile; dacă este goală, nu se folosește niciuna. Un nume care nu există este creat la prima sincronizare, cu excepția cazului în care este activat doar citire. Necesită un server care păstrează sarcini."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Folosit doar cât timp nu este aleasă nicio colecție mai jos. Un nume sau o adresă de carnet de adrese; unul care nu există este creat la prima sincronizare, cu excepția cazului în care este activat doar citire. Întregul carnet de adrese se sincronizează, iar un nume pe care îl au două carnete de adrese este refuzat."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Nume de utilizator"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "adrese web"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Dosar WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Ce contacte primesc un card în carnetul de adrese. Cardurile deja existente rămân și nu li se mai trimite nimic cât timp aceasta este dezactivată."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Scrie fiecare companie ca un card propriu (un card de companie, cu numele și site-ul web), ținut la zi cu compania."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Scrie-ți propriile date într-un card propriu, într-un singur sens: o modificare făcută pe telefon nu ajunge niciodată în profilul tău."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "propriul card"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Propriul card nu a fost trimis: profilul dvs. nu are nume."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Propriul card a fost eliminat din carnetul de adrese; păstrat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s” nu a putut fi citit: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s” s-a modificat aici, dar s-a modificat mai târziu pe telefon; a fost luată versiunea de acolo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s” s-a schimbat pe ambele părți deodată; următoarea rulare decide."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s” s-a modificat de ambele părți, iar fișa de pe telefon nu indică nicio oră: s-a preluat versiunea de pe telefon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s” s-a modificat pe telefon, dar s-a modificat mai târziu aici; a fost păstrată versiunea noastră."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s” nu a putut fi transformat într-un interviu: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s” nu a putut fi transformat într-un interviu: ora nu poate fi citită."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s” nu este un calendar."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s” nu este o listă de sarcini."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s” nu este un carnet de adrese."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s” vă este partajat doar pentru citire; modificarea de pe telefon nu a fost aplicată."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s” s-a mutat la o altă adresă pe server; asocierea se păstrează."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s” nu a fost modificat pe baza cardului: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s” a fost eliminat din agenda de contacte; păstrat aici."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "„%(name)s” a fost omis: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "„%(name)s”: %(what)s de pe cartea de vizită nu au fost preluate, ca să nu se piardă nimic din ce este păstrat aici."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "„%(name)s”: un număr, o adresă sau o adresă web de pe cartea de vizită nu a fost preluat: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "„%(name)s”: e-mailul de pe cartea de vizită nu a fost preluat: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s”: numărul de pe fișă aparține deja altei înregistrări de aici, așa că nu a fost preluat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s”: numărul de pe fișă nu a fost preluat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s”: adresa web de pe fișă nu este o adresă web, așa că nu a fost preluată."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s”: adresa web de pe fișă nu a fost preluată."
