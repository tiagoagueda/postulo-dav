#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d evenimente din calendar nu sunt de la Postulo și au fost lăsate neatinse."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s eliminat din calendar pe alt dispozitiv; păstrat aici."

