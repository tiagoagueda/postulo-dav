#, fuzzy
msgid "Read only"
msgstr "Doar citire"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "doar citire"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Citit numai este pe, astfel încât nimic nu se face: creați-l pe server, sau nume unul care este deja acolo."

