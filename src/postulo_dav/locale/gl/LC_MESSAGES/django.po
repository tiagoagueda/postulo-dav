#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d colección escollida"
msgstr[1] "%(count)d coleccións escollidas"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d eventos do calendario non son do Postulo e deixáronse como estaban."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d rexistros están emparellados con algo fóra da colección escollida e déixaronse como estaban."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d rexistros non se enviaron, porque o envío dese tipo está desactivado."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d tarefa da lista de tarefas non é de Postulo e deixouse como estaba."
msgstr[1] "%(count)d tarefas da lista de tarefas non son de Postulo e deixáronse como estaban."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: quitouse do calendario noutro dispositivo; consérvase aquí."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s non é unha das copias de seguranza que garda este destino, así que non se eliminou."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(sen empresa)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(sen título)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Unha tarxeta non pode converterse niso."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacto eliminado aquí cambiárase no teléfono desde a última sincronización. A tarxeta deixouse no caderno de enderezos e volve como contacto na próxima execución."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Xa hai outro ficheiro chamado %(name)s no cartafol, e non se sobrescribiu."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Un recordatorio cambiou nos dous lados á vez; a próxima execución decidirá."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Un recordatorio eliminado aquí cambiara no teléfono desde a última sincronización. A tarefa deixouse na lista de tarefas."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Non se enviou unha solicitude fóra das coleccións escollidas."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Unha tarefa cambiou nos dous lados á vez; a próxima execución decidirá."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Unha tarefa moveuse a outro enderezo; segue emparellada."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "axenda de enderezos"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Caderno de enderezos"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Axendas de enderezos"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "enderezos"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Todo no cartafol, con nomes descritivos"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Todas"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Manter ademais dúas tarefas por cada candidatura na lista de tarefas: unha para candidatarse, que ao marcala che envía unha suxestión, e outra para esperar resposta, que se pecha cando remata a candidatura. Os recordatorios dunha candidatura quedan baixo a súa tarefa aberta."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Escribir tamén os días completos da páxina Calendario (prazos de solicitude, datas de peche dos anuncios e datas ata as que hai que responder a unha oferta) no calendario como eventos de todo o día, nun só sentido: un cambio feito no teléfono sobrescríbese. Require que a instancia coñeza o seu propio enderezo."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Un contrasinal de aplicación, se o servidor o ofrece. Almacénase cifrado."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Unha entrevista cambiou nos dous lados á vez; a próxima execución decide."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Unha entrevista eliminada aquí cambiárase no teléfono desde a última sincronización. O evento deixouse no calendario."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Unha entrevista trasladouse a outro enderezo no calendario; segue emparellada."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Candidatarse a %(role)s en %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Por empresa e posto, cada un no seu propio cartafol"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "calendario"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Calendario"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Calendarios"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Cancelada no calendario."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV e CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Cambiado aquí o %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Cambiado aquí, pero despois cambiouse no teléfono; quedou a versión do teléfono."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Cambiado no teléfono o %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Cambiado no teléfono, pero despois cambiouse aquí; conservouse a nosa."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Coleccións"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Prazos e datas"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Enderezo do cartafol"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Atopouse: %(what)s “%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Atopáronse a axenda de enderezos “%(book)s” (%(book_href)s) e o calendario “%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Atopouse a lista de tarefas “%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Da tarxeta “%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Esperar resposta de %(company)s sobre %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Como se organizan os ficheiros"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "non se puido gardar aquí"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "non ten zona horaria"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "é un evento de todo o día"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "o seu enderezo ou identificador é demasiado longo"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "non se pode ler a súa hora"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "a súa zona horaria «%(zone)s» non se coñece aquí"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Marcada como candidatura enviada na lista de tarefas"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Escolleuse máis dun elemento de tipo %(what)s, e unha conexión sincroniza só un: non se usou ningún. Engade unha conexión para cada un ou deixa os outros."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Hai máis dunha colección chamada “%(name)s”. Escolle unha polo seu enderezo en lugar de polo nome."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Non escribir nunca no servidor, nin sequera para crear a axenda de enderezos, o calendario ou a lista de tarefas. Os contactos, as entrevistas e os recordatorios seguen entrando; non sae nada."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Ningunha"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ningunha das coleccións escollidas está no servidor."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "números"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Por http:// o contrasinal viaxa pola rede sen cifrar, e «%(host)s» non é un enderezo da túa propia rede. Usa https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Contrasinal ou contrasinal de aplicación"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Preme Buscar no servidor e logo escolle unha axenda de enderezos, un calendario e unha lista de tarefas. Só eses se len ou se escriben, e un modo definido aquí é palabra de Postulo, non un bloqueo do servidor: un contrasinal de aplicación non se pode limitar a unha soa colección. Sincronízanse as coleccións completas."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Lectura e escritura"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "lectura e escritura"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Só lectura"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "só lectura"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "«Só lectura» está activado, así que non se crea nada: créao no servidor ou indica un que xa exista."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Só lectura no servidor"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Non se sincronizaron os recordatorios: non se puido usar a lista de tarefas. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Enviar empresas"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Enviar contactos"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Enviar a miña propia tarxeta"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Enderezo do servidor"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Gárdase cifrado. Abre un cartafol coas copias de seguranza de todas as contas, e borrar é a forma de quitar as antigas: usa unha conta que só chegue a este cartafol, como unha subconta de Hetzner Storage Box ou unha conta creada para as copias de seguranza, e nada máis."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Gárdase cifrado. A maioría dos servidores non poden limitar un contrasinal a un cartafol; un recurso compartido público de Nextcloud que permita cargas, ou unha subconta de Hetzner Storage Box, si poden."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "lista de tarefas"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Lista de tarefas"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Listas de tarefas"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Tarefas sobre candidaturas"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Esa tarxeta cambiou desde que se listou."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Esa tarxeta non está na axenda de enderezos escollida."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Esa tarefa cambiou desde que se listou."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Esa tarefa non está na lista de tarefas escollida."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "O elemento “%(kind)s” está emparellado cun evento que ten organizador, polo que se le do calendario e nunca se escribe nel."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s: no calendario remata antes de comezar, así que non se moveu."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "O caderno de enderezos «%(name)s» non está no servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "O enderezo debe comezar por https:// — por exemplo, %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "A copia de seguranza non está no cartafol despois da carga."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "O calendario “%(name)s” non acepta eventos, polo que non se usou."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "O calendario «%(name)s» non está no servidor."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Non se puido ler a tarxeta, polo que non se modificou."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "A tarxeta non ten nome co que facer unha empresa."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "A tarxeta non ten nome co que facer un contacto."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "A colección “%(href)s” xa non está no servidor. Non se volveu crear; escolle outra ou déixaa."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "A primeira sincronización creará o que falte."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Non se puido crear o cartafol %(path)s: o cartafol superior non existe."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "O cartafol %(path)s non existe no servidor. Créao primeiro alí: Postulo non crea o cartafol no que se gardan as copias de seguranza."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "O cartafol %(path)s non existe no servidor. Créao primeiro alí: Postulo só crea os cartafoles que hai debaixo."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "O cartafol %(path)s existe e contén %(count)d elementos."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "O cartafol %(path)s existe e contén %(count)d copias de seguranza de Postulo."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "O cartafol ten espazo para %(free)s e a copia de seguranza necesita %(needed)s, así que non se enviou nada."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "O cartafol contén %(found)d bytes dela e a copia de seguranza ten %(size)d: sen confirmar."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "O cartafol está cheo: o servidor non ten espazo para o ficheiro."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "O servidor respondeu HTTP %(status)d para %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "O servidor non che permite escribir en “%(name)s”: só lectura."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "O servidor non indica ningún espazo de calendarios."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "O servidor non indica ningún espazo de cadernos de enderezos."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "O servidor non indica o tamaño do ficheiro, así que non pode confirmalo."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "O servidor non indica onde está a conta de %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "O servidor non di se se pode escribir nel"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "O servidor remitiu a un enderezo fóra do seu (%(host)s); non se seguiu."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "O servidor redirixiu %(path)s demasiadas veces."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "O servidor redirixiu unha carga, e iso non se segue."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "O servidor rexeitou o nome de usuario ou contrasinal."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "O servidor non quixo crear unha lista de tarefas, polo que pode que non garde tarefas."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "O enderezo do servidor, por exemplo https://cloud.example.org, ou o enderezo do seu servizo DAV cando está baixo unha ruta, por exemplo https://example.org/dav.php/. O Postulo atopa desde aí os espazos do caderno de enderezos e do calendario."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Non se puido ler a resposta do servidor: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "A resposta do servidor para %(path)s era demasiado grande ou demasiado lenta, e non se leu."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Non se puido ler a tarefa, polo que non se modificou."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "A tarefa de “%(name)s” quitouse da lista de tarefas; o recordatorio conservouse."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "A tarefa non ten data límite coa que facer un recordatorio."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "A lista de tarefas “%(name)s” non está no servidor."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "A tarefa “%(name)s” non ten data límite, polo que non se converteu en recordatorio."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "A tarefa “%(name)s” quitouse da lista de tarefas; non se volve crear."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Esgotouse o tempo desta carga."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "%(kind)s: non se puido usar a súa hora no calendario (%(why)s), así que non se moveu."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Non se puido usar a hora da tarefa “%(name)s” (%(why)s), polo que non se moveu o recordatorio."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Hai espazo para %(size)s máis."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Esta colección é só de lectura aquí, polo que non se enviou unha solicitude %(method)s."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Xa hai demasiados ficheiros co nome %(name)s nese cartafol."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Úsase só mentres non haxa ningunha colección escollida abaixo. Un nome ou un enderezo dun calendario; se non existe, créao a primeira sincronización, a menos que o modo de só lectura estea activado. Sincronízase o calendario completo e rexéitase un nome que comparten dous calendarios."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Úsase só mentres non haxa ningunha colección escollida abaixo. Un nome ou un enderezo dunha lista de tarefas onde gardar os teus recordatorios; en branco, non se usa ningunha. Un nome que non existe créao a primeira sincronización, a menos que o modo de só lectura estea activado. Require un servidor que garde tarefas."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Úsase só mentres non haxa ningunha colección escollida abaixo. Un nome ou un enderezo dunha axenda de enderezos; se non existe, créaa a primeira sincronización, a menos que o modo de só lectura estea activado. Sincronízase a axenda de enderezos completa e rexéitase un nome que comparten dúas axendas."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Nome de usuario"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "enderezos web"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Cartafol WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Que contactos reciben unha tarxeta na axenda de enderezos. As tarxetas que xa están quedan, e non se lles envía nada máis mentres isto estea desactivado."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Escribir cada empresa como unha tarxeta propia (unha tarxeta de empresa, co seu nome e sitio web), mantida ao día coa empresa."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Escribir os teus propios datos nunha tarxeta aparte, nun só sentido: un cambio feito no teléfono nunca chega ao teu perfil."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "a túa propia tarxeta"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Non se enviou a túa propia tarxeta: o teu perfil non ten nome."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "A túa propia tarxeta quitouse da axenda de enderezos; conservouse."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "Non se puido ler “%(href)s”: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "“%(name)s” cambiou aquí, pero cambiou despois no teléfono; tomouse a versión do teléfono."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» cambiou nos dous lados á vez; a próxima execución decide."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» cambiou nos dous lados, e a tarxeta do teléfono non indica ningunha hora: tomouse a versión do teléfono."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "“%(name)s” cambiou no teléfono, pero cambiou despois aquí; conservouse a versión de aquí."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "“%(name)s” non puido converterse nunha entrevista: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "“%(name)s” non puido converterse nunha entrevista: non se pode ler a súa hora."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "“%(name)s” non é un calendario."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "“%(name)s” non é unha lista de tarefas."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "“%(name)s” non é unha axenda de enderezos."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» compártese contigo só para lectura; non se aplicou o cambio do teléfono."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» trasladouse a outro enderezo do servidor; segue emparellado."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "“%(name)s” non se modificou a partir da tarxeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» quitouse do caderno de enderezos; consérvase aquí."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "Omitiuse «%(name)s»: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "«%(name)s»: non se tomaron da tarxeta: %(what)s, para que non se perda nada do que se garda aquí."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "«%(name)s»: non se tomou un número, un enderezo ou un enderezo web da tarxeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "«%(name)s»: non se tomou o correo electrónico da tarxeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: o número da tarxeta xa o ten outro rexistro aquí, así que non se tomou."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: non se tomou o número da tarxeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: o enderezo web da tarxeta non é un enderezo web, así que non se tomou."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: non se tomou o enderezo web da tarxeta."
