#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d notikumi kalendārā nav no Postulo un tika atstāti neskarti."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s noņemta no kalendāra citā ierīcē; šeit paturēta."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(bez uzņēmuma)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakts dzēsts šeit tika mainīts tālrunī kopš pēdējās sinhronizācijas. Karte tika atstāta adrešu grāmatā, un nāk atpakaļ kā kontaktpersona nākamajā palaist."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adrešu grāmata"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Lietotnes parole, ja serveris tādu piedāvā. Glabāta šifrēti."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Intervija mainīta abās pusēs vienlaikus; izšķirs nākamā palaišana."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Kopš pēdējās sinhronizācijas tālrunī tika mainīta šeit svītrota intervija. Notikums tika atstāts kalendārā."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalendārs"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Atcelta kalendārā."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV un CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Mainīts šeit %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Mainīts šeit, bet vēlāk mainīts telefonā; ņemta viņu versija."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Mainīts telefonā %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Mainīts telefonā, bet vēlāk mainīts šeit; paturēta mūsu versija."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Atrasta adrešu grāmata “%(book)s” un kalendārs “%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Made uz servera ar pirmo sinhronizāciju, ja tas nav tur, ja vien lasīt tikai ir ieslēgts. Tikai šī adrešu grāmata ir aizkustināta."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Made uz servera ar pirmo sinhronizāciju, ja tas nav tur, ja vien lasīt tikai ir ieslēgts. Tikai šis kalendārs ir aizkustināts."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nekad nerakstiet uz servera — pat ne lai izveidotu adrešu grāmatu vai kalendāru. Kontakti un intervijas joprojām ienāk, nekas nenotiek."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Virs http://parole iet pāri tīklam skaidri, un “%(host)s” nav adrese savā tīklā. Izmanto https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Parole vai lietotnes parole"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Tikai lasīt"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "tikai lasīt"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Lasīt tikai ir ieslēgts, tāpēc nekas netiek veikts: izveidot to uz servera, vai nosaukt vienu, kas jau ir tur."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Servera adrese"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adrešu grāmata “%(name)s” nav uz servera."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresei jāsākas ar https:// — piemēram %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendārs “%(name)s” nav uz servera."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Pirmā sinhronizācija padarīs to, kas trūkst."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Servera sakne, piem., https://cloud.example.org. No turienes Postulo atrod adrešu grāmatas un kalendāra mājvietas."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Lietotājvārds"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
