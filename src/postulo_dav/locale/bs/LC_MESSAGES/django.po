#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Ako ne postoji, prva sinhronizacija ga pravi na serveru, osim ako je uključeno „samo za čitanje“. Dira se samo ovaj adresar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Ako ne postoji, prva sinhronizacija ga pravi na serveru, osim ako je uključeno „samo za čitanje“. Dira se samo ovaj kalendar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikad ne pisati na server — čak ni da bi se napravio adresar ili kalendar. Kontakti i intervjui i dalje stižu; ništa ne odlazi."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Preko http:// lozinka putuje mrežom nešifrirana, a „%(host)s“ nije adresa na vašoj vlastitoj mreži. Koristite https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Lozinka ili lozinka aplikacije"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Samo za čitanje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "samo za čitanje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Uključeno je „samo za čitanje“, pa se ništa ne pravi: kreirajte ga na serveru ili navedite neki koji već postoji."

