#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Događaji u kalendaru koji nisu iz Postula ostavljeni su netaknuti: %(count)d."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: uklonjeno iz kalendara na drugom uređaju; ovdje zadržano."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(bez kompanije)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt obrisan ovdje bio je izmijenjen na telefonu nakon zadnje sinhronizacije. Kartica je ostavljena u adresaru i vraća se kao kontakt pri sljedećem pokretanju."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adresar"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Lozinka aplikacije, ako je server nudi. Pohranjena šifrirano."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Intervju je izmijenjen na obje strane istovremeno; odlučit će sljedeće pokretanje."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Intervju obrisan ovdje bio je izmijenjen na telefonu nakon zadnje sinhronizacije. Događaj je ostavljen u kalendaru."

