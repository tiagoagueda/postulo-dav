#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d абраная калекцыя"
msgstr[1] "%(count)d абраныя калекцыі"
msgstr[2] "%(count)d абраных калекцый"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Падзей у календары, не створаных Postulo: %(count)d; іх пакінулі без змен."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d запісаў злучаны з чымсьці па-за абранай калекцыяй і засталіся без змен."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d запісаў не адпраўлена, бо адпраўка гэтага віду выключана."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d задача ў спісе задач не з Postulo і засталася без змен."
msgstr[1] "%(count)d задачы ў спісе задач не з Postulo і засталіся без змен."
msgstr[2] "%(count)d задач у спісе задач не з Postulo і засталіся без змен."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: выдалена з календара на іншай прыладзе; тут захавана."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s не з’яўляецца адной з рэзервовых копій, якія захоўвае гэтае месца прызначэння, таму не быў выдалены."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(без кампаніі)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(без назвы)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "З карткі гэтага не зрабіць."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Кантакт, выдалены тут, быў зменены на тэлефоне пасля апошняй сінхранізацыі. Картку пакінулі ў адраснай кнізе, і пры наступным запуску яна вернецца як кантакт."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "У папцы ўжо ёсць іншы файл з назвай %(name)s, і яго не перазапісалі."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Напамін змяніўся з абодвух бакоў адначасова; вырашыць наступны запуск."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Напамін, выдалены тут, быў зменены на тэлефоне пасля апошняй сінхранізацыі. Задача засталася ў спісе задач."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Запыт па-за абранымі калекцыямі не адпраўлены."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Задача змянілася з абодвух бакоў адначасова; вырашыць наступны запуск."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Задача перамешчана на іншы адрас; па-ранейшаму злучана."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "адрасная кніга"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Адрасная кніга"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Адрасныя кнігі"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "адрасы"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Усё ў адной папцы, з апісальнымі назвамі"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Усе"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Таксама трымаць у спісе задач дзве задачы для кожнай заяўкі: адну, каб падаць заяўку, — яе адзнака адпраўляе вам падказку, — і адну, каб дачакацца адказу, якая закрываецца, калі заяўка скончаная. Напаміны пра заяўку ляжаць пад яе адкрытай задачай."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Таксама запісваць у каляндар цэлыя дні са старонкі «Каляндар» (тэрміны падачы заяў, даты закрыцця вакансій і даты, да якіх трэба адказаць на прапанову) як падзеі на ўвесь дзень, толькі ў адзін бок: змена, зробленая на тэлефоне, перазапісваецца. Патрабуецца, каб усталяванне ведала свой уласны адрас."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Пароль праграмы, калі сервер яго прапануе. Захоўваецца ў зашыфраваным выглядзе."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Сумоўе было зменена з абодвух бакоў адначасова; вырашыць наступны запуск."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Сумоўе, выдаленае тут, было зменена на тэлефоне пасля апошняй сінхранізацыі. Падзею пакінулі ў календары."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Сумоўе перамясцілася на іншы адрас у календары; сувязь захавана."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Падаць заяўку на %(role)s у %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Па кампаніі і пасадзе, кожная ў сваёй папцы"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "каляндар"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Каляндар"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Календары"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Скасавана ў календары."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV і CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Зменена тут %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Зменена тут, але на тэлефоне — пазней; узята іх версія."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Зменена на тэлефоне %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Зменена на тэлефоне, але тут — пазней; пакінута наша версія."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Калекцыі"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Тэрміны і даты"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Адрас папкі"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Знойдзена: %(what)s «%(name)s» (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Знойдзены адрасная кніга «%(book)s» (%(book_href)s) і каляндар «%(calendar)s» (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Знойдзены спіс задач «%(name)s» (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "З карткі «%(name)s»: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Дачакацца адказу ад %(company)s наконт %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Як размяшчаюцца файлы"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "яго не ўдалося захаваць тут"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "у яго няма часавага пояса"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "гэта падзея на ўвесь дзень"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "яго адрас або ідэнтыфікатар занадта доўгі"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "яго час немагчыма прачытаць"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "яго часавы пояс «%(zone)s» тут невядомы"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Пазначана як пададзеная ў спісе задач"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Абрана больш за адзін элемент віду «%(what)s», а адно падключэнне сінхранізуе толькі адзін: ніводзін не выкарыстаны. Дадайце падключэнне для кожнага або пакіньце астатніх."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Больш за адну калекцыю завуць «%(name)s». Абярыце адну з іх па адрасе, а не па назве."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Ніколі не пісаць на сервер, нават каб стварыць адрасную кнігу, каляндар або спіс задач. Кантакты, сумоўі і напаміны па-ранейшаму прыходзяць; нічога не сыходзіць."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Няма"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ніводная з абраных калекцый не знаходзіцца на серверы."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "нумары"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Праз http:// пароль перадаецца па сетцы ў адкрытым выглядзе, а «%(host)s» не з'яўляецца адрасам у вашай уласнай сетцы. Выкарыстоўвайце https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Пароль або пароль праграмы"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Націсніце «Шукаць на серверы», потым абярыце адну адрасную кнігу, адзін каляндар і адзін спіс задач. Толькі яны чытаюцца або запісваюцца, а рэжым, заданы тут, — слова Postulo, а не замок сервера: пароль праграмы нельга абмежаваць адной калекцыяй. Сінхранізуюцца цэлыя калекцыі."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Чытанне і запіс"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "чытанне і запіс"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Толькі чытанне"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "толькі чытанне"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Уключаны рэжым «толькі чытанне», таму нічога не ствараецца: стварыце патрэбнае на серверы або ўкажыце тое, што там ужо ёсць."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Толькі для чытання на серверы"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Напаміны не сінхранізаваны: спіс задач не ўдалося выкарыстаць. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Адпраўляць кампаніі"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Адпраўляць кантакты"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Адправіць маю ўласную картку"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Адрас сервера"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Захоўваецца ў зашыфраваным выглядзе. Адкрывае папку з рэзервовымі копіямі ўсіх уліковых запісаў, а выдаленнем старыя копіі прыбіраюцца: выкарыстоўвайце ўліковы запіс, які мае доступ толькі да гэтай папкі, напрыклад дадатковы ўліковы запіс Hetzner Storage Box або запіс, створаны для рэзервовых копій, і больш нічога."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Захоўваецца ў зашыфраваным выглядзе. Большасць сервераў не ўмеюць абмежаваць пароль адной папкай; публічны доступ Nextcloud з дазволам загрузкі або дадатковы ўліковы запіс Hetzner Storage Box умеюць."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "спіс задач"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Спіс задач"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Спісы задач"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Задачы па заяўках"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Гэтая картка змянілася з моманту, калі была паказана ў спісе."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Гэтай карткі няма ў абранай адраснай кнізе."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Гэтая задача змянілася з моманту, калі была паказана ў спісе."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Гэтай задачы няма ў абраным спісе задач."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Элемент (%(kind)s) злучаны з падзеяй, у якой ёсць арганізатар, таму ён чытаецца з календара і ніколі не запісваецца ў яго."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Падзея (%(kind)s) у календары заканчваецца раней, чым пачынаецца, таму яе не перанеслі."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Адраснай кнігі «%(name)s» няма на серверы."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Адрас павінен пачынацца з https:// — напрыклад, %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Пасля загрузкі рэзервовай копіі няма ў папцы."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Каляндар «%(name)s» не прымае падзеі, таму не быў выкарыстаны."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Календара «%(name)s» няма на серверы."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Картку не ўдалося прачытаць, таму яна не была зменена."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "У карткі няма назвы, з якой можна зрабіць кампанію."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "У карткі няма імя, з якога можна зрабіць кантакт."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Калекцыі «%(href)s» больш няма на серверы. Яна не была створана нанова; абярыце іншую або пакіньце гэта."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Першая сінхранізацыя створыць тое, чаго не хапае."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Не ўдалося стварыць папку %(path)s: папкі вышэй яе няма."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Папкі %(path)s няма на серверы. Спачатку стварыце яе там: Postulo не стварае папку, у якой захоўваюцца рэзервовыя копіі."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Папкі %(path)s няма на серверы. Спачатку стварыце яе там: Postulo стварае толькі папкі ніжэй яе."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Папка %(path)s існуе, у ёй элементаў: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Папка %(path)s існуе, у ёй рэзервовых копій Postulo: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "У папцы ёсць месца для %(free)s, а рэзервовай копіі патрэбна %(needed)s, таму нічога не адпраўлена."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "У папцы ёсць %(found)d байт ад рэзервовай копіі, а яе памер — %(size)d: не пацверджана."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Папка запоўнена: на серверы няма месца для файла."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Сервер адказаў HTTP %(status)d на %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Сервер не дазваляе пісаць у «%(name)s»: толькі для чытання."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Сервер не ўказвае хатні каталог календара."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Сервер не ўказвае хатні каталог адраснай кнігі."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Сервер не паведамляе памер файла, таму пацвердзіць не можа."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Сервер не паведамляе, дзе знаходзіцца ўліковы запіс %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Сервер не паведамляе, ці можна ў яе пісаць"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Сервер накіраваў на адрас па-за сваімі межамі (%(host)s); пераход не выкананы."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Сервер перанакіроўваў %(path)s занадта шмат разоў."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Сервер перанакіраваў загрузку, а гэта не выконваецца."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Сервер адхіліў імя карыстальніка або пароль."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Сервер не захацеў ствараць спіс задач, таму, магчыма, не захоўвае задачы."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Адрас сервера, напрыклад https://cloud.example.org, або адрас яго службы DAV, калі яна знаходзіцца па шляху, напрыклад https://example.org/dav.php/. Адтуль Postulo знаходзіць хатнія каталогі адраснай кнігі і календара."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Не ўдалося прачытаць адказ сервера: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Адказ сервера для %(path)s быў занадта вялікі або занадта павольны, і не быў прачытаны."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Задачу не ўдалося прачытаць, таму яна не была зменена."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Задача для «%(name)s» выдалена са спісу задач; напамін захаваны."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "У задачы няма тэрміну, з якога можна зрабіць напамін."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Спіса задач «%(name)s» няма на серверы."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "У задачы «%(name)s» няма тэрміну, таму напамін з яе не створаны."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Задача «%(name)s» выдалена са спісу задач; нанова не ствараецца."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Час, адведзены на гэтую загрузку, скончыўся."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Час падзеі (%(kind)s) у календары немагчыма было выкарыстаць (%(why)s), таму яе не перанеслі."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Час задачы «%(name)s» не ўдалося выкарыстаць (%(why)s), таму напамін не быў перамешчаны."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Ёсць месца яшчэ для %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Гэта калекцыя тут толькі для чытання, таму %(method)s не быў адпраўлены."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "У гэтай папцы ўжо занадта шмат файлаў з назвай %(name)s."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Выкарыстоўваецца, толькі пакуль ніжэй не абрана ніводнай калекцыі. Назва або адрас календара; калі яго няма, першая сінхранізацыя яго стварае, акрамя выпадку, калі ўключана «толькі для чытання». Сінхранізуецца ўвесь каляндар, а назва, якую маюць два календары, адхіляецца."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Выкарыстоўваецца, толькі пакуль ніжэй не абрана ніводнай калекцыі. Назва або адрас спісу задач, дзе трымаюцца вашы напаміны; пуста — і ніводны не выкарыстоўваецца. Назву, якой няма, стварае першая сінхранізацыя, акрамя выпадку, калі ўключана «толькі для чытання». Патрэбны сервер, які захоўвае задачы."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Выкарыстоўваецца, толькі пакуль ніжэй не абрана ніводнай калекцыі. Назва або адрас адраснай кнігі; калі яе няма, першая сінхранізацыя яе стварае, акрамя выпадку, калі ўключана «толькі для чытання». Сінхранізуецца ўся адрасная кніга, а назва, якую маюць дзве адрасныя кнігі, адхіляецца."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Імя карыстальніка"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "вэб-адрасы"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Папка WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Якія кантакты атрымліваюць картку ў адраснай кнізе. Карткі, што ўжо там, застаюцца, і пакуль гэта выключана, ім больш нічога не адпраўляецца."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Запісваць кожную кампанію як асобную картку (картка кампаніі з яе назвай і сайтам), якая трымаецца ў адпаведнасці з кампаніяй."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Запісваць вашы ўласныя даныя ў асобную картку, толькі ў адзін бок: змена на тэлефоне ніколі не трапляе ў ваш профіль."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "ваша ўласная картка"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Ваша ўласная картка не адпраўлена: у вашым профілі няма імя."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Ваша ўласная картка выдалена з адраснай кнігі; захавана."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "«%(href)s» не ўдалося прачытаць: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "«%(name)s» зменена тут, але пасля зменена на тэлефоне; узята іх версія."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» зменены з абодвух бакоў адначасова; вырашыць наступны запуск."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» зменены з абодвух бакоў, а картка з тэлефона не ўтрымлівае часу: узята версія з тэлефона."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "«%(name)s» зменена на тэлефоне, але пасля зменена тут; захавана наша."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "«%(name)s» не ўдалося ператварыць у сумоўе: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "«%(name)s» не ўдалося ператварыць у сумоўе: яго час немагчыма прачытаць."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "«%(name)s» не з'яўляецца календаром."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "«%(name)s» не з'яўляецца спісам задач."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "«%(name)s» не з'яўляецца адраснай кнігай."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s»: абагулена з вамі толькі для чытання; змяненне на тэлефоне не прыменена."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» перамясціўся на іншы адрас на серверы; сувязь захавана."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "«%(name)s» не зменена паводле карткі: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» выдалены з адраснай кнігі; тут захаваны."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "«%(name)s» прапушчаны: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "«%(name)s»: %(what)s на картцы не былі ўзяты, каб нічога з захаванага тут не страцілася."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "«%(name)s»: нумар, адрас або вэб-адрас на картцы не быў узяты: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "«%(name)s»: электронная пошта на картцы не была ўзята: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: нумар з карткі ўжо належыць іншаму запісу тут, таму яго не ўзялі."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: нумар з карткі не ўзяты."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: вэб-адрас з карткі не з'яўляецца сапраўдным вэб-адрасам, таму яго не ўзялі."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: вэб-адрас з карткі не ўзяты."
