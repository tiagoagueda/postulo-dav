msgstr "\"%(name)s\" wird nur zum Lesen mit Ihnen geteilt; die Änderung am Telefon wurde nicht angewendet."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "\"%(name)s\" wurde auf eine andere Adresse auf dem Server verschoben; immer noch gepaart."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ wurde aus dem Adressbuch entfernt; hier behalten."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
