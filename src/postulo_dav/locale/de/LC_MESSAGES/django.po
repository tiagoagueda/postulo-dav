msgstr ""

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Ein App-Passwort, wo der Server eines anbietet. Wird verschlüsselt gespeichert."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Ein Vorstellungsgespräch wurde auf beiden Seiten gleichzeitig geändert; der nächste Lauf entscheidet."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Ein hier gelöschtes Vorstellungsgespräch wurde seit der letzten Synchronisierung auf dem Telefon geändert. Der Termin blieb im Kalender."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Ein Vorstellungsgespräch wurde im Kalender an eine andere Adresse verschoben; weiterhin verknüpft."

