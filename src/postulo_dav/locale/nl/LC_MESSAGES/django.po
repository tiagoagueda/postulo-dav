#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d afspraken in de agenda zijn niet van Postulo en zijn met rust gelaten."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s op een ander apparaat uit de agenda verwijderd; hier behouden."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(geen bedrijf)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Een contact dat hier is verwijderd was veranderd op de telefoon sinds de laatste synchronisatie. De kaart werd achtergelaten in het adresboek, en komt terug als contact op de volgende run."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adresboek"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Een app-wachtwoord waar de server dat aanbiedt. Versleuteld opgeslagen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Een gesprek is aan beide kanten tegelijk gewijzigd; de volgende ronde beslist."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Een hier verwijderd interview was veranderd aan de telefoon sinds de laatste synchronisatie. Het evenement stond op de kalender."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Agenda"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Geannuleerd in de agenda."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV en CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Hier gewijzigd op %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Hier gewijzigd, maar later op de telefoon gewijzigd; die versie overgenomen."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Op de telefoon gewijzigd op %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Op de telefoon gewijzigd, maar later hier gewijzigd; onze versie behouden."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Adresboek “%(book)s” en agenda “%(calendar)s” gevonden."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Gemaakt op de server door de eerste synchronisatie als het er niet is, tenzij alleen gelezen is. Alleen dit adresboek is aangeraakt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Gemaakt op de server door de eerste synchronisatie als het er niet is, tenzij alleen gelezen is. Alleen deze kalender wordt geraakt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Schrijf nooit naar de server om het adresboek of de agenda te maken. Contacten en interviews komen nog steeds binnen; er gaat niets uit."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http:// het wachtwoord gaat over het netwerk in de duidelijke, en  Gebruik https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Wachtwoord of app-wachtwoord"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Alleen-lezen"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "alleen-lezen"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Lees alleen is aan, dus er wordt niets gemaakt: maak het op de server, of noem er een die er al is."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradres"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Het adresboek is niet op de server."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Het adres moet beginnen met https:// ."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "De agenda ."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "De eerste synchronisatie zal maken wat ontbreekt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "De root van de server, bijv. https://cloud.example.org. Postulo vindt van daaruit de locaties van adresboek en agenda."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Gebruikersnaam"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "“%(name)s” is aan beide kanten tegelijk gewijzigd; de volgende ronde beslist."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” is uit het adresboek verwijderd; hier behouden."
