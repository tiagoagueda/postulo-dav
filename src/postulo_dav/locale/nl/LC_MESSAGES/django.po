msgstr "“%(name)s” is alleen-lezen met je gedeeld; de wijziging op de telefoon is niet toegepast."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "“%(name)s” moved to another address on the server; still paired."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” is uit het adresboek verwijderd; hier behouden."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
