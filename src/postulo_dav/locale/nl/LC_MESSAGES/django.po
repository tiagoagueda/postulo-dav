#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d verzameling gekozen"
msgstr[1] "%(count)d verzamelingen gekozen"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d afspraken in de agenda zijn niet van Postulo en zijn met rust gelaten."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d records zijn gekoppeld aan iets buiten de gekozen verzameling en zijn met rust gelaten."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d records zijn niet verzonden, omdat het verzenden van dat soort is uitgeschakeld."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d taak in de takenlijst is niet van Postulo en is met rust gelaten."
msgstr[1] "%(count)d taken in de takenlijst zijn niet van Postulo en zijn met rust gelaten."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s op een ander apparaat uit de agenda verwijderd; hier behouden."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(geen bedrijf)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(geen titel)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Een kaart kan daar niet van worden gemaakt."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Een contactpersoon die hier is verwijderd, was sinds de laatste synchronisatie op de telefoon gewijzigd. De kaart is in het adresboek gelaten en komt bij de volgende ronde terug als contactpersoon."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Een herinnering is aan beide kanten tegelijk gewijzigd; de volgende run beslist."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Een hier verwijderde herinnering was op de telefoon gewijzigd sinds de laatste synchronisatie. De taak is in de takenlijst gelaten."

#: src/postulo_dav/dav.py
msgid "A request outside the chosen collections was not sent."
msgstr "Een verzoek buiten de gekozen verzamelingen is niet verzonden."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Een taak is aan beide kanten tegelijk gewijzigd; de volgende run beslist."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Een taak is naar een ander adres verplaatst; nog steeds gekoppeld."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "adresboek"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adresboek"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Adresboeken"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Allemaal"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Bewaar ook twee taken per sollicitatie in de takenlijst: een om te solliciteren, waarvan afvinken je een suggestie stuurt, en een om een antwoord te horen, die sluit wanneer de sollicitatie eindigt. Herinneringen over een sollicitatie staan onder de open taak."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Een app-wachtwoord waar de server dat aanbiedt. Versleuteld opgeslagen."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Een gesprek is aan beide kanten tegelijk gewijzigd; de volgende ronde beslist."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Een gesprek dat hier is verwijderd, was sinds de laatste synchronisatie op de telefoon gewijzigd. De afspraak is in de agenda gelaten."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Een gesprek is in de agenda naar een ander adres verplaatst; nog steeds gekoppeld."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Solliciteren op %(role)s bij %(company)s"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "agenda"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Agenda"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Agenda's"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Geannuleerd in de agenda."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV en CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Hier gewijzigd op %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Hier gewijzigd, maar later op de telefoon gewijzigd; die versie overgenomen."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Op de telefoon gewijzigd op %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Op de telefoon gewijzigd, maar later hier gewijzigd; onze versie behouden."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Verzamelingen"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "%(what)s “%(name)s” gevonden (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Het adresboek “%(book)s” (%(book_href)s) en de agenda “%(calendar)s” (%(calendar_href)s) zijn gevonden."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "De takenlijst “%(name)s” (%(href)s) is gevonden."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Uit de kaart “%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Antwoord afwachten van %(company)s over %(role)s"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "het kon hier niet worden opgeslagen"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "het heeft geen tijdzone"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "het is een afspraak voor de hele dag"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "het adres of de identificatiecode is te lang"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "de tijd kan niet gelezen worden"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "de tijdzone “%(zone)s” is hier niet bekend"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Als gesolliciteerd gemarkeerd in de takenlijst"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Er is meer dan één %(what)s gekozen, en een verbinding synchroniseert er één: er is er geen gebruikt. Voeg voor elk een verbinding toe, of laat de andere los."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Meer dan één verzameling heet “%(name)s”. Kies er een via het adres in plaats van via de naam."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nooit naar de server schrijven, ook niet om het adresboek, de agenda of de takenlijst te maken. Contactpersonen, gesprekken en herinneringen komen nog binnen; er gaat niets uit."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Geen"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Geen van de gekozen verzamelingen staat op de server."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Via http:// gaat het wachtwoord onversleuteld over het netwerk, en “%(host)s” is geen adres op uw eigen netwerk. Gebruik https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Wachtwoord of app-wachtwoord"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Druk op Op de server kijken en kies dan één adresboek, één agenda en één takenlijst. Alleen die worden gelezen of beschreven, en een hier ingestelde modus is een woord van Postulo, geen slot van de server: een app-wachtwoord kan niet tot één verzameling worden beperkt. Hele verzamelingen worden gesynchroniseerd."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Lezen en schrijven"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "lezen en schrijven"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Alleen-lezen"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "alleen-lezen"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Alleen-lezen staat aan, dus er wordt niets aangemaakt: maak het aan op de server, of geef er een op die er al is."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Alleen lezen op de server"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Herinneringen zijn niet gesynchroniseerd: de takenlijst kon niet worden gebruikt. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Bedrijven verzenden"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Contactpersonen verzenden"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Mijn eigen kaart verzenden"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveradres"

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "takenlijst"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Takenlijst"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Takenlijsten"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Taken over sollicitaties"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Die kaart is gewijzigd sinds hij werd getoond."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Die kaart staat niet in het gekozen adresboek."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Die taak is gewijzigd sinds hij werd getoond."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Die taak staat niet in de gekozen takenlijst."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Het item %(kind)s is gekoppeld aan een afspraak met een organisator, dus het wordt uit de agenda gelezen en er nooit naartoe geschreven."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "De %(kind)s in de agenda eindigt voordat die begint, en is dus niet verplaatst."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Het adresboek “%(name)s” staat niet op de server."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Het adres moet beginnen met https:// — bijvoorbeeld %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "De agenda “%(name)s” accepteert geen afspraken, dus is niet gebruikt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "De agenda “%(name)s” staat niet op de server."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "De kaart kon niet worden gelezen, dus is niet gewijzigd."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "De kaart heeft geen naam om een bedrijf van te maken."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "De kaart heeft geen naam om een contactpersoon van te maken."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "De verzameling “%(href)s” staat niet meer op de server. Ze is niet opnieuw gemaakt; kies een andere, of laat haar los."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "De eerste synchronisatie maakt aan wat ontbreekt."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "De server antwoordde HTTP %(status)d voor %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "De server laat niet toe te schrijven naar “%(name)s”: alleen lezen."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "De server geeft geen thuismap voor agenda’s op."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "De server geeft geen thuismap voor adresboeken op."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "De server zegt niet waar het %(kind)s-account is."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "De server zegt niet of er geschreven mag worden"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "De server verwees naar een adres buiten zijn eigen adres (%(host)s); dat is niet gevolgd."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "De server heeft %(path)s te vaak omgeleid."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "De server weigerde de gebruikersnaam of het wachtwoord."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "De server wilde geen takenlijst maken, dus hij bewaart mogelijk geen taken."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Het adres van de server, bijvoorbeeld https://cloud.example.org, of het adres van zijn DAV-dienst als die onder een pad staat, bijvoorbeeld https://example.org/dav.php/. Postulo vindt van daaruit de thuismappen van het adresboek en de agenda."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Het antwoord van de server kon niet gelezen worden: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Het antwoord van de server voor %(path)s was te groot of te traag, en werd niet gelezen."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "De taak kon niet worden gelezen, dus is niet gewijzigd."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "De taak voor “%(name)s” is uit de takenlijst verwijderd; de herinnering is behouden."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "De taak heeft geen vervaltijd om een herinnering van te maken."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "De takenlijst “%(name)s” staat niet op de server."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "De taak “%(name)s” heeft geen vervaltijd, dus er is geen herinnering van gemaakt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "De taak “%(name)s” is uit de takenlijst verwijderd; ze wordt niet opnieuw gemaakt."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "De tijd van de %(kind)s in de agenda kon niet worden gebruikt (%(why)s), dus die is niet verplaatst."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "De tijd van de taak “%(name)s” kon niet worden gebruikt (%(why)s), dus de herinnering is niet verplaatst."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Deze verzameling is hier alleen-lezen, dus een %(method)s-verzoek is niet verzonden."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Alleen gebruikt zolang hieronder geen verzameling is gekozen. Een naam of een adres van een agenda; een agenda die er niet is, wordt bij de eerste synchronisatie gemaakt, tenzij alleen-lezen aan staat. De hele agenda wordt gesynchroniseerd, en een naam die twee agenda's delen wordt geweigerd."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Alleen gebruikt zolang hieronder geen verzameling is gekozen. Een naam of een adres van een takenlijst om je herinneringen in te bewaren; leeg betekent dat er geen wordt gebruikt. Een naam die er niet is, wordt bij de eerste synchronisatie gemaakt, tenzij alleen-lezen aan staat. Vereist een server die taken bewaart."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Alleen gebruikt zolang hieronder geen verzameling is gekozen. Een naam of een adres van een adresboek; een adresboek dat er niet is, wordt bij de eerste synchronisatie gemaakt, tenzij alleen-lezen aan staat. Het hele adresboek wordt gesynchroniseerd, en een naam die twee adresboeken delen wordt geweigerd."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Gebruikersnaam"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Welke contactpersonen een kaart in het adresboek krijgen. Kaarten die er al staan blijven, en er wordt niets meer naartoe verzonden zolang dit uit staat."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Schrijf elk bedrijf als een eigen kaart (een bedrijfskaart, met naam en website), gelijk gehouden met het bedrijf."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Schrijf je eigen gegevens naar een eigen kaart, in één richting: een wijziging op de telefoon bereikt je profiel nooit."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "je eigen kaart"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Je eigen kaart is niet verzonden: je profiel heeft geen naam."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Je eigen kaart is uit het adresboek verwijderd; behouden."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "“%(href)s” kon niet worden gelezen: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "“%(name)s” is hier gewijzigd, maar later op de telefoon; die versie is overgenomen."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "“%(name)s” is aan beide kanten tegelijk gewijzigd; de volgende ronde beslist."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "“%(name)s” is aan beide kanten gewijzigd en de kaart van de telefoon vermeldt geen tijd: de versie van de telefoon is overgenomen."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "“%(name)s” is op de telefoon gewijzigd, maar later hier; onze versie is behouden."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "“%(name)s” kon niet tot een gesprek worden gemaakt: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
