#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” ঠিকানা বই থেকে সরানো হয়েছে; এখানে রাখা হয়েছে।"

#: src/postulo_dav/sync.py
#, python-format
