msgstr "“%(name)s” ফোনে বদলেছে, কিন্তু পরে এখানে বদলেছে; আমাদেরটা রাখা হয়েছে।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "“%(name)s” সাক্ষাৎকারে রূপান্তর করা যায়নি: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "“%(name)s” সাক্ষাৎকারে রূপান্তর করা যায়নি: এর সময় পড়া যাচ্ছে না।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "“%(name)s” কোনো ক্যালেন্ডার নয়।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "“%(name)s” কোনো কাজের তালিকা নয়।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "“%(name)s” কোনো ঠিকানা বই নয়।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "“%(name)s” কেবল পড়ার জন্য আপনার সঙ্গে শেয়ার করা; ফোনের পরিবর্তনটি প্রয়োগ করা হয়নি।"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
