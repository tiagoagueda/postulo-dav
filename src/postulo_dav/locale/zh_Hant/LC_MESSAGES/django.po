msgstr "無法使用工作「%(name)s」的時間（%(why)s），因此未移動提醒。"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "此集合在此處為唯讀，因此未傳送 %(method)s 請求。"

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "僅在下方未選擇任何集合時使用。填入行事曆的名稱或位址；不存在的行事曆會在首次同步時建立，除非已開啟唯讀。整個行事曆都會同步，兩個行事曆共用的名稱會被拒絕。"

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "僅在下方未選擇任何集合時使用。填入用來存放提醒的工作清單的名稱或位址；留空則不使用任何工作清單。不存在的名稱會在首次同步時建立，除非已開啟唯讀。需要支援儲存工作的伺服器。"

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "僅在下方未選擇任何集合時使用。填入通訊錄的名稱或位址；不存在的通訊錄會在首次同步時建立，除非已開啟唯讀。整個通訊錄都會同步，兩個通訊錄共用的名稱會被拒絕。"

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "使用者名稱"

