#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "行事曆上有 %(count)d 個活動不是來自 Postulo，已保持原狀。"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s 已在另一部裝置上從行事曆移除；此處仍保留。"

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "（無公司）"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "此處刪除的一位聯絡人，在上次同步後已在手機上變更過。這張名片已留在通訊錄中，下次執行時會重新成為聯絡人。"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "通訊錄"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "伺服器有提供時，請使用應用程式密碼。加密保存。"

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "一場面試在兩邊同時變更；由下次執行決定。"

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "此處刪除的一場面試，在上次同步後已在手機上變更過。該活動已留在行事曆上。"

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "一場面試在行事曆上移到了另一個位址；仍保持配對。"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "行事曆"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "已在行事曆上取消。"

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV 與 CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "於 %(when)s 在此處變更：%(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "在此處變更過，但之後又在手機上變更；已採用手機上的版本。"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "於 %(when)s 在手機上變更：%(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "在手機上變更過，但之後又在此處變更；已保留此處的版本。"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "已找到通訊錄「%(book)s」與行事曆「%(calendar)s」。"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "無法在此處儲存"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "沒有時區"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "這是全天活動"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "其位址或識別碼太長"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "無法讀取其時間"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "此處無法辨識其時區「%(zone)s」"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "若伺服器上沒有，首次同步時會建立，除非已開啟唯讀。只會變動這個通訊錄。"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "若伺服器上沒有，首次同步時會建立，除非已開啟唯讀。只會變動這個行事曆。"

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "絕不寫入伺服器——即使是建立通訊錄或行事曆也不會。聯絡人與面試仍會同步進來；不會送出任何內容。"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "透過 http:// 時，密碼會以明文在網路上傳輸，而「%(host)s」並不是您自己網路上的位址。請使用 https://。"

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "密碼或應用程式密碼"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "唯讀"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "唯讀"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "已開啟唯讀，因此不會建立任何項目：請在伺服器上建立，或指定一個已存在的名稱。"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "伺服器網址"

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "行事曆上的 %(kind)s 結束時間早於開始時間，因此未移動。"

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "伺服器上沒有通訊錄「%(name)s」。"

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "網址必須以 https:// 開頭，例如 %(example)s。"

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "伺服器上沒有行事曆「%(name)s」。"

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "首次同步時會建立缺少的項目。"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "伺服器對 %(method)s %(path)s 回應了 HTTP %(status)d。"

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "伺服器未指定行事曆主目錄。"

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "伺服器未指定通訊錄主目錄。"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "伺服器未說明 %(kind)s 帳號的位置。"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "伺服器指向了其自身以外的位址（%(host)s）；未予追隨。"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "伺服器將 %(path)s 重新導向太多次。"

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "伺服器拒絕了使用者名稱或密碼。"

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "伺服器的網址，例如 https://cloud.example.org；若 DAV 服務位於某個路徑下，則為該服務的網址，例如 https://example.org/dav.php/。Postulo 會從那裡找到通訊錄和行事曆的主目錄。"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "無法讀取伺服器的回應：%(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "伺服器對 %(path)s 的回應太大或太慢，因此未讀取。"

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "無法使用行事曆上 %(kind)s 的時間（%(why)s），因此未移動。"

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "使用者名稱"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "「%(name)s」在兩邊同時變更；由下次執行決定。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "「%(name)s」在兩端都有變更，且來自手機的名片未提供時間：已採用手機上的版本。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "「%(name)s」是以唯讀方式與您共用；手機上的變更未套用。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "「%(name)s」已移到伺服器上的另一個位址；仍保持配對。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "「%(name)s」已從通訊錄移除；此處仍保留。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "已略過「%(name)s」：%(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "「%(name)s」：名片上的號碼已被此處的另一筆紀錄使用，因此未採用。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "「%(name)s」：未採用名片上的號碼。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "「%(name)s」：名片上的網址不是有效的網址，因此未採用。"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "「%(name)s」：未採用名片上的網址。"
