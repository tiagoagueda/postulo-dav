#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "Вибрано колекцій: %(count)d"
msgstr[1] "Вибрано колекцій: %(count)d"
msgstr[2] "Вибрано колекцій: %(count)d"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Подій у календарі, що не з Postulo і залишилися без змін: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "Записів, пов’язаних із чимось поза вибраною колекцією, яких залишено як є: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "Записів, які не надіслано, бо надсилання цього виду вимкнено: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d завдання у списку завдань не з Postulo, його залишено як є."
msgstr[1] "%(count)d завдання у списку завдань не з Postulo, їх залишено як є."
msgstr[2] "%(count)d завдань у списку завдань не з Postulo, їх залишено як є."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s видалено з календаря на іншому пристрої; тут збережено."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s не є однією з резервних копій, які зберігає це призначення, тому її не видалено."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(без компанії)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(без назви)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Картку не можна перетворити на це."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Контакт, видалений тут, було змінено на телефоні після останньої синхронізації. Картку залишено в адресній книзі, і під час наступного запуску вона повернеться як контакт."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Інший файл уже називається %(name)s у папці, і його не перезаписано."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Нагадування змінилося з обох боків одночасно; вирішить наступний запуск."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Нагадування, видалене тут, було змінено на телефоні після останньої синхронізації. Завдання залишено у списку завдань."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Запит поза вибраними колекціями не надіслано."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Завдання змінилося з обох боків одночасно; вирішить наступний запуск."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Завдання перенесено на іншу адресу; воно й далі пов’язане."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "адресна книга"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Адресна книга"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Адресні книги"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "адреси"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Усе в папці, з описовими назвами"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Усі"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Також зберігати у списку завдань по два завдання на кожну заявку: одне, щоб подати заявку, позначення якого надсилає вам пропозицію, і одне, щоб дочекатися відповіді, яке закривається, коли заявка завершується. Нагадування про заявку розташовані під її відкритим завданням."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Записувати в календар також цілі дні зі сторінки «Календар» (терміни подання заявок, дати закриття оголошень і дати, до яких потрібно відповісти на пропозицію) як події на весь день, в один бік: зміна, зроблена на телефоні, перезаписується. Потрібно, щоб екземпляр знав власну адресу."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Пароль застосунку, якщо сервер його пропонує. Зберігається зашифрованим."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Співбесіду змінено з обох боків одночасно; вирішить наступний запуск."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Співбесіду, видалену тут, було змінено на телефоні після останньої синхронізації. Подію залишено в календарі."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Співбесіда перемістилася на іншу адресу в календарі; пару збережено."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Подати заявку на %(role)s у %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "За компанією та посадою, кожна у своїй папці"

