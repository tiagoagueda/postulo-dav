msgstr "Змінено тут %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Змінено тут, але змінено на телефоні пізніше."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
