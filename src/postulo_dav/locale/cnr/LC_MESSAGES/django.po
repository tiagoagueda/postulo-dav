#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ je uklonjeno iz adresara; ovdje je zadržano."

#: src/postulo_dav/sync.py
#, python-format
