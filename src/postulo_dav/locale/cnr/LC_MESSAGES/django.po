#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Koji kontakti dobivaju karticu u adresaru. Kartice koje su već tamo ostaju, a dok je ovo isključeno, njima se ništa više ne šalje."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Zapiši svaku kompaniju kao posebnu karticu (kartica kompanije, s njenim imenom i web stranicom), usklađenu s kompanijom."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Zapiši vaše vlastite podatke na posebnu karticu, samo u jednom smjeru: promjena na telefonu nikad ne dospijeva u vaš profil."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "vaša vlastita kartica"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Vaša vlastita kartica nije poslana: vaš profil nema ime."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Vaša vlastita kartica je uklonjena iz adresara; zadržana je."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s“ se nije moglo pročitati: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s“ je promijenjeno ovdje, ali kasnije i na telefonu; uzeta je njihova verzija."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ je izmijenjeno na obje strane istovremeno; sljedeće pokretanje odlučuje."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ je izmijenjeno na obje strane, a kartica s telefona ne navodi vrijeme: preuzeta je verzija s telefona."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s“ je promijenjeno na telefonu, ali kasnije i ovdje; zadržana je naša verzija."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s“ se nije moglo pretvoriti u intervju: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s“ se nije moglo pretvoriti u intervju: njegovo vrijeme se ne može pročitati."

