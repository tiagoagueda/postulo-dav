#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Ngjarjet në kalendar nuk janë nga Postulo dhe mbetën vetëm."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s u hoq nga kalendari në një dispozitiv tjetër; u mbajt këtu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(pa shoqëri)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Një kontakt i fshirë këtu ishte ndryshuar në telefon që nga sinkroni i fundit. Letra ishte lënë në librin e adresave, dhe kthehet si një kontakt në drejtimin tjetër."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Rubrika"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Një fjalëkalim aplikativi ku serveri ofron një. I koduar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Një intervistë ndryshoi në të dy palët menjëherë; në drejtimin tjetër vendos."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Një intervistë e fshirë këtu ishte ndryshuar në telefon që nga sinkroni i fundit. Ngjarja mbeti në kalendar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalendari"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "U anullua në kalendar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV dhe CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Ndryshuar këtu në [X16XX]: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ndryshoi këtu, por ndryshoi në telefon më vonë; mori të tyren."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ndryshoi telefonin në %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ndryshoi telefonin, por ndryshoi këtu më vonë; mbajti tonin."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Gjeta librin e adresave ♫ %(book)s dhe kalendarin ♫ %(calendar)s."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Është në server nga i pari është nuk j Vetëm kjo rubrikë është prekur."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Është në server nga i pari është nuk j Vetëm ky kalendar është prekur."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Asnjëherë mos shkruaj në server as për rubrikën as për kalendarin. Kontaktet dhe intervistat ende vijnë; asgjë nuk del jashtë."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Mbi http:// fjalëkalimi shkon nëpër rrjet në menyrë të qartë dhe ♫%(host)s nuk është një adresë në rrjetin tuaj. Përdor https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Fjalëkalimi apo fjalëkalimi i aplikativit"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Vetëm në lexim"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "vetëm në lexim"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Është në server emri është."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Adresa e serverit"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Rubrika nuk është në server."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa duhet të nisë me https:// për shembull [X51X51X]."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendari nuk është në server."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Sinkroni i parë do të bëjë atë që mungon."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Root e server-it, e.g. https:// ree.exaple.org. Postulo gjen nga atje rubrikën dhe shtëpitë e kalendarit."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Përdoruesi"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "\"%(name)s kanë ndryshuar në të dy anët njëkohësisht; në garën tjetër vendosin."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "Nga libri i rubrikës u hoq %(name)s; u mbajt këtu."
