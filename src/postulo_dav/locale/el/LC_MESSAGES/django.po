#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d συμβάντα στο ημερολόγιο δεν προέρχονται από το Postulo και έμειναν ως έχουν."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s αφαιρέθηκε από το ημερολόγιο σε άλλη συσκευή· διατηρήθηκε εδώ."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(χωρίς εταιρεία)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Μια επαφή που διαγράφηκε εδώ είχε αλλαχτεί στο τηλέφωνο από τον τελευταίο συγχρονισμό. Η κάρτα ήταν στο βιβλίο διευθύνσεων, και επιστρέφει ως επαφή στην επόμενη διαδρομή."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Βιβλίο διευθύνσεων"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Κωδικός εφαρμογής όπου ο διακομιστής προσφέρει έναν. Αποθηκεύεται κρυπτογραφημένος."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Μια συνέντευξη άλλαξε και στις δύο πλευρές ταυτόχρονα· η επόμενη εκτέλεση αποφασίζει."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Μια συνέντευξη που διαγράφηκε εδώ είχε αλλαχτεί στο τηλέφωνο από τον τελευταίο συγχρονισμό. Το γεγονός έμεινε στο ημερολόγιο."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Ημερολόγιο"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Ακυρώθηκε στο ημερολόγιο."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV και CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Άλλαξε εδώ στις %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Άλλαξε εδώ, αλλά άλλαξε αργότερα στο τηλέφωνο· κρατήθηκε η δική τους εκδοχή."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Άλλαξε στο τηλέφωνο στις %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Άλλαξε στο τηλέφωνο, αλλά άλλαξε αργότερα εδώ· κρατήθηκε η δική μας εκδοχή."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Βρέθηκαν το βιβλίο διευθύνσεων «%(book)s» και το ημερολόγιο «%(calendar)s»."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Κατασκευασμένη στον εξυπηρετητή από τον πρώτο συγχρονισμό αν δεν υπάρχει, εκτός αν είναι ενεργοποιημένη μόνο η ανάγνωση. Μόνο αυτό το βιβλίο διευθύνσεων είναι συγκινημένο."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Κατασκευασμένη στον εξυπηρετητή από τον πρώτο συγχρονισμό αν δεν υπάρχει, εκτός αν είναι ενεργοποιημένη μόνο η ανάγνωση. Μόνο αυτό το ημερολόγιο είναι συγκινημένο."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Ποτέ μην γράψετε στον εξυπηρετητή — ούτε καν για να φτιάξετε το βιβλίο διευθύνσεων ή το ημερολόγιο. Επαφές και συνεντεύξεις έρχονται ακόμα? Τίποτα δεν πηγαίνει έξω."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Πάνω από το http://the password πηγαίνει σε όλο το δίκτυο στο σαφές, και “%(host)s” δεν είναι μια διεύθυνση στο δικό σας δίκτυο. Χρήση https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Κωδικός πρόσβασης ή κωδικός εφαρμογής"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Μόνο ανάγνωση"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "μόνο ανάγνωση"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Το διάβασμα είναι ανοιχτό, οπότε τίποτα δεν γίνεται: δημιουργήστε το στον εξυπηρετητή, ή ονομάστε ένα που είναι ήδη εκεί."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Διεύθυνση διακομιστή"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Το βιβλίο διευθύνσεων “%(name)s” δεν είναι στον εξυπηρετητή."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Η διεύθυνση πρέπει να αρχίζει με το https:// — για παράδειγμα %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Το ημερολόγιο “%(name)s” δεν είναι στον εξυπηρετητή."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Ο πρώτος συγχρονισμός θα κάνει αυτό που λείπει."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Η ρίζα του διακομιστή, π.χ. https://cloud.example.org. Από εκεί το Postulo βρίσκει τις αρχικές τοποθεσίες βιβλίου διευθύνσεων και ημερολογίου."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Όνομα χρήστη"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» άλλαξε και στις δύο πλευρές ταυτόχρονα· η επόμενη εκτέλεση αποφασίζει."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» αφαιρέθηκε από το βιβλίο διευθύνσεων· διατηρήθηκε εδώ."
