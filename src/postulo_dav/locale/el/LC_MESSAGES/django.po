#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d συλλογή επιλέχθηκε"
msgstr[1] "%(count)d συλλογές επιλέχθηκαν"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d συμβάντα στο ημερολόγιο δεν προέρχονται από το Postulo και έμειναν ως έχουν."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d εγγραφές έχουν αντιστοιχιστεί με κάτι εκτός της επιλεγμένης συλλογής και παρέμειναν ως είχαν."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d εγγραφές δεν στάλθηκαν, επειδή η αποστολή αυτού του είδους είναι απενεργοποιημένη."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d εργασία στη λίστα εργασιών δεν προέρχεται από το Postulo και παρέμεινε ως είχε."
msgstr[1] "%(count)d εργασίες στη λίστα εργασιών δεν προέρχονται από το Postulo και παρέμειναν ως είχαν."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: αφαιρέθηκε από το ημερολόγιο σε άλλη συσκευή· διατηρήθηκε εδώ."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "Το %(name)s δεν είναι ένα από τα αντίγραφα ασφαλείας που διατηρεί αυτός ο προορισμός, γι’ αυτό δεν διαγράφηκε."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(χωρίς εταιρεία)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(χωρίς τίτλο)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Μια κάρτα δεν μπορεί να γίνει αυτό."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Μια επαφή που διαγράφηκε εδώ είχε αλλάξει στο τηλέφωνο μετά τον τελευταίο συγχρονισμό. Η κάρτα έμεινε στο βιβλίο διευθύνσεων και θα επιστρέψει ως επαφή στην επόμενη εκτέλεση."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Στον φάκελο υπάρχει ήδη άλλο αρχείο με το όνομα %(name)s και δεν αντικαταστάθηκε."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Μια υπενθύμιση άλλαξε και στις δύο πλευρές ταυτόχρονα· θα αποφασίσει η επόμενη εκτέλεση."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Μια υπενθύμιση που διαγράφηκε εδώ είχε αλλάξει στο τηλέφωνο από τον τελευταίο συγχρονισμό. Η εργασία παρέμεινε στη λίστα εργασιών."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Ένα αίτημα εκτός των επιλεγμένων συλλογών δεν στάλθηκε."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Μια εργασία άλλαξε και στις δύο πλευρές ταυτόχρονα· θα αποφασίσει η επόμενη εκτέλεση."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Μια εργασία μετακινήθηκε σε άλλη διεύθυνση· παραμένει αντιστοιχισμένη."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "βιβλίο διευθύνσεων"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Βιβλίο διευθύνσεων"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Βιβλία διευθύνσεων"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "διευθύνσεις"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Όλα στον φάκελο, με περιγραφικά ονόματα"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Όλα"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Διατήρηση και δύο εργασιών για κάθε αίτηση στη λίστα εργασιών: μία για την υποβολή, που όταν την τσεκάρετε σας στέλνει πρόταση, και μία για την ανταπόκριση, που κλείνει όταν τελειώσει η αίτηση. Οι υπενθυμίσεις για μια αίτηση βρίσκονται κάτω από την ανοιχτή εργασία της."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Εγγραφή στο ημερολόγιο και των ολόκληρων ημερών της σελίδας Ημερολόγιο (προθεσμίες αιτήσεων, ημερομηνίες λήξης αγγελιών και ημερομηνίες έως τις οποίες πρέπει να απαντηθεί μια προσφορά) ως εκδηλώσεις ολόκληρης ημέρας, μόνο προς μία κατεύθυνση: μια αλλαγή που γίνεται στο τηλέφωνο αντικαθίσταται. Απαιτεί η εγκατάσταση να γνωρίζει τη δική της διεύθυνση."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Κωδικός εφαρμογής, όπου ο διακομιστής το προσφέρει. Αποθηκεύεται κρυπτογραφημένος."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Μια συνέντευξη άλλαξε και στις δύο πλευρές ταυτόχρονα· η επόμενη εκτέλεση αποφασίζει."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Μια συνέντευξη που διαγράφηκε εδώ είχε αλλάξει στο τηλέφωνο μετά τον τελευταίο συγχρονισμό. Το συμβάν έμεινε στο ημερολόγιο."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Μια συνέντευξη μεταφέρθηκε σε άλλη διεύθυνση στο ημερολόγιο· η σύζευξη διατηρείται."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Αίτηση για %(role)s στην εταιρεία %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Ανά εταιρεία και ρόλο, καθένα στον δικό του φάκελο"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "ημερολόγιο"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Ημερολόγιο"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Ημερολόγια"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Ακυρώθηκε στο ημερολόγιο."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV και CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Άλλαξε εδώ στις %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Άλλαξε εδώ, αλλά άλλαξε αργότερα στο τηλέφωνο· κρατήθηκε η εκδοχή του τηλεφώνου."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Άλλαξε στο τηλέφωνο στις %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Άλλαξε στο τηλέφωνο, αλλά άλλαξε αργότερα εδώ· κρατήθηκε η εκδοχή του Postulo."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Συλλογές"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Προθεσμίες και ημερομηνίες"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Διεύθυνση φακέλου"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Βρέθηκε το στοιχείο %(what)s «%(name)s» (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Βρέθηκαν το βιβλίο διευθύνσεων «%(book)s» (%(book_href)s) και το ημερολόγιο «%(calendar)s» (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Βρέθηκε η λίστα εργασιών «%(name)s» (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Από την κάρτα «%(name)s»: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Ανταπόκριση από την εταιρεία %(company)s για %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Πώς οργανώνονται τα αρχεία"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "δεν ήταν δυνατή η αποθήκευσή του εδώ"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "δεν έχει ζώνη ώρας"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "είναι ολοήμερο συμβάν"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "η διεύθυνση ή το αναγνωριστικό του είναι πολύ μεγάλο"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "η ώρα του δεν μπορεί να διαβαστεί"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "η ζώνη ώρας του «%(zone)s» δεν είναι γνωστή εδώ"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Σημειώθηκε ως υποβληθείσα στη λίστα εργασιών"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Έχει επιλεγεί περισσότερο από ένα στοιχείο τύπου «%(what)s» και μια σύνδεση συγχρονίζει μόνο ένα: δεν χρησιμοποιήθηκε κανένα. Προσθέστε μια σύνδεση για καθένα ή αφήστε τα υπόλοιπα."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Περισσότερες από μία συλλογές ονομάζονται «%(name)s». Επιλέξτε μία από αυτές με τη διεύθυνσή της αντί για το όνομα."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Να μην γράφεται ποτέ στον διακομιστή, ούτε για τη δημιουργία του βιβλίου διευθύνσεων, του ημερολογίου ή της λίστας εργασιών. Οι επαφές, οι συνεντεύξεις και οι υπενθυμίσεις εξακολουθούν να έρχονται· τίποτα δεν στέλνεται."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Καμία"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Καμία από τις επιλεγμένες συλλογές δεν βρίσκεται στον διακομιστή."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "αριθμοί"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Μέσω http:// ο κωδικός πρόσβασης διασχίζει το δίκτυο χωρίς κρυπτογράφηση, και το «%(host)s» δεν είναι διεύθυνση του δικού σας δικτύου. Χρησιμοποιήστε https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Κωδικός πρόσβασης ή κωδικός εφαρμογής"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Πατήστε Αναζήτηση στον διακομιστή και επιλέξτε ένα βιβλίο διευθύνσεων, ένα ημερολόγιο και μια λίστα εργασιών. Μόνο αυτά διαβάζονται ή γράφονται και μια λειτουργία που ορίζεται εδώ είναι λόγος του Postulo, όχι κλείδωμα του διακομιστή: ένας κωδικός εφαρμογής δεν μπορεί να περιοριστεί σε μία συλλογή. Συγχρονίζονται ολόκληρες συλλογές."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Ανάγνωση και εγγραφή"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "ανάγνωση και εγγραφή"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Μόνο ανάγνωση"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "μόνο ανάγνωση"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Είναι ενεργή η «μόνο ανάγνωση», οπότε δεν δημιουργείται τίποτα: δημιουργήστε το στον διακομιστή ή δώστε το όνομα ενός που υπάρχει ήδη."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Μόνο για ανάγνωση στον διακομιστή"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Οι υπενθυμίσεις δεν συγχρονίστηκαν: η λίστα εργασιών δεν μπόρεσε να χρησιμοποιηθεί. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Αποστολή εταιρειών"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Αποστολή επαφών"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Αποστολή της δικής μου κάρτας"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Διεύθυνση διακομιστή"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Αποθηκεύεται κρυπτογραφημένο. Ανοίγει έναν φάκελο με τα αντίγραφα ασφαλείας όλων των λογαριασμών και η διαγραφή είναι ο τρόπος με τον οποίο αφαιρούνται τα παλιά: χρησιμοποιήστε λογαριασμό που φτάνει μόνο σε αυτόν τον φάκελο, όπως έναν υπολογαριασμό Hetzner Storage Box ή έναν λογαριασμό φτιαγμένο για αντίγραφα ασφαλείας, και τίποτα άλλο."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Αποθηκεύεται κρυπτογραφημένο. Οι περισσότεροι διακομιστές δεν μπορούν να περιορίσουν έναν κωδικό πρόσβασης σε έναν φάκελο· ένα δημόσιο κοινόχρηστο Nextcloud που επιτρέπει μεταφορτώσεις ή ένας υπολογαριασμός Hetzner Storage Box μπορεί."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "λίστα εργασιών"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Λίστα εργασιών"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Λίστες εργασιών"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Εργασίες για αιτήσεις"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Αυτή η κάρτα άλλαξε από τότε που εμφανίστηκε στη λίστα."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Αυτή η κάρτα δεν βρίσκεται στο επιλεγμένο βιβλίο διευθύνσεων."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Αυτή η εργασία άλλαξε από τότε που εμφανίστηκε στη λίστα."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Αυτή η εργασία δεν βρίσκεται στην επιλεγμένη λίστα εργασιών."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Το στοιχείο (%(kind)s) είναι αντιστοιχισμένο με μια εκδήλωση που έχει διοργανωτή, γι' αυτό διαβάζεται από το ημερολόγιο και δεν γράφεται ποτέ σε αυτό."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Το στοιχείο του ημερολογίου (%(kind)s) τελειώνει πριν αρχίσει, οπότε δεν μετακινήθηκε."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Το βιβλίο διευθύνσεων «%(name)s» δεν υπάρχει στον διακομιστή."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Η διεύθυνση πρέπει να αρχίζει με https:// — για παράδειγμα %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Το αντίγραφο ασφαλείας δεν βρίσκεται στον φάκελο μετά τη μεταφόρτωση."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Το ημερολόγιο «%(name)s» δεν δέχεται εκδηλώσεις, γι' αυτό δεν χρησιμοποιήθηκε."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Το ημερολόγιο «%(name)s» δεν υπάρχει στον διακομιστή."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Η κάρτα δεν μπόρεσε να διαβαστεί, γι' αυτό δεν άλλαξε."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Η κάρτα δεν έχει όνομα για να δημιουργηθεί εταιρεία."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Η κάρτα δεν έχει όνομα για να δημιουργηθεί επαφή."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Η συλλογή «%(href)s» δεν υπάρχει πια στον διακομιστή. Δεν δημιουργήθηκε ξανά· επιλέξτε άλλη ή αφήστε την."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Ο πρώτος συγχρονισμός θα δημιουργήσει ό,τι λείπει."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Ο φάκελος %(path)s δεν μπόρεσε να δημιουργηθεί: ο φάκελος από πάνω του δεν υπάρχει."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Ο φάκελος %(path)s δεν υπάρχει στον διακομιστή. Δημιουργήστε τον πρώτα εκεί: το Postulo δεν δημιουργεί τον φάκελο όπου φυλάσσονται τα αντίγραφα ασφαλείας."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Ο φάκελος %(path)s δεν υπάρχει στον διακομιστή. Δημιουργήστε τον πρώτα εκεί: το Postulo δημιουργεί μόνο τους φακέλους κάτω από αυτόν."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Ο φάκελος %(path)s υπάρχει, με %(count)d στοιχεία μέσα του."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Ο φάκελος %(path)s υπάρχει, με %(count)d αντίγραφα ασφαλείας του Postulo μέσα του."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Ο φάκελος έχει χώρο για %(free)s και το αντίγραφο ασφαλείας χρειάζεται %(needed)s, γι’ αυτό δεν στάλθηκε τίποτα."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Ο φάκελος περιέχει %(found)d byte από αυτό και το αντίγραφο ασφαλείας είναι %(size)d: δεν επιβεβαιώθηκε."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Ο φάκελος είναι γεμάτος: ο διακομιστής δεν έχει χώρο για το αρχείο."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Η πλήρης διεύθυνση του φακέλου, ο οποίος πρέπει να υπάρχει. Στο Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Το Postulo δημιουργεί τους φακέλους κάτω από αυτόν όταν τους χρειάζεται και δεν γράφει ποτέ έξω από αυτόν.</folder></user>"

#: src/postulo_dav/backup.py
#, fuzzy
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Η πλήρης διεύθυνση του φακέλου, ο οποίος πρέπει να υπάρχει. Στο Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Χρησιμοποιήστε έναν φάκελο μόνο για τις αρχειοθετήσεις.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Ο διακομιστής απάντησε HTTP %(status)d για %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Ο διακομιστής δεν σας επιτρέπει να γράψετε στο «%(name)s»: μόνο για ανάγνωση."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Ο διακομιστής δεν δηλώνει αρχικό φάκελο ημερολογίων (calendar home)."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Ο διακομιστής δεν δηλώνει αρχικό φάκελο βιβλίων διευθύνσεων (address book home)."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Ο διακομιστής δεν λέει πόσο μεγάλο είναι το αρχείο, γι’ αυτό δεν μπορεί να το επιβεβαιώσει."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Ο διακομιστής δεν αναφέρει πού βρίσκεται ο λογαριασμός %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Ο διακομιστής δεν λέει αν επιτρέπεται η εγγραφή σε αυτήν"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Ο διακομιστής παρέπεμψε σε διεύθυνση εκτός της δικής του (%(host)s)· η παραπομπή δεν ακολουθήθηκε."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Ο διακομιστής ανακατεύθυνε το %(path)s πάρα πολλές φορές."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Ο διακομιστής ανακατεύθυνε μια μεταφόρτωση, κάτι που δεν ακολουθείται."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Ο διακομιστής αρνήθηκε το όνομα χρήστη ή τον κωδικό πρόσβασης."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Ο διακομιστής δεν δημιούργησε λίστα εργασιών, οπότε ίσως δεν διατηρεί εργασίες."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Η διεύθυνση του διακομιστή, π.χ. https://cloud.example.org, ή η διεύθυνση της υπηρεσίας DAV του, αν βρίσκεται σε κάποια διαδρομή, π.χ. https://example.org/dav.php/. Από εκεί το Postulo βρίσκει τους αρχικούς φακέλους του βιβλίου διευθύνσεων και του ημερολογίου."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Δεν ήταν δυνατή η ανάγνωση της απάντησης του διακομιστή: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Η απάντηση του διακομιστή για το %(path)s ήταν πολύ μεγάλη ή πολύ αργή και δεν διαβάστηκε."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Η εργασία δεν μπόρεσε να διαβαστεί, γι' αυτό δεν άλλαξε."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Η εργασία για το «%(name)s» αφαιρέθηκε από τη λίστα εργασιών· η υπενθύμιση διατηρήθηκε."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Η εργασία δεν έχει προθεσμία για να δημιουργηθεί υπενθύμιση."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Η λίστα εργασιών «%(name)s» δεν βρίσκεται στον διακομιστή."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Η εργασία «%(name)s» δεν έχει προθεσμία, γι' αυτό δεν έγινε υπενθύμιση."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Η εργασία «%(name)s» αφαιρέθηκε από τη λίστα εργασιών· δεν δημιουργείται ξανά."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Ο χρόνος για αυτή τη μεταφόρτωση έληξε."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Η ώρα του στοιχείου του ημερολογίου (%(kind)s) δεν ήταν δυνατό να χρησιμοποιηθεί (%(why)s), οπότε δεν μετακινήθηκε."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Η ώρα της εργασίας «%(name)s» δεν μπόρεσε να χρησιμοποιηθεί (%(why)s), γι' αυτό η υπενθύμιση δεν μετακινήθηκε."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Υπάρχει χώρος για ακόμη %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Αυτή η συλλογή είναι εδώ μόνο για ανάγνωση, γι' αυτό δεν στάλθηκε %(method)s."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Πάρα πολλά αρχεία έχουν ήδη το όνομα %(name)s σε αυτόν τον φάκελο."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Χρησιμοποιείται μόνο όσο δεν έχει επιλεγεί συλλογή παρακάτω. Ένα όνομα ή μια διεύθυνση ημερολογίου· αν δεν υπάρχει, δημιουργείται από τον πρώτο συγχρονισμό, εκτός αν είναι ενεργό το «μόνο για ανάγνωση». Συγχρονίζεται ολόκληρο το ημερολόγιο και ένα όνομα που μοιράζονται δύο ημερολόγια απορρίπτεται."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Χρησιμοποιείται μόνο όσο δεν έχει επιλεγεί συλλογή παρακάτω. Ένα όνομα ή μια διεύθυνση λίστας εργασιών για τις υπενθυμίσεις σας· αν μείνει κενό, δεν χρησιμοποιείται καμία. Ένα όνομα που δεν υπάρχει δημιουργείται από τον πρώτο συγχρονισμό, εκτός αν είναι ενεργό το «μόνο για ανάγνωση». Χρειάζεται διακομιστή που διατηρεί εργασίες."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Χρησιμοποιείται μόνο όσο δεν έχει επιλεγεί συλλογή παρακάτω. Ένα όνομα ή μια διεύθυνση βιβλίου διευθύνσεων· αν δεν υπάρχει, δημιουργείται από τον πρώτο συγχρονισμό, εκτός αν είναι ενεργό το «μόνο για ανάγνωση». Συγχρονίζεται ολόκληρο το βιβλίο διευθύνσεων και ένα όνομα που μοιράζονται δύο βιβλία διευθύνσεων απορρίπτεται."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Όνομα χρήστη"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "διευθύνσεις ιστού"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Φάκελος WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Ποιες επαφές αποκτούν κάρτα στο βιβλίο διευθύνσεων. Οι κάρτες που υπάρχουν ήδη παραμένουν και δεν στέλνεται τίποτα άλλο σε αυτές όσο αυτό είναι απενεργοποιημένο."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Εγγραφή κάθε εταιρείας ως ξεχωριστής κάρτας (μια κάρτα εταιρείας, με το όνομα και τον ιστότοπό της), συγχρονισμένης με την εταιρεία."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Εγγραφή των δικών σας στοιχείων σε ξεχωριστή κάρτα, με μία κατεύθυνση: μια αλλαγή στο τηλέφωνο δεν φτάνει ποτέ στο προφίλ σας."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "η δική σας κάρτα"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Η δική σας κάρτα δεν στάλθηκε: το προφίλ σας δεν έχει όνομα."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Η δική σας κάρτα αφαιρέθηκε από το βιβλίο διευθύνσεων· διατηρείται."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "Το «%(href)s» δεν μπόρεσε να διαβαστεί: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "Το «%(name)s» άλλαξε εδώ, αλλά άλλαξε αργότερα στο τηλέφωνο· κρατήθηκε η έκδοσή του."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "Το «%(name)s» άλλαξε και στις δύο πλευρές ταυτόχρονα· η επόμενη εκτέλεση αποφασίζει."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "Το «%(name)s» άλλαξε και στις δύο πλευρές, και η κάρτα από το τηλέφωνο δεν δίνει ώρα αλλαγής: κρατήθηκε η εκδοχή του τηλεφώνου."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "Το «%(name)s» άλλαξε στο τηλέφωνο, αλλά άλλαξε αργότερα εδώ· κρατήθηκε η δική μας."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "Το «%(name)s» δεν μπόρεσε να γίνει συνέντευξη: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "Το «%(name)s» δεν μπόρεσε να γίνει συνέντευξη: η ώρα της δεν μπορεί να διαβαστεί."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "Το «%(name)s» δεν είναι ημερολόγιο."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "Το «%(name)s» δεν είναι λίστα εργασιών."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "Το «%(name)s» δεν είναι βιβλίο διευθύνσεων."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "Το «%(name)s» είναι κοινόχρηστο μαζί σας μόνο για ανάγνωση· η αλλαγή στο τηλέφωνο δεν εφαρμόστηκε."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "Το «%(name)s» μεταφέρθηκε σε άλλη διεύθυνση στον διακομιστή· η σύζευξη διατηρείται."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "Το «%(name)s» δεν άλλαξε από την κάρτα: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "Το «%(name)s» αφαιρέθηκε από το βιβλίο διευθύνσεων· διατηρήθηκε εδώ."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "Το «%(name)s» παραλείφθηκε: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "«%(name)s»: δεν λήφθηκαν από την κάρτα: %(what)s, ώστε να μη χαθεί τίποτα από όσα φυλάσσονται εδώ."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "«%(name)s»: ένας αριθμός, μια διεύθυνση ή μια διεύθυνση ιστού στην κάρτα δεν λήφθηκε: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "«%(name)s»: το email στην κάρτα δεν λήφθηκε: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: ο αριθμός της κάρτας ανήκει ήδη σε άλλη εγγραφή εδώ, οπότε δεν εισήχθη."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: ο αριθμός της κάρτας δεν εισήχθη."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: η διεύθυνση ιστού στην κάρτα δεν είναι έγκυρη διεύθυνση ιστού, οπότε δεν εισήχθη."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: η διεύθυνση ιστού στην κάρτα δεν εισήχθη."
