msgstr "jeho časové pásmo nie je tu známe"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Vyrobené na serveri prvou synchronizáciou, ak tam nie je, pokiaľ nie je len čítanie zapnuté. Iba tento adresár je dojatý."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Vyrobené na serveri prvou synchronizáciou, ak tam nie je, pokiaľ nie je len čítanie zapnuté. Iba tento kalendár je dojatý."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikdy nepíšte na server ani urobiť adresár alebo kalendár. Kontakty a rozhovory stále prichádzajú, nič nevyjde."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Nad http:// heslo prechádza cez sieť v prehľadnom, a  Použite https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Heslo alebo heslo aplikácie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Len na čítanie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "len na čítanie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Čítať je len na, takže nič nie je vyrobené: vytvoriť ho na serveri, alebo meno, ktoré je už tam."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Adresa servera"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s na kalendári končí skôr, než začne, takže to nebolo presunuté."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresár nie je na serveri."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
