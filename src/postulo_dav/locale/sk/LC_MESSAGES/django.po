#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d udalostí v kalendári nepochádza z aplikácie Postulo a zostali nedotknuté."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s odstránené z kalendára na inom zariadení; tu ponechané."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(bez firmy)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt zmazaný tu bol zmenený v telefóne od poslednej synchronizácie. Karta bola ponechaná v adresári, a vracia sa ako kontakt na ďalšie spustenie."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adresár"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Heslo aplikácie tam, kde ho server ponúka. Uložené šifrovane."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Pohovor sa zmenil na oboch stranách naraz; rozhodne ďalší beh."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Tu vymazaný pohovor bol zmenený na telefóne od poslednej synchronizácie. Udalosť bola ponechaná v kalendári."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalendár"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Zrušené v kalendári."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV a CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Zmenené tu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Zmenené tu, ale neskôr zmenené v telefóne; prevzatá ich verzia."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Zmenené v telefóne %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Zmenené v telefóne, ale neskôr zmenené tu; ponechaná naša verzia."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Nájdený adresár „%(book)s“ a kalendár „%(calendar)s“."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Vyrobené na serveri prvou synchronizáciou, ak tam nie je, pokiaľ nie je len čítanie zapnuté. Iba tento adresár je dojatý."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Vyrobené na serveri prvou synchronizáciou, ak tam nie je, pokiaľ nie je len čítanie zapnuté. Iba tento kalendár je dojatý."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikdy nepíšte na server ani urobiť adresár alebo kalendár. Kontakty a rozhovory stále prichádzajú, nič nevyjde."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Nad http:// heslo prechádza cez sieť v prehľadnom, a  Použite https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Heslo alebo heslo aplikácie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Len na čítanie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "len na čítanie"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Čítať je len na, takže nič nie je vyrobené: vytvoriť ho na serveri, alebo meno, ktoré je už tam."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Adresa servera"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresár nie je na serveri."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa musí začať napríklad s %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendár nie je na serveri."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Prvá synchronizácia urobí to, čo chýba."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Koreň servera, napr. https://cloud.example.org. Postulo odtiaľ nájde umiestnenie adresára a kalendára."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Používateľské meno"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ sa zmenil na oboch stranách naraz; rozhodne ďalší beh."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ bol odstránený z adresára; tu ponechaný."
