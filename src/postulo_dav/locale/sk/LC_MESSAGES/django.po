msgid "How files are arranged"
msgstr ""

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "nedalo sa tu uložiť"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nemá časové pásmo"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "je to celodenná udalosť"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "adresa alebo identifikátor je príliš dlhý"

