#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Server odpovedal HTTP %(status)d na %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Server vám nedovolí zapisovať do „%(name)s“: iba na čítanie."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Server neuvádza domovskú kolekciu kalendárov."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Server neuvádza domovskú kolekciu adresárov."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Server neuvádza, kde je účet %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Server neuvádza, či sa doň môže zapisovať"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Server odkázal na adresu mimo vlastnej (%(host)s); odkaz sa nesledoval."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Server presmeroval %(path)s príliš veľakrát."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr ""

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Server odmietol používateľské meno alebo heslo."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Server nechcel vytvoriť zoznam úloh, takže si úlohy nemusí uchovávať."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Adresa servera, napr. https://cloud.example.org, alebo adresa jeho služby DAV, ak beží pod cestou, napr. https://example.org/dav.php/. Postulo odtiaľ nájde domovské kolekcie adresárov a kalendárov."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Odpoveď servera sa nepodarilo prečítať: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Odpoveď servera pre %(path)s bola príliš veľká alebo príliš pomalá a nebola prečítaná."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Úlohu sa nepodarilo prečítať, preto sa nezmenila."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Úloha pre „%(name)s“ bola odstránená zo zoznamu úloh; pripomienka zostala."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Úloha nemá termín, z ktorého by sa dala vytvoriť pripomienka."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Zoznam úloh „%(name)s“ nie je na serveri."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Úloha „%(name)s“ nemá termín, preto sa z nej nevytvorila pripomienka."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Úloha „%(name)s“ bola odstránená zo zoznamu úloh; nevytvorí sa znova."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Čas udalosti typu %(kind)s v kalendári sa nedal použiť (%(why)s), preto sa nepresunula."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Čas úlohy „%(name)s“ sa nepodarilo použiť (%(why)s), preto sa pripomienka nepresunula."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Táto kolekcia je tu iba na čítanie, preto sa požiadavka %(method)s neodoslala."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr ""

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Používa sa, len kým nižšie nie je vybraná žiadna kolekcia. Názov alebo adresa kalendára; ak neexistuje, vytvorí sa pri prvej synchronizácii, pokiaľ nie je zapnuté iba na čítanie. Synchronizuje sa celý kalendár a názov, ktorý majú dva kalendáre spoločný, sa odmietne."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Používa sa, len kým nižšie nie je vybraná žiadna kolekcia. Názov alebo adresa zoznamu úloh, v ktorom sa majú uchovávať vaše pripomienky; ak je prázdne, nepoužije sa žiadny. Názov, ktorý neexistuje, sa vytvorí pri prvej synchronizácii, pokiaľ nie je zapnuté iba na čítanie. Vyžaduje server, ktorý uchováva úlohy."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Používa sa, len kým nižšie nie je vybraná žiadna kolekcia. Názov alebo adresa adresára; ak neexistuje, vytvorí sa pri prvej synchronizácii, pokiaľ nie je zapnuté iba na čítanie. Synchronizuje sa celý adresár a názov, ktorý majú dva adresáre spoločný, sa odmietne."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Používateľské meno"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr ""

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr ""

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Ktoré kontakty dostanú kartu v adresári. Karty, ktoré tam už sú, zostanú a nič ďalšie sa im neposiela, kým je toto vypnuté."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Zapísať každú firmu ako samostatnú kartu (kartu firmy s názvom a webovou stránkou), udržiavanú v súlade s firmou."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Zapísať vaše vlastné údaje do samostatnej karty jednosmerne: zmena na telefóne sa do vášho profilu nikdy nedostane."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "vaša vlastná karta"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Vaša vlastná karta sa neodoslala: váš profil nemá meno."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Vaša vlastná karta bola odstránená z adresára; ponechaná."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s“ sa nepodarilo prečítať: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s“ sa zmenil tu, ale neskôr sa zmenil na telefóne; vzala sa ich verzia."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ – zmenené na oboch stranách naraz; rozhodne ďalší beh."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ – zmenené na oboch stranách a vizitka z telefónu neuvádza čas: prevzatá verzia z telefónu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s“ sa zmenil na telefóne, ale neskôr sa zmenil tu; ponechala sa naša verzia."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s“ sa nepodarilo zmeniť na pohovor: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s“ sa nepodarilo zmeniť na pohovor: čas sa nedá prečítať."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s“ nie je kalendár."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s“ nie je zoznam úloh."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s“ nie je adresár."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s“: zdieľané s vami len na čítanie; zmena z telefónu sa nepoužila."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s“: presunuté na inú adresu na serveri; stále spárované."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s“ sa podľa karty nezmenil: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ – odstránené z adresára; tu ponechané."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "Položka „%(name)s“ bola preskočená: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s“: číslo z vizitky tu už patrí inému záznamu, preto sa neprevzalo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s“: číslo z vizitky sa neprevzalo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s“: webová adresa na vizitke nie je webová adresa, preto sa neprevzala."

