#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d udalostí v kalendári nepochádza z Postulo, preto zostali nedotknuté."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s – odstránené z kalendára na inom zariadení; tu ponechané."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(bez firmy)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt vymazaný tu bol od poslednej synchronizácie zmenený v telefóne. Vizitka zostala v adresári a pri ďalšom behu sa vráti ako kontakt."

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adresár"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Heslo aplikácie, ak ho server ponúka. Ukladá sa zašifrovane."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Pohovor sa zmenil na oboch stranách naraz; rozhodne ďalší beh."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Pohovor vymazaný tu bol od poslednej synchronizácie zmenený v telefóne. Udalosť zostala v kalendári."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Pohovor sa v kalendári presunul na inú adresu; stále je spárovaný."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalendár"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Zrušené v kalendári."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV a CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Zmenené tu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Zmenené tu, ale neskôr zmenené v telefóne; prevzatá ich verzia."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Zmenené v telefóne %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Zmenené v telefóne, ale neskôr zmenené tu; ponechaná naša verzia."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Nájdený adresár „%(book)s“ a kalendár „%(calendar)s“."

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "nedalo sa tu uložiť"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nemá časové pásmo"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "je to celodenná udalosť"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "adresa alebo identifikátor je príliš dlhý"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "čas sa nedá prečítať"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "časové pásmo „%(zone)s“ tu nie je známe"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Ak neexistuje, vytvorí ho na serveri prvá synchronizácia, pokiaľ nie je zapnutý režim len na čítanie. Mení sa iba tento adresár."

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Ak neexistuje, vytvorí ho na serveri prvá synchronizácia, pokiaľ nie je zapnutý režim len na čítanie. Mení sa iba tento kalendár."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikdy nezapisovať na server – ani na vytvorenie adresára či kalendára. Kontakty a pohovory stále prichádzajú; nič neodchádza."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Cez http:// ide heslo sieťou nezašifrované a „%(host)s“ nie je adresa vo vašej vlastnej sieti. Použite https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Heslo alebo heslo aplikácie"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Len na čítanie"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "len na čítanie"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Režim len na čítanie je zapnutý, takže sa nič nevytvorí: vytvorte ho na serveri alebo uveďte taký, ktorý tam už je."

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adresa servera"

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Udalosť typu %(kind)s v kalendári končí skôr, než začína, preto sa nepresunula."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresár „%(name)s“ nie je na serveri."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adresa musí začínať https:// – napríklad %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendár „%(name)s“ nie je na serveri."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Prvá synchronizácia vytvorí, čo chýba."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Server odpovedal HTTP %(status)d na %(method)s %(path)s."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Server neuvádza domovskú kolekciu kalendárov."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Server neuvádza domovskú kolekciu adresárov."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Server neuvádza, kde je účet %(kind)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Server odkázal na adresu mimo vlastnej (%(host)s); odkaz sa nesledoval."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Server presmeroval %(path)s príliš veľakrát."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Server odmietol používateľské meno alebo heslo."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Adresa servera, napr. https://cloud.example.org, alebo adresa jeho služby DAV, ak beží pod cestou, napr. https://example.org/dav.php/. Postulo odtiaľ nájde domovské kolekcie adresárov a kalendárov."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Odpoveď servera sa nepodarilo prečítať: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Odpoveď servera pre %(path)s bola príliš veľká alebo príliš pomalá a nebola prečítaná."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Čas udalosti typu %(kind)s v kalendári sa nedal použiť (%(why)s), preto sa nepresunula."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Používateľské meno"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ – zmenené na oboch stranách naraz; rozhodne ďalší beh."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ – zmenené na oboch stranách a vizitka z telefónu neuvádza čas: prevzatá verzia z telefónu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s“: zdieľané s vami len na čítanie; zmena z telefónu sa nepoužila."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s“: presunuté na inú adresu na serveri; stále spárované."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ – odstránené z adresára; tu ponechané."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "Položka „%(name)s“ bola preskočená: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s“: číslo z vizitky tu už patrí inému záznamu, preto sa neprevzalo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s“: číslo z vizitky sa neprevzalo."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s“: webová adresa na vizitke nie je webová adresa, preto sa neprevzala."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s“: webová adresa z vizitky sa neprevzala."
