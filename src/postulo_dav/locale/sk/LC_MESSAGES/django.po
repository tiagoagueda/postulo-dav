msgstr "Kartu sa nepodarilo prečítať, preto sa nezmenila."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Karta nemá meno, z ktorého by sa dala vytvoriť firma."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Karta nemá meno, z ktorého by sa dal vytvoriť kontakt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Kolekcia „%(href)s“ už nie je na serveri. Nevytvorila sa znova; vyberte inú alebo ju vynechajte."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Prvá synchronizácia vytvorí, čo chýba."

