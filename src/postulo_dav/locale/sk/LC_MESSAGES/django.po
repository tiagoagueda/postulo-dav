#: src/postulo_dav/sync.py
msgid "read only"
msgstr "len na čítanie"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Režim len na čítanie je zapnutý, takže sa nič nevytvorí: vytvorte ho na serveri alebo uveďte taký, ktorý tam už je."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
