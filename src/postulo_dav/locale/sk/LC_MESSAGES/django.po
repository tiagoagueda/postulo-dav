msgstr "kalendár"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalendár"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendáre"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Zrušené v kalendári."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV a CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Zmenené tu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Zmenené tu, ale neskôr zmenené v telefóne; prevzatá ich verzia."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Zmenené v telefóne %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Zmenené v telefóne, ale neskôr zmenené tu; ponechaná naša verzia."

