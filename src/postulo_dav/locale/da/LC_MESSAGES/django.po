msgstr "Fandt adressebogen “%(book)s” og kalenderen “%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "it could not be saved here"
msgstr "det kunne ikke gemmes her"

#: src/postulo_dav/sync.py
#, fuzzy
