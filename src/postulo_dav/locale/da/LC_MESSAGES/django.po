msgstr "\"%(name)s\" er delt med dig at læse kun; ændringen på telefonen blev ikke anvendt."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "\"%(name)s\" flyttet til en anden adresse på serveren; stadig parret."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” blev fjernet fra adressebogen; beholdt her."

