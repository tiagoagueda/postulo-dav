#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d samling valgt"
msgstr[1] "%(count)d samlinger valgt"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d begivenheder i kalenderen er ikke fra Postulo og blev ladt urørt."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d poster er parret med noget uden for den valgte samling og blev ladt urørt."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d poster blev ikke sendt, fordi afsendelse af den slags er slået fra."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d opgave på opgavelisten er ikke fra Postulo og blev ladt urørt."
msgstr[1] "%(count)d opgaver på opgavelisten er ikke fra Postulo og blev ladt urørt."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s fjernet fra kalenderen på en anden enhed; beholdt her."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s er ikke en af de sikkerhedskopier, som denne destination opbevarer, så den blev ikke slettet."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(ingen virksomhed)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(ingen titel)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Et kort kan ikke laves om til det."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt, der blev slettet her, var blevet ændret på telefonen siden sidste synkronisering. Kortet blev efterladt i adressebogen og kommer tilbage som en kontakt ved næste kørsel."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Der er allerede en anden fil med navnet %(name)s i mappen, og den blev ikke overskrevet."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "En påmindelse blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "En påmindelse, der er slettet her, var blevet ændret på telefonen siden sidste synkronisering. Opgaven blev liggende på opgavelisten."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "En anmodning uden for de valgte samlinger blev ikke sendt."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "En opgave blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "En opgave blev flyttet til en anden adresse; den er stadig parret."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "adressebog"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adressebog"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Adressebøger"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adresser"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Alt i mappen, med beskrivende navne"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Alle"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Gem også to opgaver for hver ansøgning på opgavelisten: én til at søge, som afkrydsning sender dig som et forslag, og én til at høre tilbage, som lukkes, når ansøgningen slutter. Påmindelser om en ansøgning ligger under dens åbne opgave."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Skriv også hele dage fra siden Kalender (ansøgningsfrister, lukkedatoer for opslag og datoer, som et tilbud skal besvares inden) til kalenderen som heldagsbegivenheder, kun én vej: en ændring foretaget på telefonen bliver overskrevet. Kræver, at instansen kender sin egen adresse."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "En app-adgangskode, hvor serveren tilbyder en. Gemmes krypteret."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "En samtale blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "En samtale, der blev slettet her, var blevet ændret på telefonen siden sidste synkronisering. Begivenheden blev efterladt i kalenderen."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "En samtale blev flyttet til en anden adresse i kalenderen; stadig parret."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Søg %(role)s hos %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Efter virksomhed og stilling, hver i sin egen mappe"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalender"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendere"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Aflyst i kalenderen."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV og CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Ændret her den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ændret her, men senere ændret på telefonen; deres version blev brugt."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ændret på telefonen den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ændret på telefonen, men senere ændret her; vores version blev beholdt."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Samlinger"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Frister og datoer"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Mappens adresse"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Fandt %(what)s »%(name)s« (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Fandt adressebogen »%(book)s« (%(book_href)s) og kalenderen »%(calendar)s« (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Fandt opgavelisten »%(name)s« (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Fra kortet »%(name)s«: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Hør fra %(company)s om %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Sådan ordnes filerne"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "det kunne ikke gemmes her"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "det har ingen tidszone"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "det er en heldagsbegivenhed"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "dens adresse eller identifikator er for lang"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "dens tidspunkt kan ikke læses"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "dens tidszone »%(zone)s« kendes ikke her"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Markeret som ansøgt på opgavelisten"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Mere end ét element af typen »%(what)s« er valgt, og en forbindelse synkroniserer kun ét: intet blev brugt. Tilføj en forbindelse for hvert, eller lad de andre være."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Mere end én samling hedder »%(name)s«. Vælg en af dem ud fra dens adresse i stedet for navnet."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Skriv aldrig til serveren, heller ikke for at oprette adressebogen, kalenderen eller opgavelisten. Kontakter, samtaler og påmindelser kommer stadig ind; intet går ud."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Ingen"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ingen af de valgte samlinger findes på serveren."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numre"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http:// sendes adgangskoden ukrypteret over netværket, og »%(host)s« er ikke en adresse på dit eget netværk. Brug https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Adgangskode eller app-adgangskode"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Tryk på Søg på serveren, og vælg derefter én adressebog, én kalender og én opgaveliste. Kun dem læses eller skrives der til, og en tilstand, der er sat her, er Postulos ord og ikke serverens lås: en app-adgangskode kan ikke begrænses til én samling. Hele samlinger synkroniseres."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Læse og skrive"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "læse og skrive"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Skrivebeskyttet"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "skrivebeskyttet"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Skrivebeskyttelse er slået til, så intet oprettes: opret den på serveren, eller angiv en, der allerede findes."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Skrivebeskyttet på serveren"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Påmindelser blev ikke synkroniseret: opgavelisten kunne ikke bruges. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Send virksomheder"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Send kontakter"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Send mit eget kort"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveradresse"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Gemmes krypteret. Den åbner en mappe med alle kontoers sikkerhedskopier, og sletning er måden, de gamle fjernes på: brug en konto, der kun når denne mappe, for eksempel en underkonto hos Hetzner Storage Box eller en konto oprettet til sikkerhedskopier, og intet andet."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Gemmes krypteret. De fleste servere kan ikke begrænse en adgangskode til én mappe; en offentlig Nextcloud-deling, der tillader upload, eller en underkonto hos Hetzner Storage Box kan."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "opgaveliste"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Opgaveliste"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Opgavelister"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Opgaver om ansøgninger"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Det kort er ændret, siden det blev vist på listen."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Det kort er ikke i den valgte adressebog."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Den opgave er ændret, siden den blev vist på listen."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Den opgave er ikke på den valgte opgaveliste."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Elementet (%(kind)s) er parret med en begivenhed, der har en arrangør, så det læses fra kalenderen og skrives aldrig til den."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s i kalenderen slutter, før den begynder, så den blev ikke flyttet."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adressebogen »%(name)s« findes ikke på serveren."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adressen skal begynde med https:// — for eksempel %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Sikkerhedskopien er ikke i mappen efter uploaden."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalenderen »%(name)s« tager ikke imod begivenheder, så den blev ikke brugt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenderen »%(name)s« findes ikke på serveren."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kortet kunne ikke læses, så det blev ikke ændret."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kortet har intet navn, som en virksomhed kan laves ud fra."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kortet har intet navn, som en kontakt kan laves ud fra."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Samlingen »%(href)s« findes ikke længere på serveren. Den blev ikke oprettet igen; vælg en anden, eller lad den være."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Den første synkronisering opretter det, der mangler."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Mappen %(path)s kunne ikke oprettes: mappen over den findes ikke."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Mappen %(path)s findes ikke på serveren. Opret den der først: Postulo opretter ikke den mappe, som sikkerhedskopierne opbevares i."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Mappen %(path)s findes ikke på serveren. Opret den der først: Postulo opretter kun mapperne under den."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Mappen %(path)s findes og indeholder %(count)d elementer."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Mappen %(path)s findes og indeholder %(count)d af Postulos sikkerhedskopier."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Mappen har plads til %(free)s, og sikkerhedskopien kræver %(needed)s, så intet blev sendt."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Mappen indeholder %(found)d bytes af den, og sikkerhedskopien er %(size)d: ikke bekræftet."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Mappen er fuld: serveren har ikke plads til filen."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Mappens fulde adresse, som skal findes. På Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo opretter mapperne under den, efterhånden som den har brug for dem, og skriver aldrig uden for den.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Mappens fulde adresse, som skal findes. På Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Brug en mappe kun til arkiverne.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Serveren svarede HTTP %(status)d for %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Serveren tillader ikke, at du skriver til »%(name)s«: skrivebeskyttet."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Serveren angiver ikke en kalenderrod (calendar home)."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Serveren angiver ikke en adressebogsrod (address book home)."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Serveren oplyser ikke, hvor stor filen er, så den kan ikke bekræfte det."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Serveren oplyser ikke, hvor %(kind)s-kontoen er."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Serveren oplyser ikke, om der må skrives til den"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Serveren pegede på en adresse uden for sin egen (%(host)s); den blev ikke fulgt."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Serveren omdirigerede %(path)s for mange gange."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Serveren omdirigerede en upload, hvilket ikke følges."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Serveren afviste brugernavnet eller adgangskoden."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Serveren ville ikke oprette en opgaveliste, så den gemmer måske ikke opgaver."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serverens adresse, f.eks. https://cloud.example.org, eller adressen på dens DAV-tjeneste, hvis den ligger under en sti, f.eks. https://example.org/dav.php/. Postulo finder selv adressebogs- og kalenderrødderne derfra."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serverens svar kunne ikke læses: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serverens svar for %(path)s var for stort eller for langsomt og blev ikke læst."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Opgaven kunne ikke læses, så den blev ikke ændret."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Opgaven for »%(name)s« blev fjernet fra opgavelisten; påmindelsen blev bevaret."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Opgaven har ingen forfaldstid, som en påmindelse kan laves ud fra."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Opgavelisten »%(name)s« findes ikke på serveren."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Opgaven »%(name)s« har ingen forfaldstid, så den blev ikke gjort til en påmindelse."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Opgaven »%(name)s« blev fjernet fra opgavelisten; den oprettes ikke igen."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Tiden til denne upload er udløbet."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Tidspunktet for %(kind)s i kalenderen kunne ikke bruges (%(why)s), så den blev ikke flyttet."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Tidspunktet for opgaven »%(name)s« kunne ikke bruges (%(why)s), så påmindelsen blev ikke flyttet."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Der er plads til %(size)s mere."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Denne samling er skrivebeskyttet her, så en %(method)s blev ikke sendt."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "For mange filer hedder allerede %(name)s i den mappe."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Bruges kun, så længe ingen samling er valgt nedenfor. Et navn eller en adresse på en kalender; hvis den ikke findes, oprettes den ved den første synkronisering, medmindre skrivebeskyttet er slået til. Hele kalenderen synkroniseres, og et navn, som to kalendere deler, afvises."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Bruges kun, så længe ingen samling er valgt nedenfor. Et navn eller en adresse på en opgaveliste, hvor dine påmindelser gemmes; tom, og ingen bruges. Et navn, der ikke findes, oprettes ved den første synkronisering, medmindre skrivebeskyttet er slået til. Kræver en server, der gemmer opgaver."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Bruges kun, så længe ingen samling er valgt nedenfor. Et navn eller en adresse på en adressebog; hvis den ikke findes, oprettes den ved den første synkronisering, medmindre skrivebeskyttet er slået til. Hele adressebogen synkroniseres, og et navn, som to adressebøger deler, afvises."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Brugernavn"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "webadresser"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV-mappe"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Hvilke kontakter der får et kort i adressebogen. Kort, der allerede er der, bliver, og der sendes ikke mere til dem, mens dette er slået fra."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Skriv hver virksomhed som et kort for sig (et virksomhedskort med navn og websted), holdt i trit med virksomheden."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Skriv dine egne oplysninger til et kort for sig, kun én vej: en ændring på telefonen når aldrig din profil."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "dit eget kort"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Dit eget kort blev ikke sendt: din profil har intet navn."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Dit eget kort blev fjernet fra adressebogen; det er bevaret."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "»%(href)s« kunne ikke læses: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "»%(name)s« blev ændret her, men senere ændret på telefonen; deres version blev brugt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "»%(name)s« blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "»%(name)s« blev ændret på begge sider, og kortet fra telefonen angiver intet tidspunkt: telefonens version blev brugt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "»%(name)s« blev ændret på telefonen, men senere ændret her; vores version blev bevaret."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "»%(name)s« kunne ikke laves om til en samtale: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "»%(name)s« kunne ikke laves om til en samtale: tidspunktet kan ikke læses."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "»%(name)s« er ikke en kalender."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "»%(name)s« er ikke en opgaveliste."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "»%(name)s« er ikke en adressebog."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "»%(name)s« er delt med dig som skrivebeskyttet; ændringen på telefonen blev ikke anvendt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "»%(name)s« blev flyttet til en anden adresse på serveren; stadig parret."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "»%(name)s« blev ikke ændret ud fra kortet: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "»%(name)s« blev fjernet fra adressebogen; beholdt her."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "»%(name)s« blev sprunget over: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "»%(name)s«: %(what)s på kortet blev ikke taget med, så intet af det, der er gemt her, går tabt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "»%(name)s«: et nummer, en adresse eller en webadresse på kortet blev ikke taget med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "»%(name)s«: e-mailen på kortet blev ikke taget med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "»%(name)s«: nummeret på kortet bruges allerede af en anden post her, så det blev ikke overtaget."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "»%(name)s«: nummeret på kortet blev ikke overtaget."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "»%(name)s«: webadressen på kortet er ikke en webadresse, så den blev ikke overtaget."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "»%(name)s«: webadressen på kortet blev ikke overtaget."
