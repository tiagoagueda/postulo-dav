msgstr "Ændret her den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ændret her, men ændret på telefonen senere; tog deres."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ændret på telefonen den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ændret på telefonen, men ændret her senere; beholdt vores."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
