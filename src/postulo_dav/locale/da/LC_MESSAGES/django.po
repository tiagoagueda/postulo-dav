msgstr "dens tidszone \"%(zone)s\" er ikke kendt her"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Lavet på serveren af den første synkronisering, hvis det ikke er der, medmindre læse kun er på. Kun denne adressebog er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Lavet på serveren af den første synkronisering, hvis det ikke er der, medmindre læse kun er på. Kun denne kalender er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Skriv aldrig til serveren - ikke engang for at lave adressebogen eller kalenderen. Kontakter og interviews kommer stadig ind."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http: / / password går gennem netværket i det klare, og \"%(host)s\" er ikke en adresse på dit eget netværk. http: / / www.efsa.europa.eu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Adgangskode eller app-adgangskode"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Skrivebeskyttet"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "skrivebeskyttet"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Læs kun er på, så intet er lavet: oprette det på serveren, eller navngiv en, der allerede er der."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradresse"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s på kalenderen slutter før den starter, så den blev ikke flyttet."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adressebogen \"%(name)s\" er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Kommissionen konkluderer derfor, at foranstaltning 3 udgør statsstøtte."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenderen \"%(name)s\" er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Den første synkronisering vil gøre, hvad der mangler."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Serveren svarede HTTP %(status)d for %(method)s %(path)s."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "Serveren nævner ikke et kalenderhjem."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "Serveren nævner ikke en adressebog hjemme."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Serveren siger ikke hvor %(kind)s kontoen er."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Serveren pegede på en adresse udenfor sin egen (%(host)s); den blev ikke fulgt."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Serveren omdirigeret %(path)s for mange gange."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server refused the user name or password."
msgstr "Serveren nægtede brugernavn eller adgangskode."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serverens adresse, f.eks. https: / / cloud.example.org, eller adressen på dets DAV-tjeneste, hvor den bor under en sti, f.eks. https: / / example.org / dav.php /. Postulo finder adressebogen og kalenderboligerne derfra."

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serverens svar kunne ikke læses: %(error)s"

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serverens svar for %(path)s var for stort eller for langsomt, og blev ikke læst."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Tidspunktet for %(kind)s på kalenderen kunne ikke bruges (%(why)s), så det blev ikke flyttet."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Brugernavn"

