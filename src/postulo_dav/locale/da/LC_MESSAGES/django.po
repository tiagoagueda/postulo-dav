#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d begivenheder i kalenderen er ikke fra Postulo og blev ladt urørt."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s fjernet fra kalenderen på en anden enhed; beholdt her."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(ingen virksomhed)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt slettet her var blevet ændret på telefonen siden sidste synkronisering. Kortet blev efterladt i adressebogen, og kommer tilbage som en kontakt på næste løb."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adressebog"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "En app-adgangskode, hvor serveren tilbyder en. Gemmes krypteret."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "En samtale blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Et interview slettet her var blevet ændret på telefonen siden sidste synkronisering. Arrangementet blev efterladt i kalenderen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Aflyst i kalenderen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV og CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Ændret her den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ændret her, men ændret på telefonen senere; tog deres."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ændret på telefonen den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ændret på telefonen, men ændret her senere; beholdt vores."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Fandt adressebogen “%(book)s” og kalenderen “%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Lavet på serveren af den første synkronisering, hvis det ikke er der, medmindre læse kun er på. Kun denne adressebog er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Lavet på serveren af den første synkronisering, hvis det ikke er der, medmindre læse kun er på. Kun denne kalender er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Skriv aldrig til serveren - ikke engang for at lave adressebogen eller kalenderen. Kontakter og interviews kommer stadig ind."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http: / / password går gennem netværket i det klare, og \"%(host)s\" er ikke en adresse på dit eget netværk. http: / / www.efsa.europa.eu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Adgangskode eller app-adgangskode"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Skrivebeskyttet"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "skrivebeskyttet"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Læs kun er på, så intet er lavet: oprette det på serveren, eller navngiv en, der allerede er der."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradresse"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adressebogen \"%(name)s\" er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Kommissionen konkluderer derfor, at foranstaltning 3 udgør statsstøtte."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenderen \"%(name)s\" er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Den første synkronisering vil gøre, hvad der mangler."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Serverens rod, f.eks. https://cloud.example.org. Postulo finder adressebogens og kalenderens hjem derfra."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Brugernavn"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "“%(name)s” blev ændret på begge sider på én gang; næste kørsel afgør det."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” blev fjernet fra adressebogen; beholdt her."
