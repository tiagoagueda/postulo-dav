#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Ставка „%(kind)s“ је упарена са догађајем који има организатора, па се чита из календара и никада се не уписује у њега."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Ставка (%(kind)s) у календару се завршава пре него што почиње, па није премештена."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Адресар „%(name)s“ не постоји на серверу."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Адреса мора почињати са https:// — на пример %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Резервне копије нема у фасцикли након слања."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Календар „%(name)s“ не прима догађаје, па није коришћен."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Календар „%(name)s“ не постоји на серверу."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Картица није могла бити прочитана, па није промењена."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Картица нема име од којег би се направила компанија."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Картица нема име од којег би се направио контакт."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Колекције „%(href)s“ више нема на серверу. Није направљена поново; изаберите другу или је оставите."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Прва синхронизација ће направити оно што недостаје."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Фасцикла %(path)s није могла да се направи: фасцикла изнад ње не постоји."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Фасцикле %(path)s нема на серверу. Прво је направите тамо: Postulo не прави фасциклу у којој се чувају резервне копије."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Фасцикле %(path)s нема на серверу. Прво је направите тамо: Postulo прави само фасцикле испод ње."

#: src/postulo_dav/store.py
#, fuzzy, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Фасцикла %(path)s постоји, у њој је ставки: %(count)d."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Фасцикла %(path)s постоји, у њој је Postulo резервних копија: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Фасцикла има места за %(free)s, а резервној копији треба %(needed)s, па ништа није послато."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Фасцикла садржи %(found)d бајтова копије, а резервна копија има %(size)d: није потврђено."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Фасцикла је пуна: сервер нема места за датотеку."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Пуна адреса фасцикле, која већ мора да постоји. На Nextcloud-у: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo прави фасцикле испод ње по потреби и никада не пише изван ње."

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr "Пуна адреса фасцикле, која већ мора да постоји. На Nextcloud-у: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Користите фасциклу само за архиве."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Сервер је одговорио HTTP %(status)d за %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Сервер вам не дозвољава да пишете у „%(name)s“: само за читање."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Сервер не наводи почетну локацију календара."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Сервер не наводи почетну локацију именика."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Сервер не саопштава колика је датотека, па не може да потврди."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Сервер не наводи где се налази налог за %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Сервер не каже да ли се може писати"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Сервер је упутио на адресу ван своје (%(host)s); није праћена."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Сервер је превише пута преусмерио %(path)s."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Сервер је преусмерио слање, а преусмерење се не прати."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Сервер је одбио корисничко име или лозинку."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Сервер није хтео да направи листу задатака, па можда не чува задатке."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Адреса сервера, нпр. https://cloud.example.org, или адреса његове DAV услуге ако се налази под путањом, нпр. https://example.org/dav.php/. Postulo одатле проналази почетне локације адресара и календара."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Одговор сервера није могао да се прочита: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Одговор сервера за %(path)s био је превелик или преспор, па није прочитан."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Задатак није могао да се прочита, па није промењен."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Задатак за „%(name)s“ је уклоњен са листе задатака; подсетник је задржан."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Задатак нема рок од којег би се направио подсетник."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Листе задатака „%(name)s“ нема на серверу."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Задатак „%(name)s“ нема рок, па није направљен подсетник."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Задатак „%(name)s“ је уклоњен са листе задатака; неће бити направљен поново."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Време за ово слање је истекло."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Време ставке (%(kind)s) у календару није могло да се употреби (%(why)s), па није премештена."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Време задатка „%(name)s“ није могло да се користи (%(why)s), па подсетник није премештен."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Има места за још %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Ова колекција је овде само за читање, па захтев %(method)s није послат."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Превише датотека се већ зове %(name)s у тој фасцикли."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Користи се само док испод није изабрана ниједна колекција. Име или адреса календара; онај који не постоји прва синхронизација прави, осим ако је укључено само за читање. Синхронизује се цео календар, а име које деле два календара се одбија."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Користи се само док испод није изабрана ниједна колекција. Име или адреса листе задатака у којој се чувају ваши подсетници; ако је празно, не користи се ниједна. Име које не постоји прва синхронизација прави, осим ако је укључено само за читање. Потребан је сервер који чува задатке."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Користи се само док испод није изабрана ниједна колекција. Име или адреса адресара; онај који не постоји прва синхронизација прави, осим ако је укључено само за читање. Синхронизује се цео адресар, а име које деле два адресара се одбија."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
