#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "Изабрана је %(count)d колекција"
msgstr[1] "Изабране су %(count)d колекције"
msgstr[2] "Изабрано је %(count)d колекција"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Догађаји у календару који нису из апликације Postulo остављени су нетакнути: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d записа је упарено са нечим ван изабране колекције и остављено је како јесте."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d записа није послато, јер је слање те врсте искључено."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d задатак на листи задатака није из Postulo-а и остављен је како јесте."
msgstr[1] "%(count)d задатка на листи задатака нису из Postulo-а и остављена су како јесу."
msgstr[2] "%(count)d задатака на листи задатака нису из Postulo-а и остављени су како јесу."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: уклоњено из календара на другом уређају; задржано овде."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s није једна од резервних копија које ово одредиште чува, па није обрисана."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(без компаније)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(без наслова)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Картица се не може претворити у то."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Контакт који је овде обрисан био је измењен на телефону после последње синхронизације. Картица је остављена у адресару и при следећем покретању враћа се као контакт."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Друга датотека се већ зове %(name)s у фасцикли и није преписана."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Подсетник је промењен на обе стране истовремено; одлучује следеће покретање."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Подсетник обрисан овде промењен је на телефону од последње синхронизације. Задатак је остављен на листи задатака."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Захтев ван изабраних колекција није послат."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Задатак је промењен на обе стране истовремено; одлучује следеће покретање."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Задатак је премештен на другу адресу; и даље је упарен."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "адресар"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Адресар"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Адресари"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "адресе"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Све у фасцикли, са описним називима"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Све"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Чувај и два задатка за сваку пријаву на листи задатака: један за пријављивање, чије штиклирање вам шаље предлог, и један за одговор, који се затвара када се пријава заврши. Подсетници о пријави стоје испод њеног отвореног задатка."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Уписуј у календар и целе дане са странице Календар (рокове за пријаве, датуме затварања огласа и датуме до којих треба одговорити на понуду) као целодневне догађаје, у једном смеру: измена направљена на телефону се преписује. Захтева да инстанца зна своју адресу."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Лозинка за апликацију, ако је сервер нуди. Чува се шифровано."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Интервју је истовремено измењен на обе стране; одлучиће следеће покретање."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Интервју који је овде обрисан био је измењен на телефону после последње синхронизације. Догађај је остављен у календару."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Разговор за посао је премештен на другу адресу у календару; и даље је упарен."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Пријава за %(role)s у компанији %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "По компанији и улози, свака у својој фасцикли"

