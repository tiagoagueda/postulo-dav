msgstr "Измењено на телефону %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Измењено на телефону, али касније измењено овде; задржана је наша верзија."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Колекције"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Рокови и датуми"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
