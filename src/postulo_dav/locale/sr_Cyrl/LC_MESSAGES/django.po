msgstr "Адреса фасцикле"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Пронађено: %(what)s „%(name)s“ (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Пронађен је адресар „%(book)s“ (%(book_href)s) и календар „%(calendar)s“ (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
