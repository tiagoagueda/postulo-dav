msgstr "Ձեր սեփական քարտը չի ուղարկվել․ ձեր պրոֆիլն անուն չունի։"

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Ձեր սեփական քարտը հեռացվել է հասցեագրքից․ պահպանվել է։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "«%(href)s»-ը հնարավոր չեղավ կարդալ՝ %(error)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "«%(name)s»-ը փոխվել է այստեղ, բայց ավելի ուշ փոխվել է հեռախոսի վրա․ վերցվել է նրանց տարբերակը։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» — միաժամանակ փոփոխվել է երկու կողմում․ կորոշի հաջորդ գործարկումը։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s»-ը փոխվել է երկու կողմում էլ, և հեռախոսից եկած քարտը ժամ չի նշում․ ընդունվեց հեռախոսի տարբերակը։"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "«%(name)s»-ը փոխվել է հեռախոսի վրա, բայց ավելի ուշ փոխվել է այստեղ․ պահպանվել է մեր տարբերակը։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "«%(name)s»-ը հնարավոր չեղավ դարձնել հարցազրույց՝ %(why)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "«%(name)s»-ը հնարավոր չեղավ դարձնել հարցազրույց․ դրա ժամանակը հնարավոր չէ կարդալ։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "«%(name)s»-ը օրացույց չէ։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "«%(name)s»-ը առաջադրանքների ցանկ չէ։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "«%(name)s»-ը հասցեագիրք չէ։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s»-ը ձեզ հետ կիսված է միայն կարդալու համար․ հեռախոսում կատարված փոփոխությունը չկիրառվեց։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s»-ը սերվերում տեղափոխվել է մեկ այլ հասցե․ դեռ զուգակցված է։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "«%(name)s»-ը քարտից չի փոփոխվել՝ %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» կոնտակտը հեռացվել է հասցեագրքից․ այստեղ այն պահվեց։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "«%(name)s»-ը բաց թողնվեց՝ %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr ""

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»․ քարտի համարն այստեղ արդեն պատկանում է մեկ այլ գրառման, ուստի այն չվերցվեց։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»․ քարտի համարը չվերցվեց։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»․ քարտի վեբ հասցեն վեբ հասցե չէ, ուստի այն չվերցվեց։"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»․ քարտի վեբ հասցեն չվերցվեց։"
