#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d कलेक्शन चुना गया"
msgstr[1] "%(count)d कलेक्शन चुने गए"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "कैलेंडर पर %(count)d इवेंट Postulo के नहीं हैं, और उन्हें छुआ नहीं गया।"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d रिकॉर्ड चुने हुए कलेक्शन के बाहर की किसी चीज़ से जुड़े हैं और जैसे थे वैसे छोड़ दिए गए।"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d रिकॉर्ड नहीं भेजे गए, क्योंकि उस प्रकार को भेजना बंद है।"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "टास्क सूची में %(count)d टास्क Postulo का नहीं है और उसे जैसा था वैसा छोड़ दिया गया।"
msgstr[1] "टास्क सूची में %(count)d टास्क Postulo के नहीं हैं और उन्हें जैसा था वैसा छोड़ दिया गया।"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s किसी दूसरे डिवाइस पर कैलेंडर से हटाया गया; यहां रखा गया है।"

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s इस गंतव्य द्वारा रखे गए बैकअप में से नहीं है, इसलिए इसे हटाया नहीं गया।"

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(कोई कंपनी नहीं)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(कोई शीर्षक नहीं)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "कार्ड को वह नहीं बनाया जा सकता।"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "यहां डिलीट किया गया एक संपर्क पिछले सिंक के बाद फ़ोन पर बदला गया था। कार्ड एड्रेस बुक में छोड़ दिया गया, और अगली बार सिंक चलने पर संपर्क के रूप में वापस आ जाएगा।"

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "फ़ोल्डर में %(name)s नाम की एक अलग फ़ाइल पहले से है, और उसे ओवरराइट नहीं किया गया।"

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "एक रिमाइंडर दोनों तरफ़ एक साथ बदला; अगली बार तय होगा।"

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "यहाँ हटाया गया एक रिमाइंडर पिछले सिंक के बाद फ़ोन पर बदला गया था। टास्क को टास्क सूची में रहने दिया गया।"

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "चुने हुए कलेक्शन के बाहर का अनुरोध नहीं भेजा गया।"

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "एक टास्क दोनों तरफ़ एक साथ बदला; अगली बार तय होगा।"

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "एक टास्क दूसरे पते पर चला गया; अब भी जुड़ा हुआ है।"

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "एड्रेस बुक"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "एड्रेस बुक"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "एड्रेस बुक"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "पते"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "सब कुछ फ़ोल्डर में, वर्णनात्मक नामों के साथ"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "सभी"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "टास्क सूची में हर आवेदन के लिए दो टास्क भी रखें: एक आवेदन करने के लिए, जिस पर टिक करने से आपको एक सुझाव भेजा जाता है, और एक जवाब सुनने के लिए, जो आवेदन समाप्त होने पर बंद हो जाता है। किसी आवेदन के रिमाइंडर उसके खुले टास्क के नीचे रहते हैं।"

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "कैलेंडर पेज के पूरे दिन (आवेदन की समय-सीमाएं, विज्ञापनों की समापन तिथियां और वे तिथियां जिनसे पहले किसी ऑफ़र का उत्तर देना है) भी कैलेंडर में पूरे दिन के इवेंट के रूप में लिखें, एकतरफ़ा: फ़ोन पर किया गया बदलाव ओवरराइट हो जाता है। इसके लिए इंस्टेंस को अपना पता मालूम होना चाहिए।"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "ऐप पासवर्ड, अगर सर्वर यह सुविधा देता हो। एन्क्रिप्ट करके रखा जाता है।"

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "एक इंटरव्यू दोनों तरफ़ एक साथ बदला गया; अगली बार सिंक चलने पर तय होगा।"

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "यहां डिलीट किया गया एक इंटरव्यू पिछले सिंक के बाद फ़ोन पर बदला गया था। इवेंट कैलेंडर पर छोड़ दिया गया।"

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "कैलेंडर पर एक इंटरव्यू किसी दूसरे पते पर चला गया; अब भी जुड़ा हुआ है।"

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "%(company)s में %(role)s के लिए आवेदन करें"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "कंपनी और पद के अनुसार, हर एक अपने फ़ोल्डर में"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "कैलेंडर"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "कैलेंडर"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "कैलेंडर"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "कैलेंडर पर रद्द किया गया।"

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV और CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "%(when)s को यहां बदला गया: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "यहां बदला गया, लेकिन बाद में फ़ोन पर भी बदला गया; फ़ोन वाला रखा गया।"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "%(when)s को फ़ोन पर बदला गया: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "फ़ोन पर बदला गया, लेकिन बाद में यहां भी बदला गया; यहां वाला रखा गया।"

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "कलेक्शन"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "समय-सीमाएं और तिथियां"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "फ़ोल्डर का पता"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "मिला: %(what)s “%(name)s” (%(how)s)।"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "एड्रेस बुक “%(book)s” (%(book_href)s) और कैलेंडर “%(calendar)s” (%(calendar_href)s) मिले।"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "टास्क सूची “%(name)s” (%(href)s) मिली।"

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "कार्ड “%(name)s” से: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "%(role)s के बारे में %(company)s से जवाब पाएँ"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "फ़ाइलें कैसे व्यवस्थित हों"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "इसे यहां सेव नहीं किया जा सका"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "इसका कोई समय क्षेत्र नहीं है"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "यह एक ऑल-डे इवेंट है"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "इसका पता या पहचानकर्ता बहुत लंबा है"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "इसका समय नहीं पढ़ा जा सकता"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "इसका समय क्षेत्र “%(zone)s” यहां ज्ञात नहीं है"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "टास्क सूची में आवेदित के रूप में चिह्नित"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "एक से ज़्यादा %(what)s चुने गए हैं, और एक कनेक्शन सिर्फ़ एक को सिंक करता है: किसी का भी उपयोग नहीं हुआ। हर एक के लिए एक कनेक्शन जोड़ें, या बाकी को छोड़ दें।"

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "एक से ज़्यादा कलेक्शन का नाम “%(name)s” है। नाम के बजाय उसके पते से किसी एक को चुनें।"

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "सर्वर पर कभी न लिखें, एड्रेस बुक, कैलेंडर या टास्क सूची बनाने के लिए भी नहीं। संपर्क, इंटरव्यू और रिमाइंडर फिर भी आते हैं; कुछ बाहर नहीं जाता।"

#: src/postulo_dav/sync.py
msgid "None"
msgstr "कोई नहीं"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "चुने हुए कलेक्शन में से कोई भी सर्वर पर नहीं है।"

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "नंबर"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// पर पासवर्ड नेटवर्क पर बिना एन्क्रिप्शन के जाता है, और “%(host)s” आपके अपने नेटवर्क का पता नहीं है। https:// इस्तेमाल करें।"

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "पासवर्ड या ऐप पासवर्ड"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "सर्वर पर खोजें दबाएँ, फिर एक एड्रेस बुक, एक कैलेंडर और एक टास्क सूची चुनें। केवल वही पढ़े या लिखे जाते हैं, और यहाँ तय किया गया मोड Postulo का वचन है, सर्वर का ताला नहीं: ऐप पासवर्ड को किसी एक कलेक्शन तक सीमित नहीं किया जा सकता। पूरे कलेक्शन सिंक होते हैं।"

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "पढ़ना और लिखना"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "पढ़ना और लिखना"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "सिर्फ़ पढ़ने के लिए"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "सिर्फ़ पढ़ने के लिए"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "सिर्फ़ पढ़ने के लिए चालू है, इसलिए कुछ नहीं बनाया जाता: इसे सर्वर पर बनाएं, या किसी ऐसे का नाम दें जो पहले से मौजूद हो।"

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "सर्वर पर सिर्फ़ पढ़ने के लिए"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "रिमाइंडर सिंक नहीं हुए: टास्क सूची का उपयोग नहीं हो सका। %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "कंपनियाँ भेजें"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "संपर्क भेजें"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "मेरा अपना कार्ड भेजें"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "सर्वर का पता"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "एन्क्रिप्टेड रूप में सहेजा जाता है। यह सभी खातों के बैकअप वाला फ़ोल्डर खोलता है, और पुराने बैकअप हटाने का तरीका उन्हें डिलीट करना है: ऐसा खाता इस्तेमाल करें जो केवल इसी फ़ोल्डर तक पहुँचे, जैसे Hetzner Storage Box का सब-अकाउंट या बैकअप के लिए बनाया गया खाता, और कुछ नहीं।"

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "एन्क्रिप्टेड रूप में सहेजा जाता है। ज़्यादातर सर्वर पासवर्ड को एक फ़ोल्डर तक सीमित नहीं कर सकते; अपलोड की अनुमति देने वाला Nextcloud का सार्वजनिक शेयर, या Hetzner Storage Box का सब-अकाउंट ऐसा कर सकता है।"

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "टास्क सूची"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "टास्क सूची"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "टास्क सूचियाँ"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "आवेदनों के बारे में टास्क"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "सूची में दिखने के बाद वह कार्ड बदल गया है।"

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "वह कार्ड चुनी हुई एड्रेस बुक में नहीं है।"

#: src/postulo_dav/sync.py
