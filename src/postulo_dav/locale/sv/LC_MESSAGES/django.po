#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d händelser i kalendern kommer inte från Postulo och lämnades orörda."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s togs bort från kalendern på en annan enhet; behålls här."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(inget företag)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt raderad här hade ändrats på telefonen sedan den sista synkroniseringen. Kortet lämnades i adressboken och kommer tillbaka som en kontakt på nästa körning."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adressbok"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Ett applösenord där servern erbjuder ett. Sparas krypterat."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "En intervju ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "En intervju raderad här hade ändrats på telefonen sedan den sista synkroniseringen. Evenemanget lämnades i kalendern."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Avbokad i kalendern."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV och CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Ändrad här %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ändrad här, men ändrad på telefonen senare; tog deras."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ändrad på telefonen %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ändrad på telefonen, men ändrad här senare; behöll vår."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Hittade adressboken ”%(book)s” och kalendern ”%(calendar)s”."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Gjord på servern vid den första synkroniseringen om den inte finns där, om inte läs bara är på. Endast denna adressbok berörs."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Gjord på servern vid den första synkroniseringen om den inte finns där, om inte läs bara är på. Endast denna kalender berörs."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Skriv aldrig till servern - inte ens för att göra adressboken eller kalendern. Kontakter och intervjuer kommer fortfarande in; ingenting går ut."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Över http:// lösenordet går över nätverket i det klara, och \"%(host)s\" är inte en adress på ditt eget nätverk. Använd https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Lösenord eller applösenord"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Skrivskyddad"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "skrivskyddad"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Läs bara är på, så ingenting görs: skapa den på servern, eller namnge en som redan finns där."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradress"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adressboken \"%(name)s\" är inte på servern."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adressen måste börja med https:// - till exempel %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendern \"%(name)s\" är inte på servern."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Den första synkroniseringen gör det som saknas."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Serverns rot, t.ex. https://cloud.example.org. Postulo hittar adressbokens och kalenderns hem därifrån."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Användarnamn"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "”%(name)s” ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "”%(name)s” togs bort från adressboken; behålls här."
