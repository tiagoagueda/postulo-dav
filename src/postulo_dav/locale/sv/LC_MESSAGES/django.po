#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d samling vald"
msgstr[1] "%(count)d samlingar valda"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d händelser i kalendern kommer inte från Postulo och lämnades orörda."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d poster är kopplade till något utanför den valda samlingen och lämnades orörda."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d poster skickades inte, eftersom det slaget är avstängt för sändning."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d uppgift i uppgiftslistan kommer inte från Postulo och lämnades orörd."
msgstr[1] "%(count)d uppgifter i uppgiftslistan kommer inte från Postulo och lämnades orörda."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s togs bort från kalendern på en annan enhet; behålls här."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s är inte en av de säkerhetskopior som det här målet förvarar, så den raderades inte."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(inget företag)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(ingen titel)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Ett kort kan inte göras om till det."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt som raderades här hade ändrats på telefonen sedan den senaste synkroniseringen. Kortet lämnades kvar i adressboken och kommer tillbaka som en kontakt vid nästa körning."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "En annan fil heter redan %(name)s i mappen och skrevs inte över."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "En påminnelse ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "En påminnelse som raderades här hade ändrats på telefonen sedan senaste synkroniseringen. Uppgiften lämnades kvar i uppgiftslistan."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "En begäran utanför de valda samlingarna skickades inte."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "En uppgift ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "En uppgift flyttades till en annan adress; fortfarande kopplad."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "adressbok"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adressbok"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Adressböcker"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adresser"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Allt i mappen, med beskrivande namn"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Alla"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Behåll också två uppgifter för varje ansökan i uppgiftslistan: en för att ansöka, som när den bockas av skickar dig ett förslag, och en för att få svar, som stängs när ansökan avslutas. Påminnelser om en ansökan ligger under dess öppna uppgift."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Skriv också de hela dagarna på kalendersidan (ansökningsfrister, sista dagar för annonser och datum då ett erbjudande måste besvaras) till kalendern som heldagshändelser, enkelriktat: en ändring som görs på telefonen skrivs över. Kräver att instansen känner till sin egen adress."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Ett applösenord där servern erbjuder ett. Sparas krypterat."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "En intervju ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "En intervju som raderades här hade ändrats på telefonen sedan den senaste synkroniseringen. Händelsen lämnades kvar i kalendern."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "En intervju flyttades till en annan adress i kalendern; fortfarande ihopparad."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Ansök som %(role)s hos %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Efter företag och roll, var och en i sin egen mapp"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalender"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendrar"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Avbokad i kalendern."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV och CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Ändrad här %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Ändrad här, men ändrad på telefonen senare; deras version togs."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Ändrad på telefonen %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Ändrad på telefonen, men ändrad här senare; vår version behölls."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Samlingar"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Frister och datum"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Mappadress"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Hittade %(what)s ”%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Hittade adressboken ”%(book)s” (%(book_href)s) och kalendern ”%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Hittade uppgiftslistan ”%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Från kortet ”%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Få svar från %(company)s om %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Hur filerna ordnas"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "den kunde inte sparas här"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "den har ingen tidszon"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "den är en heldagshändelse"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "dess adress eller identifierare är för lång"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "dess tid kan inte läsas"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "dess tidszon ”%(zone)s” är okänd här"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Markerad som sökt i uppgiftslistan"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Fler än en av slaget %(what)s är vald, och en anslutning synkar bara en: ingen användes. Lägg till en anslutning för var och en, eller släpp de andra."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Fler än en samling heter ”%(name)s”. Välj en av dem med dess adress i stället för med namn."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Skriv aldrig till servern – inte ens för att skapa adressboken, kalendern eller uppgiftslistan. Kontakter, intervjuer och påminnelser kommer fortfarande in; inget går ut."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Ingen"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ingen av de valda samlingarna finns på servern."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "nummer"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Över http:// skickas lösenordet okrypterat över nätverket, och ”%(host)s” är inte en adress i ditt eget nätverk. Använd https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Lösenord eller applösenord"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Tryck på Titta på servern och välj sedan en adressbok, en kalender och en uppgiftslista. Bara de läses eller skrivs, och ett läge som ställs in här är Postulos ord, inte serverns lås: ett applösenord kan inte begränsas till en samling. Hela samlingar synkas."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Läsa och skriva"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "läsa och skriva"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Skrivskyddad"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "skrivskyddad"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Skrivskyddet är på, så ingenting skapas: skapa den på servern, eller ange en som redan finns där."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Skrivskyddad på servern"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Påminnelser synkades inte: uppgiftslistan kunde inte användas. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Skicka företag"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Skicka kontakter"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Skicka mitt eget kort"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveradress"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Lagras krypterat. Den öppnar en mapp med alla kontons säkerhetskopior, och radering är sättet att ta bort gamla: använd en som bara når den här mappen, som ett underkonto i en Hetzner Storage Box eller ett konto skapat för säkerhetskopior, och inget annat."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Lagras krypterat. De flesta servrar kan inte begränsa ett lösenord till en mapp; en offentlig Nextcloud-delning som tillåter uppladdningar, eller ett underkonto i en Hetzner Storage Box, kan det."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "uppgiftslista"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Uppgiftslista"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Uppgiftslistor"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Uppgifter om ansökningar"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Det kortet har ändrats sedan det listades."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Det kortet finns inte i den valda adressboken."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Den uppgiften har ändrats sedan den listades."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Den uppgiften finns inte i den valda uppgiftslistan."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "%(kind)s är kopplad till en händelse som har en arrangör, så den läses från kalendern och skrivs aldrig till den."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s i kalendern slutar innan den börjar, så den flyttades inte."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adressboken ”%(name)s” finns inte på servern."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adressen måste börja med https:// – till exempel %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Säkerhetskopian finns inte i mappen efter uppladdningen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalendern ”%(name)s” tar inte emot händelser, så den användes inte."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendern ”%(name)s” finns inte på servern."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kortet kunde inte läsas, så det ändrades inte."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kortet har inget namn att göra ett företag av."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kortet har inget namn att göra en kontakt av."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Samlingen ”%(href)s” finns inte längre på servern. Den skapades inte på nytt; välj en annan, eller släpp den."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Den första synkroniseringen skapar det som saknas."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Mappen %(path)s kunde inte skapas: mappen ovanför finns inte."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Mappen %(path)s finns inte på servern. Skapa den där först: Postulo skapar inte mappen som säkerhetskopiorna förvaras i."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Mappen %(path)s finns inte på servern. Skapa den där först: Postulo skapar bara mapparna under den."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Mappen %(path)s finns och innehåller %(count)d objekt."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Mappen %(path)s finns och innehåller %(count)d av Postulos säkerhetskopior."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Mappen har plats för %(free)s och säkerhetskopian behöver %(needed)s, så inget skickades."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Mappen innehåller %(found)d byte av den och säkerhetskopian är %(size)d: inte bekräftad."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Mappen är full: servern har inte plats för filen."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Mappens fullständiga adress, som måste finnas. På Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo skapar mapparna under den efter behov och skriver aldrig utanför den.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Mappens fullständiga adress, som måste finnas. På Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Använd en mapp enbart för arkiven.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Servern svarade HTTP %(status)d för %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Servern tillåter inte att du skriver till ”%(name)s”: skrivskyddad."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Servern anger ingen kalenderrot."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Servern anger ingen adressboksrot."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Servern anger inte hur stor filen är, så den kan inte bekräfta."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Servern anger inte var %(kind)s-kontot finns."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Servern anger inte om det går att skriva"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Servern pekade på en adress utanför sin egen (%(host)s); den följdes inte."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Servern omdirigerade %(path)s för många gånger."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Servern omdirigerade en uppladdning, och omdirigeringen följs inte."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Servern nekade användarnamnet eller lösenordet."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Servern ville inte skapa en uppgiftslista, så den kanske inte kan lagra uppgifter."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serverns adress, t.ex. https://cloud.example.org, eller adressen till dess DAV-tjänst där den ligger under en sökväg, t.ex. https://example.org/dav.php/. Postulo hittar adressboks- och kalenderrötterna därifrån."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serverns svar kunde inte läsas: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serverns svar för %(path)s var för stort eller för långsamt, och lästes inte."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Uppgiften kunde inte läsas, så den ändrades inte."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Uppgiften för ”%(name)s” togs bort från uppgiftslistan; påminnelsen behölls."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Uppgiften har ingen förfallotid att göra en påminnelse av."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Uppgiftslistan ”%(name)s” finns inte på servern."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Uppgiften ”%(name)s” har ingen förfallotid, så ingen påminnelse gjordes."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Uppgiften ”%(name)s” togs bort från uppgiftslistan; den skapas inte på nytt."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Tiden för den här uppladdningen gick ut."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Tiden för %(kind)s i kalendern kunde inte användas (%(why)s), så den flyttades inte."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Tiden för uppgiften ”%(name)s” kunde inte användas (%(why)s), så påminnelsen flyttades inte."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Det finns plats för %(size)s till."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Den här samlingen är skrivskyddad här, så en %(method)s skickades inte."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "För många filer heter redan %(name)s i den mappen."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Används bara så länge ingen samling är vald nedan. Ett namn eller en adress till en kalender; en som inte finns skapas vid första synkroniseringen, om inte skrivskyddat är på. Hela kalendern synkas, och ett namn som två kalendrar delar nekas."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Används bara så länge ingen samling är vald nedan. Ett namn eller en adress till en uppgiftslista att förvara dina påminnelser i; tomt betyder att ingen används. Ett namn som inte finns skapas vid första synkroniseringen, om inte skrivskyddat är på. Kräver en server som lagrar uppgifter."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Används bara så länge ingen samling är vald nedan. Ett namn eller en adress till en adressbok; en som inte finns skapas vid första synkroniseringen, om inte skrivskyddat är på. Hela adressboken synkas, och ett namn som två adressböcker delar nekas."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Användarnamn"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "webbadresser"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV-mapp"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Vilka kontakter som får ett kort i adressboken. Kort som redan finns ligger kvar, och inget mer skickas till dem så länge det här är av."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Skriv varje företag som ett eget kort (ett företagskort, med namn och webbplats), hållet i takt med företaget."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Skriv dina egna uppgifter till ett eget kort, enkelriktat: en ändring på telefonen når aldrig din profil."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "ditt eget kort"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Ditt eget kort skickades inte: din profil har inget namn."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Ditt eget kort togs bort från adressboken; behållet."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "”%(href)s” kunde inte läsas: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "”%(name)s” ändrades här, men ändrades senare på telefonen; deras version gällde."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "”%(name)s” ändrades på båda sidor samtidigt; nästa körning avgör."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "”%(name)s” ändrades på båda sidor, och kortet från telefonen anger ingen tid: telefonens version togs."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "”%(name)s” ändrades på telefonen, men ändrades senare här; vår version behölls."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "”%(name)s” kunde inte göras om till en intervju: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "”%(name)s” kunde inte göras om till en intervju: tiden går inte att läsa."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "”%(name)s” är ingen kalender."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "”%(name)s” är ingen uppgiftslista."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "”%(name)s” är ingen adressbok."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "”%(name)s” delas med dig med endast läsbehörighet; ändringen på telefonen tillämpades inte."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "”%(name)s” flyttades till en annan adress på servern; fortfarande ihopparad."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "”%(name)s” ändrades inte utifrån kortet: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "”%(name)s” togs bort från adressboken; behålls här."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "”%(name)s” hoppades över: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "”%(name)s”: %(what)s på kortet togs inte med, så att inget av det som förvaras här går förlorat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "”%(name)s”: ett nummer, en adress eller en webbadress på kortet togs inte med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "”%(name)s”: e-postadressen på kortet togs inte med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "”%(name)s”: numret på kortet används redan av en annan post här, så det togs inte med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "”%(name)s”: numret på kortet togs inte med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "”%(name)s”: webbadressen på kortet är ingen webbadress, så den togs inte med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "”%(name)s”: webbadressen på kortet togs inte med."
