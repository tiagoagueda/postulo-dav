#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d rekaman dipasangkan dengan sesuatu di luar koleksi yang dipilih dan dibiarkan apa adanya."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d rekaman tidak dikirim, karena pengiriman jenis itu dimatikan."

