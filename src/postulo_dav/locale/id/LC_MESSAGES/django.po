msgid "A request outside the chosen collections was not sent."
msgstr "Permintaan di luar koleksi yang dipilih tidak dikirim."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Sebuah tugas berubah di kedua sisi sekaligus; proses berikutnya yang menentukan."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Sebuah tugas dipindahkan ke alamat lain; masih dipasangkan."

