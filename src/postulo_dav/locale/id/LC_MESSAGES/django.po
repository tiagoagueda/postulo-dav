#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d koleksi dipilih"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d acara di kalender bukan dari Postulo dan dibiarkan apa adanya."

