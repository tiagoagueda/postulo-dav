#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "Wybrano %(count)d kolekcję"
msgstr[1] "Wybrano %(count)d kolekcje"
msgstr[2] "Wybrano %(count)d kolekcji"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Wydarzenia w kalendarzu spoza Postulo (%(count)d) pozostawiono bez zmian."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d rekordów jest sparowanych z czymś poza wybraną kolekcją i zostało pominiętych."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d rekordów nie zostało wysłanych, bo wysyłanie tego rodzaju jest wyłączone."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d zadanie na liście zadań nie pochodzi z Postulo i zostało pominięte."
msgstr[1] "%(count)d zadania na liście zadań nie pochodzą z Postulo i zostały pominięte."
msgstr[2] "%(count)d zadań na liście zadań nie pochodzi z Postulo i zostało pominiętych."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: usunięto z kalendarza na innym urządzeniu; zachowano tutaj."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s nie jest jedną z kopii zapasowych przechowywanych w tym miejscu docelowym, więc nie została usunięta."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(brak firmy)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(bez tytułu)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Z wizytówki nie można tego utworzyć."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt usunięty tutaj został od ostatniej synchronizacji zmieniony w telefonie. Wizytówka pozostała w książce adresowej i przy następnej synchronizacji wróci jako kontakt."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Inny plik ma już nazwę %(name)s w folderze i nie został nadpisany."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Przypomnienie zmieniło się jednocześnie po obu stronach; rozstrzygnie następne uruchomienie."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Przypomnienie usunięte tutaj zostało zmienione na telefonie od ostatniej synchronizacji. Zadanie pozostawiono na liście zadań."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Żądanie spoza wybranych kolekcji nie zostało wysłane."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Zadanie zmieniło się jednocześnie po obu stronach; rozstrzygnie następne uruchomienie."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Zadanie zostało przeniesione pod inny adres; nadal jest sparowane."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "książka adresowa"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Książka adresowa"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Książki adresowe"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adresy"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Wszystko w folderze, z opisowymi nazwami"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Wszystkie"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Utrzymuj też dwa zadania dla każdej aplikacji na liście zadań: jedno do złożenia aplikacji, którego odhaczenie wysyła Ci sugestię, i jedno do usłyszenia odpowiedzi, które zamyka się, gdy aplikacja się kończy. Przypomnienia o aplikacji znajdują się pod jej otwartym zadaniem."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Zapisuj też całe dni ze strony Kalendarz (terminy aplikacji, daty zamknięcia ogłoszeń i daty, do których trzeba odpowiedzieć na ofertę) w kalendarzu jako wydarzenia całodniowe, w jedną stronę: zmiana wprowadzona na telefonie zostanie nadpisana. Wymaga, aby instancja znała własny adres."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Hasło aplikacji tam, gdzie serwer je oferuje. Przechowywane w postaci zaszyfrowanej."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Rozmowę zmieniono jednocześnie po obu stronach; rozstrzygnie następna synchronizacja."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Rozmowa usunięta tutaj została od ostatniej synchronizacji zmieniona w telefonie. Wydarzenie pozostawiono w kalendarzu."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Rozmowę przeniesiono pod inny adres w kalendarzu; powiązanie zostało zachowane."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Aplikuj na stanowisko %(role)s w firmie %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Według firmy i stanowiska, każde we własnym folderze"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalendarz"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalendarz"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendarze"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Odwołano w kalendarzu."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV i CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Zmieniono tutaj %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Zmieniono tutaj, ale później zmieniono w telefonie; przyjęto wersję z telefonu."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Zmieniono w telefonie %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Zmieniono w telefonie, ale później zmieniono tutaj; zachowano wersję stąd."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Kolekcje"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Terminy i daty"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Adres folderu"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Znaleziono: %(what)s „%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Znaleziono książkę adresową „%(book)s” (%(book_href)s) i kalendarz „%(calendar)s” (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Znaleziono listę zadań „%(name)s” (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Z wizytówki „%(name)s”: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Czekaj na odpowiedź od firmy %(company)s w sprawie stanowiska %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Jak ułożone są pliki"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "nie udało się go tu zapisać"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nie ma strefy czasowej"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "jest to wydarzenie całodniowe"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "jego adres lub identyfikator jest zbyt długi"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "nie można odczytać jego czasu"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "jego strefa czasowa „%(zone)s” nie jest tutaj znana"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Oznaczono jako złożoną na liście zadań"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Wybrano więcej niż jeden element typu %(what)s, a połączenie synchronizuje jeden: żaden nie został użyty. Dodaj połączenie dla każdego albo zostaw pozostałe."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Więcej niż jedna kolekcja nazywa się „%(name)s”. Wybierz jedną z nich według adresu, a nie nazwy."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nigdy nie zapisuj na serwerze, nawet by utworzyć książkę adresową, kalendarz lub listę zadań. Kontakty, rozmowy i przypomnienia nadal przychodzą; nic nie wychodzi."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Brak"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Żadna z wybranych kolekcji nie jest na serwerze."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numery"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Przez http:// hasło jest przesyłane przez sieć otwartym tekstem, a „%(host)s” nie jest adresem w Twojej własnej sieci. Użyj https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Hasło lub hasło aplikacji"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Naciśnij Szukaj na serwerze, a potem wybierz jedną książkę adresową, jeden kalendarz i jedną listę zadań. Tylko one są odczytywane lub zapisywane, a tryb ustawiony tutaj to słowo Postulo, a nie blokada serwera: hasła aplikacji nie da się zawęzić do jednej kolekcji. Synchronizowane są całe kolekcje."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Odczyt i zapis"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "odczyt i zapis"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Tylko do odczytu"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "tylko do odczytu"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Włączony jest tryb tylko do odczytu, więc nic nie zostanie utworzone: utwórz to na serwerze albo podaj nazwę takiego, który już tam jest."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Tylko do odczytu na serwerze"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Przypomnienia nie zostały zsynchronizowane: nie można było użyć listy zadań. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Wysyłaj firmy"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Wysyłaj kontakty"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Wyślij moją własną wizytówkę"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Adres serwera"

#: src/postulo_dav/backup.py
#, fuzzy
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Przechowywane w postaci zaszyfrowanej. Otwiera folder z kopiami zapasowymi wszystkich kont, a usuwanie jest sposobem pozbywania się starych: użyj takiego, który sięga tylko tego folderu, np. subkonta Hetzner Storage Box lub konta utworzonego do kopii zapasowych, i niczego więcej."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Przechowywane w postaci zaszyfrowanej. Większość serwerów nie potrafi ograniczyć hasła do jednego folderu; potrafi to publiczne udostępnienie Nextcloud zezwalające na przesyłanie lub subkonto Hetzner Storage Box."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "lista zadań"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Lista zadań"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Listy zadań"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Zadania dotyczące aplikacji"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Ta wizytówka zmieniła się od czasu, gdy ją wyświetlono."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Tej wizytówki nie ma w wybranej książce adresowej."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "To zadanie zmieniło się od czasu, gdy je wyświetlono."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Tego zadania nie ma na wybranej liście zadań."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Element „%(kind)s” jest sparowany z wydarzeniem, które ma organizatora, więc jest odczytywany z kalendarza i nigdy do niego nie zapisywany."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s w kalendarzu kończy się, zanim się zacznie, więc termin nie został przeniesiony."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Na serwerze nie ma książki adresowej „%(name)s”."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adres musi zaczynać się od https:// – na przykład %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Po przesłaniu kopii zapasowej nie ma w folderze."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalendarz „%(name)s” nie przyjmuje wydarzeń, więc nie został użyty."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Na serwerze nie ma kalendarza „%(name)s”."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Nie udało się odczytać wizytówki, więc nie została zmieniona."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Wizytówka nie ma nazwy, z której można utworzyć firmę."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Wizytówka nie ma nazwy, z której można utworzyć kontakt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Kolekcji „%(href)s” nie ma już na serwerze. Nie została utworzona ponownie; wybierz inną albo ją zostaw."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Pierwsza synchronizacja utworzy to, czego brakuje."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Nie można utworzyć folderu %(path)s: folder nadrzędny nie istnieje."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Folderu %(path)s nie ma na serwerze. Najpierw utwórz go tam: Postulo nie tworzy folderu, w którym przechowywane są kopie zapasowe."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Folderu %(path)s nie ma na serwerze. Najpierw utwórz go tam: Postulo tworzy tylko foldery pod nim."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Folder %(path)s istnieje i zawiera elementy: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Folder %(path)s istnieje i zawiera kopie zapasowe Postulo: %(count)d."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "W folderze jest miejsce na %(free)s, a kopia zapasowa wymaga %(needed)s, więc nic nie wysłano."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Folder zawiera %(found)d bajtów kopii, a kopia ma %(size)d: niepotwierdzona."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Folder jest pełny: serwer nie ma miejsca na plik."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Pełny adres folderu, który musi istnieć. W Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo tworzy foldery pod nim w miarę potrzeb i nigdy nie zapisuje poza nim.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Pełny adres folderu, który musi istnieć. W Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Użyj folderu wyłącznie na archiwa.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Serwer odpowiedział HTTP %(status)d na %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Serwer nie pozwala zapisywać w „%(name)s”: tylko do odczytu."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Serwer nie podaje katalogu domowego kalendarzy."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Serwer nie podaje katalogu domowego książek adresowych."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Serwer nie podaje rozmiaru pliku, więc nie może go potwierdzić."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Serwer nie podaje, gdzie znajduje się konto %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Serwer nie podaje, czy można do niej zapisywać"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Serwer wskazał adres poza własnym (%(host)s); nie podążono za nim."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Serwer przekierował %(path)s zbyt wiele razy."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Serwer przekierował przesyłanie, a przekierowania nie są śledzone."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Serwer odrzucił nazwę użytkownika lub hasło."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Serwer nie chciał utworzyć listy zadań, więc może nie przechowywać zadań."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Adres serwera, np. https://cloud.example.org, albo adres jego usługi DAV, jeśli znajduje się ona pod ścieżką, np. https://example.org/dav.php/. Na tej podstawie Postulo odnajdzie katalogi domowe książek adresowych i kalendarzy."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Nie udało się odczytać odpowiedzi serwera: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Odpowiedź serwera na %(path)s była zbyt duża lub zbyt powolna i nie została odczytana."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Nie udało się odczytać zadania, więc nie zostało zmienione."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Zadanie dla „%(name)s” zostało usunięte z listy zadań; przypomnienie zachowano."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Zadanie nie ma terminu, z którego można utworzyć przypomnienie."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Listy zadań „%(name)s” nie ma na serwerze."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Zadanie „%(name)s” nie ma terminu, więc nie utworzono z niego przypomnienia."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Zadanie „%(name)s” zostało usunięte z listy zadań; nie zostanie utworzone ponownie."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Czas na to przesyłanie minął."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Czasu w kalendarzu (%(kind)s) nie dało się użyć (%(why)s), więc termin nie został przeniesiony."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Nie można było użyć terminu zadania „%(name)s” (%(why)s), więc przypomnienia nie przesunięto."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Jest miejsce na jeszcze %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Ta kolekcja jest tu tylko do odczytu, więc żądanie %(method)s nie zostało wysłane."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Zbyt wiele plików ma już nazwę %(name)s w tym folderze."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Używane tylko wtedy, gdy poniżej nie wybrano żadnej kolekcji. Nazwa lub adres kalendarza; kalendarz, którego nie ma, zostanie utworzony przy pierwszej synchronizacji, chyba że włączono tryb tylko do odczytu. Synchronizowany jest cały kalendarz, a nazwa wspólna dla dwóch kalendarzy jest odrzucana."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Używane tylko wtedy, gdy poniżej nie wybrano żadnej kolekcji. Nazwa lub adres listy zadań, w której będą przechowywane Twoje przypomnienia; puste oznacza, że żadna nie jest używana. Nazwa, której nie ma, zostanie utworzona przy pierwszej synchronizacji, chyba że włączono tryb tylko do odczytu. Wymaga serwera przechowującego zadania."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Używane tylko wtedy, gdy poniżej nie wybrano żadnej kolekcji. Nazwa lub adres książki adresowej; książka, której nie ma, zostanie utworzona przy pierwszej synchronizacji, chyba że włączono tryb tylko do odczytu. Synchronizowana jest cała książka adresowa, a nazwa wspólna dla dwóch książek adresowych jest odrzucana."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Nazwa użytkownika"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "adresy WWW"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Folder WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Które kontakty dostają wizytówkę w książce adresowej. Wizytówki, które już tam są, zostają, a gdy ta opcja jest wyłączona, nic więcej do nich nie jest wysyłane."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Zapisuj każdą firmę jako osobną wizytówkę (wizytówkę firmy z nazwą i stroną internetową), utrzymywaną w zgodzie z firmą."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Zapisuj swoje dane do osobnej wizytówki, w jedną stronę: zmiana na telefonie nigdy nie trafia do Twojego profilu."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "twoja własna wizytówka"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Twoja własna wizytówka nie została wysłana: Twój profil nie ma nazwy."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Twoja własna wizytówka została usunięta z książki adresowej; zachowano ją."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "Nie udało się odczytać „%(href)s”: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s” zmieniono tutaj, ale później zmieniono na telefonie; wzięto wersję z telefonu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s” zmieniono jednocześnie po obu stronach; rozstrzygnie następna synchronizacja."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s” zmieniono po obu stronach, a wizytówka z telefonu nie podaje czasu zmiany: przyjęto wersję z telefonu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s” zmieniono na telefonie, ale później zmieniono tutaj; zachowano naszą wersję."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "Nie udało się zamienić „%(name)s” w rozmowę: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "Nie udało się zamienić „%(name)s” w rozmowę: nie można odczytać jej terminu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s” nie jest kalendarzem."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s” nie jest listą zadań."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s” nie jest książką adresową."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "Element „%(name)s” jest Ci udostępniony tylko do odczytu; zmiana z telefonu nie została zastosowana."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s”: przeniesiono pod inny adres na serwerze; powiązanie zostało zachowane."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s” nie został zmieniony na podstawie wizytówki: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s” usunięto z książki adresowej; zachowano tutaj."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "Pominięto „%(name)s”: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "„%(name)s”: %(what)s na wizytówce nie zostały pobrane, aby nic z przechowywanych tu danych nie zostało utracone."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "„%(name)s”: numer, adres lub adres WWW na wizytówce nie został pobrany: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "„%(name)s”: e-mail na wizytówce nie został pobrany: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s”: numer z wizytówki jest już przypisany do innego rekordu, więc nie został przejęty."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s”: numeru z wizytówki nie przejęto."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s”: adres internetowy na wizytówce nie jest prawidłowym adresem, więc nie został przejęty."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s”: adresu internetowego z wizytówki nie przejęto."
