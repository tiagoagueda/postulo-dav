msgid "A task changed on both sides at once; next run decides."
msgstr "Ein uppgáva broyttist á báðum síðum samstundis; næsta koyring avgerð."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A task moved to another address; still paired."
msgstr "Ein uppgáva varð flutt til aðra adressu; er enn knýtt."

