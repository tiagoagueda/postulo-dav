msgstr "%(kind)s tikið av kalendaranum á aðrari eind; varðveitt her."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s er ikki eitt av trygdaravritunum, sum henda goymslustaðurin goymir, so tað varð ikki strikað."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(eingin fyritøka)"

#: src/postulo_dav/sync.py
