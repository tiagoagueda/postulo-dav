#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Ambætarin vísti á eina adressu uttanfyri sína egnu (%(host)s); henni varð ikki fylgt."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
