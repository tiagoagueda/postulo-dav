msgid "A card cannot be made into that."
msgstr "Eitt kort kann ikki gerast til hetta."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Ein sambandspersónur, sum varð strikaður her, var broyttur á telefonini síðan seinastu samstilling. Kortið varð latið vera í adressubókini og kemur aftur sum sambandspersónur næstu ferð."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Ein onnur fíla við navninum %(name)s er longu í mappuni, og hon varð ikki yvirskrivað."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Ein áminning broyttist á báðum síðum samstundis; næsta koyring avgerð."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Ein áminning, strikað her, hevði verið broytt á telefonini síðani seinastu samstilling. Uppgávan varð latin vera í uppgávulistanum."

