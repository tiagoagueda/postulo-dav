#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Skriva ongantíð til ambætaran, ikki eitt sinni fyri at gera adressubókina, kalendaran ella uppgávulistan. Sambandspersónar, samrøður og áminningar koma framvegis inn; einki fer út."

#: src/postulo_dav/sync.py
msgid "None"
