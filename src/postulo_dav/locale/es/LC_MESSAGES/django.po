#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d eventos del calendario no son de Postulo y se dejaron como estaban."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s se eliminó del calendario en otro dispositivo; se conserva aquí."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(sin empresa)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Un contacto borrado aquí había sido cambiado en el teléfono desde la última sincronización. La tarjeta se quedó en el libro de direcciones, y vuelve como un contacto en la siguiente carrera."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Libreta de direcciones"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Una contraseña de aplicación si el servidor la ofrece. Se guarda cifrada."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Una entrevista cambió en ambos lados a la vez; la próxima ejecución decide."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Una entrevista borrada aquí había sido cambiada por teléfono desde la última sincronización. El evento quedó en el calendario."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Calendario"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Cancelada en el calendario."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV y CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Cambiado aquí el %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Cambiado aquí, pero cambiado más tarde en el teléfono; se tomó su versión."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Cambiado en el teléfono el %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Cambiado en el teléfono, pero cambiado más tarde aquí; se conservó la nuestra."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Se encontraron la libreta de direcciones «%(book)s» y el calendario «%(calendar)s»."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Hecho en el servidor por la primera sincronización si no está allí, a menos que se lea solamente. Sólo este libro de direcciones está tocado."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Hecho en el servidor por la primera sincronización si no está allí, a menos que se lea solamente. Sólo este calendario está tocado."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nunca escriba al servidor — ni siquiera para hacer el libro de direcciones o el calendario. Los contactos y entrevistas siguen entrando; nada sale."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Sobre http:// la contraseña va a través de la red en la clara, y “%(host)s” no es una dirección en su propia red. Use https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Contraseña o contraseña de aplicación"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Solo lectura"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "solo lectura"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Leer sólo está encendido, por lo que no se hace nada: crearlo en el servidor, o nombrar uno que ya está allí."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Dirección del servidor"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "El libro de direcciones “%(name)s” no está en el servidor."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "La dirección debe comenzar con https://, por ejemplo %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "El calendario “%(name)s” no está en el servidor."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "La primera sincronización hará lo que falta."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "La raíz del servidor, p. ej. https://cloud.example.org. Desde ahí Postulo encuentra las ubicaciones de la libreta de direcciones y del calendario."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Nombre de usuario"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» cambió en ambos lados a la vez; la próxima ejecución decide."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» se eliminó de la libreta de direcciones; se conserva aquí."
