#: src/postulo_dav/sync.py:674
#, python-format, draft
msgid ""
"%(count)d events on the calendar are not from Postulo and were left alone."
msgstr ""
"%(count)d eventos del calendario no son de Postulo y se dejaron como estaban."

#: src/postulo_dav/sync.py:599
#, python-format, draft
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr ""
"%(kind)s se eliminó del calendario en otro dispositivo; se conserva aquí."

#: src/postulo_dav/sync.py:76
#, draft
msgid "(no company)"
msgstr "(sin empresa)"

#: src/postulo_dav/sync.py:91
msgid ""
"A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr ""

#: src/postulo_dav/sync.py:255
#, draft
msgid "Address book"
msgstr "Libreta de direcciones"

#: src/postulo_dav/sync.py:251
#, draft
msgid "An app password where the server offers one. Stored encrypted."
msgstr ""
"Una contraseña de aplicación si el servidor la ofrece. Se guarda cifrada."

#: src/postulo_dav/sync.py:653
#, draft
msgid "An interview changed on both sides at once; next run decides."
msgstr ""
"Una entrevista cambió en ambos lados a la vez; la próxima ejecución decide."

#: src/postulo_dav/sync.py:96
msgid ""
"An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr ""

#: src/postulo_dav/sync.py:267
#, draft
msgid "Calendar"
msgstr "Calendario"

#: src/postulo_dav/sync.py:218
#, draft
msgid "Cancelled on the calendar."
msgstr "Cancelada en el calendario."

#: src/postulo_dav/sync.py:230
#, draft
msgid "CardDAV and CalDAV"
msgstr "CardDAV y CalDAV"

#: src/postulo_dav/sync.py:492
#, python-format, draft
msgid "Changed here on %(when)s: %(text)s"
msgstr "Cambiado aquí el %(when)s: %(text)s"

#: src/postulo_dav/sync.py:627
#, draft
msgid "Changed here, but changed on the phone later; took theirs."
msgstr ""
"Cambiado aquí, pero cambiado más tarde en el teléfono; se tomó su versión."

#: src/postulo_dav/sync.py:478
#, python-format, draft
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Cambiado en el teléfono el %(when)s: %(text)s"

#: src/postulo_dav/sync.py:617
#, draft
msgid "Changed on the phone, but changed here later; kept ours."
msgstr ""
"Cambiado en el teléfono, pero cambiado más tarde aquí; se conservó la nuestra."

#: src/postulo_dav/sync.py:363
#, python-format, draft
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr ""
"Se encontraron la libreta de direcciones «%(book)s» y el calendario «%(calendar)s»."

#: src/postulo_dav/sync.py:259
msgid ""
"Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr ""

#: src/postulo_dav/sync.py:271
msgid ""
"Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr ""

#: src/postulo_dav/sync.py:284
msgid ""
"Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr ""

#: src/postulo_dav/sync.py:330
#, python-format
msgid ""
"Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr ""

#: src/postulo_dav/sync.py:248
#, draft
msgid "Password or app password"
msgstr "Contraseña o contraseña de aplicación"

#: src/postulo_dav/sync.py:279
#, draft
msgid "Read only"
msgstr "Solo lectura"

#: src/postulo_dav/sync.py:298
#, draft
msgid "read only"
msgstr "solo lectura"

#: src/postulo_dav/sync.py:80
msgid ""
"Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr ""

#: src/postulo_dav/sync.py:236
#, draft
msgid "Server address"
msgstr "Dirección del servidor"

#: src/postulo_dav/sync.py:381
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr ""

#: src/postulo_dav/sync.py:322
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr ""

#: src/postulo_dav/sync.py:382
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr ""

#: src/postulo_dav/sync.py:78
msgid "The first sync will make what is missing."
msgstr ""

#: src/postulo_dav/sync.py:239
#, draft
msgid ""
"The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr ""
"La raíz del servidor, p. ej. https://cloud.example.org. Desde ahí Postulo encuentra las ubicaciones de la libreta de direcciones y del calendario."

#: src/postulo_dav/sync.py:245
#, draft
msgid "Username"
msgstr "Nombre de usuario"

#: src/postulo_dav/sync.py:514
#, python-format, draft
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» cambió en ambos lados a la vez; la próxima ejecución decide."

#: src/postulo_dav/sync.py:466
#, python-format, draft
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» se eliminó de la libreta de direcciones; se conserva aquí."
