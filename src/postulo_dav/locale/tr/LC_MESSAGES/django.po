#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(hayır şirket)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Burada silinen bir temas, son senkronizeden beri telefonda değiştirildi. Kart adres kitabında kaldı ve bir sonraki koşuda temas olarak geri döndü."

#: src/postulo_dav/sync.py
#, fuzzy
