#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Eğer orada değilse ilk senkronizasyon tarafından sunucuda yapılır, okumak sadece devam etmez. Sadece bu adres kitabı dokundu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Eğer orada değilse ilk senkronizasyon tarafından sunucuda yapılır, okumak sadece devam etmez. Sadece bu takvime dokundu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Asla sunucuya yazmayın - adres kitabı veya takvim yapmak bile. İletişim ve röportajlar hala geliyor; hiçbir şey dışarı çıkmıyor."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Örneğin, şifre açık ağda geçer ve “%(host)s kendi ağınızda bir adres değildir. https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Şifre veya uygulama şifresi"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Sadece okuyun"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "sadece sadece oku"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Sadece devam ediyor, bu yüzden hiçbir şey yapılmadı: onu sunucuda yaratmak veya zaten orada olan bir isim."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Server adresi"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
