#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d takvimdeki olaylar Postulo'dan değil ve yalnız bırakılmıştı."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
