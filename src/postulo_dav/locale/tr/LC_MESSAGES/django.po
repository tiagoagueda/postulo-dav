msgstr "Sunucunun cevabı okunamadı: %(error)s"

#: src/postulo_dav/dav.py
#, fuzzy, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Sunucunun %(path)s cevabı çok büyük ya da çok yavaştı ve okumuyordu."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
