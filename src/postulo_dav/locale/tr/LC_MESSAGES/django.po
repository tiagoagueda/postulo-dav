#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d takvimdeki olaylar Postulo'dan değil ve yalnız bırakılmıştı."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s başka bir cihazda takvimden kaldırıldı; burada tuttu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(hayır şirket)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Burada silinen bir temas, son senkronizeden beri telefonda değiştirildi. Kart adres kitabında kaldı ve bir sonraki koşuda temas olarak geri döndü."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adres"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Sunucunun bir tane sunduğu bir uygulama şifresi. Storedcrypt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Bir röportaj her iki tarafta da değişti; bir sonraki iş karar verir."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Burada silinen bir röportaj, son senkronizeden beri telefonda değiştirildi. Olay takvimde kaldı."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Takvim"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Takvimde iptal edildi."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV ve CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Burada %(when)s Değişti: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Burada değişti, ancak daha sonra telefonda değişti; onlarınkini aldı."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonda %(when)s Değişti: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonda değiştirildi, ancak daha sonra değişti; bizi tuttu."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Adres kitabını buldum “%(book)s ve takvim “%(calendar)s."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Eğer orada değilse ilk senkronizasyon tarafından sunucuda yapılır, okumak sadece devam etmez. Sadece bu adres kitabı dokundu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Eğer orada değilse ilk senkronizasyon tarafından sunucuda yapılır, okumak sadece devam etmez. Sadece bu takvime dokundu."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Asla sunucuya yazmayın - adres kitabı veya takvim yapmak bile. İletişim ve röportajlar hala geliyor; hiçbir şey dışarı çıkmıyor."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Örneğin, şifre açık ağda geçer ve “%(host)s kendi ağınızda bir adres değildir. https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Şifre veya uygulama şifresi"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Sadece okuyun"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "sadece sadece oku"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Sadece devam ediyor, bu yüzden hiçbir şey yapılmadı: onu sunucuda yaratmak veya zaten orada olan bir isim."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Server adresi"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adres kitabı “%(name)s sunucuda değil."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adres https:// ile başlamalıdır - örneğin %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Takvim “%(name)s sunucuda değil."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "İlk senkronizasyon neyin eksik olduğunu yapacaktır."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Sunucunun kökü, e.g. https://cloud.ör.org. Postulo, adres kitabı ve takvim evlerini oradan bulur."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Username"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "%(name)s” her iki tarafta da değişti; bir sonraki iş karar verir."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "%(name)s” adres kitabından kaldırıldı; burada tuttu."
