#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d koleksiyon seçildi"
msgstr[1] "%(count)d koleksiyon seçildi"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Takvimdeki %(count)d etkinlik Postulo'dan gelmiyor, bu yüzden onlara dokunulmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d kayıt, seçilen koleksiyonun dışındaki bir şeyle eşleşmiş durumda ve olduğu gibi bırakıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d kayıt gönderilmedi, çünkü o türün gönderilmesi kapalı."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "Görev listesindeki %(count)d görev Postulo’dan değil ve olduğu gibi bırakıldı."
msgstr[1] "Görev listesindeki %(count)d görev Postulo’dan değil ve olduğu gibi bırakıldı."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s başka bir cihazda takvimden kaldırıldı; burada saklandı."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s bu hedefin sakladığı yedeklerden biri değil, bu yüzden silinmedi."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(şirket yok)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(başlıksız)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Bir kart buna dönüştürülemez."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Burada silinen bir kişi, son eşitlemeden bu yana telefonda değiştirilmişti. Kart adres defterinde bırakıldı ve bir sonraki çalıştırmada kişi olarak geri gelir."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Klasörde %(name)s adında başka bir dosya zaten var ve üzerine yazılmadı."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Bir hatırlatma iki tarafta aynı anda değişti; bir sonraki çalıştırma karar verir."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Burada silinen bir hatırlatma, son eşitlemeden sonra telefonda değiştirilmişti. Görev, görev listesinde bırakıldı."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Seçilen koleksiyonların dışındaki bir istek gönderilmedi."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Bir görev iki tarafta aynı anda değişti; bir sonraki çalıştırma karar verir."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Bir görev başka bir adrese taşındı; hâlâ eşleşmiş durumda."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "adres defteri"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adres defteri"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Adres defterleri"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adresler"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Hepsi klasörde, açıklayıcı adlarla"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Hepsi"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Görev listesinde her başvuru için ayrıca iki görev tutun: biri başvurmak için, işaretlenmesi size bir öneri gönderir; diğeri yanıt almak için, başvuru bittiğinde kapanır. Bir başvuruyla ilgili hatırlatmalar açık görevinin altında yer alır."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Takvim sayfasındaki tam günleri de (başvuru son tarihleri, ilanların kapanış tarihleri ve bir teklifin yanıtlanması gereken tarihler) takvime tüm gün etkinlikleri olarak, tek yönlü yaz: telefonda yapılan bir değişikliğin üzerine yazılır. Örneğin kendi adresini bilmesini gerektirir."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Sunucu sunuyorsa bir uygulama parolası. Şifrelenmiş olarak saklanır."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Bir görüşme iki tarafta aynı anda değişti; bir sonraki çalıştırma karar verecek."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Burada silinen bir görüşme, son eşitlemeden bu yana telefonda değiştirilmişti. Etkinlik takvimde bırakıldı."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Bir görüşme takvimde başka bir adrese taşındı; eşleşmesi sürüyor."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "%(company)s şirketinde %(role)s için başvur"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Şirkete ve role göre, her biri kendi klasöründe"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "takvim"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Takvim"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Takvimler"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Takvimde iptal edildi."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV ve CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Burada %(when)s tarihinde değişti: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Burada değişti, ama sonra telefonda da değişti; telefondaki alındı."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonda %(when)s tarihinde değişti: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonda değişti, ama sonra burada da değişti; buradaki korundu."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Koleksiyonlar"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Son tarihler ve tarihler"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Klasör adresi"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "%(what)s bulundu: “%(name)s” (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "“%(book)s” adres defteri (%(book_href)s) ile “%(calendar)s” takvimi (%(calendar_href)s) bulundu."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "“%(name)s” görev listesi bulundu (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "“%(name)s” kartından: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "%(company)s şirketinden %(role)s hakkında yanıt al"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Dosyaların düzenlenme biçimi"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "burada kaydedilemedi"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "saat dilimi yok"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "tüm gün süren bir etkinlik"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "adresi ya da tanımlayıcısı çok uzun"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "saati okunamıyor"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "“%(zone)s” saat dilimi burada bilinmiyor"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Görev listesinde başvuruldu olarak işaretlendi"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Birden fazla %(what)s seçili ve bir bağlantı yalnızca birini eşitler: hiçbiri kullanılmadı. Her biri için bir bağlantı ekleyin ya da diğerlerini bırakın."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Birden fazla koleksiyonun adı “%(name)s”. Adı yerine adresiyle bunlardan birini seçin."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Sunucuya asla yazma — adres defterini, takvimi veya görev listesini oluşturmak için bile. Kişiler, görüşmeler ve hatırlatmalar yine gelir; hiçbir şey dışarı gitmez."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Yok"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Seçilen koleksiyonların hiçbiri sunucuda yok."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numaralar"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// üzerinden parola ağda açık olarak iletilir ve “%(host)s” kendi ağınızdaki bir adres değil. https:// kullanın."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Parola ya da uygulama parolası"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Sunucuda ara düğmesine basın, sonra bir adres defteri, bir takvim ve bir görev listesi seçin. Yalnızca bunlar okunur veya yazılır; burada ayarlanan kip sunucunun kilidi değil, Postulo’nun sözüdür: bir uygulama parolası tek bir koleksiyonla sınırlanamaz. Koleksiyonların tamamı eşitlenir."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Okuma ve yazma"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "okuma ve yazma"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Salt okunur"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "salt okunur"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Salt okunur açık, bu yüzden hiçbir şey oluşturulmaz: onu sunucuda oluşturun ya da orada zaten var olan birinin adını verin."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Sunucuda salt okunur"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Hatırlatmalar eşitlenmedi: görev listesi kullanılamadı. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Şirketleri gönder"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Kişileri gönder"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Kendi kartımı gönder"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Sunucu adresi"

#: src/postulo_dav/backup.py
#, fuzzy
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Şifreli saklanır. Tüm hesapların yedeklerinin bulunduğu bir klasörü açar ve eskileri kaldırmanın yolu silmektir: yalnızca bu klasöre ulaşan birini kullanın; örneğin bir Hetzner Storage Box alt hesabı ya da yedekler için oluşturulmuş bir hesap, başka hiçbir şey değil."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Şifreli saklanır. Çoğu sunucu bir parolayı tek bir klasörle sınırlayamaz; yüklemeye izin veren herkese açık bir Nextcloud paylaşımı ya da bir Hetzner Storage Box alt hesabı sınırlayabilir."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "görev listesi"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Görev listesi"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Görev listeleri"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Başvurularla ilgili görevler"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Bu kart listelendiğinden beri değişti."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Bu kart seçilen adres defterinde değil."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Bu görev listelendiğinden beri değişti."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Bu görev seçilen görev listesinde değil."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "%(kind)s, düzenleyicisi olan bir etkinlikle eşleşmiş; bu yüzden takvimden okunur ve takvime asla yazılmaz."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Takvimdeki %(kind)s başlamadan önce bitiyor, bu yüzden taşınmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "“%(name)s” adres defteri sunucuda yok."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adres https:// ile başlamalıdır — örneğin %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Yedek, yüklemeden sonra klasörde değil."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "“%(name)s” takvimi etkinlik kabul etmiyor, bu yüzden kullanılmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "“%(name)s” takvimi sunucuda yok."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kart okunamadı, bu yüzden değiştirilmedi."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kartta şirket oluşturmak için bir ad yok."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kartta kişi oluşturmak için bir ad yok."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "“%(href)s” koleksiyonu artık sunucuda değil. Yeniden oluşturulmadı; başka birini seçin ya da bırakın."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "İlk eşitleme eksik olanları oluşturacak."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "%(path)s klasörü oluşturulamadı: üstündeki klasör yok."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "%(path)s klasörü sunucuda yok. Önce orada oluşturun: Postulo, yedeklerin saklandığı klasörü oluşturmaz."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "%(path)s klasörü sunucuda yok. Önce orada oluşturun: Postulo yalnızca altındaki klasörleri oluşturur."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "%(path)s klasörü var ve içinde %(count)d öğe bulunuyor."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "%(path)s klasörü var ve içinde Postulo'nun %(count)d yedeği bulunuyor."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Klasörde %(free)s için yer var ve yedek %(needed)s gerektiriyor, bu yüzden hiçbir şey gönderilmedi."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Klasör bunun %(found)d baytını içeriyor ve yedek %(size)d bayt: doğrulanmadı."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Klasör dolu: sunucuda dosya için yer yok."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Var olması gereken klasörün tam adresi. Nextcloud'da: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo, altındaki klasörleri gerektikçe oluşturur ve asla dışına yazmaz.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Var olması gereken klasörün tam adresi. Nextcloud'da: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Klasörü yalnızca arşivler için kullanın.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Sunucu %(method)s %(path)s isteğine HTTP %(status)d yanıtını verdi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Sunucu “%(name)s” içine yazmanıza izin vermiyor: salt okunur."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Sunucu bir takvim ana dizini belirtmiyor."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Sunucu bir adres defteri ana dizini belirtmiyor."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Sunucu dosyanın ne kadar büyük olduğunu bildirmiyor, bu yüzden doğrulayamıyor."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Sunucu %(kind)s hesabının nerede olduğunu söylemiyor."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Sunucu, yazılıp yazılamayacağını bildirmiyor"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Sunucu kendi dışındaki bir adrese yönlendirdi (%(host)s); bu yönlendirme izlenmedi."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Sunucu %(path)s yolunu çok fazla kez yönlendirdi."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Sunucu bir yüklemeyi yönlendirdi ve yönlendirme izlenmez."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Sunucu kullanıcı adını ya da parolayı reddetti."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Sunucu bir görev listesi oluşturmadı, bu yüzden görev tutmayabilir."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Sunucunun adresi, ör. https://cloud.example.org ya da bir yolun altındaysa DAV hizmetinin adresi, ör. https://example.org/dav.php/. Postulo adres defteri ve takvim ana dizinlerini oradan bulur."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Sunucunun yanıtı okunamadı: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Sunucunun %(path)s için verdiği yanıt çok büyük ya da çok yavaştı ve okunmadı."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Görev okunamadı, bu yüzden değiştirilmedi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "“%(name)s” görevi görev listesinden kaldırıldı; hatırlatma korundu."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Görevin hatırlatma oluşturmak için bir bitiş zamanı yok."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "“%(name)s” görev listesi sunucuda yok."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "“%(name)s” görevinin bitiş zamanı yok, bu yüzden hatırlatma oluşturulmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "“%(name)s” görevi görev listesinden kaldırıldı; yeniden oluşturulmaz."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Bu yükleme için süre doldu."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Takvimdeki %(kind)s zamanı kullanılamadı (%(why)s), bu nedenle taşınmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "“%(name)s” görevinin zamanı kullanılamadı (%(why)s), bu yüzden hatırlatma taşınmadı."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "%(size)s daha için yer var."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Bu koleksiyon burada salt okunur, bu yüzden bir %(method)s isteği gönderilmedi."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "O klasörde çok fazla dosyanın adı zaten %(name)s."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Yalnızca aşağıda hiçbir koleksiyon seçilmediği sürece kullanılır. Bir takvimin adı veya adresi; orada olmayan bir takvim, salt okunur açık değilse ilk eşitlemede oluşturulur. Takvimin tamamı eşitlenir ve iki takvimin paylaştığı bir ad reddedilir."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Yalnızca aşağıda hiçbir koleksiyon seçilmediği sürece kullanılır. Hatırlatmalarınızı tutacağınız bir görev listesinin adı veya adresi; boş bırakılırsa hiçbiri kullanılmaz. Orada olmayan bir ad, salt okunur açık değilse ilk eşitlemede oluşturulur. Görev tutan bir sunucu gerekir."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Yalnızca aşağıda hiçbir koleksiyon seçilmediği sürece kullanılır. Bir adres defterinin adı veya adresi; orada olmayan bir adres defteri, salt okunur açık değilse ilk eşitlemede oluşturulur. Adres defterinin tamamı eşitlenir ve iki adres defterinin paylaştığı bir ad reddedilir."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Kullanıcı adı"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "web adresleri"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV klasörü"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Hangi kişilerin adres defterinde bir kart alacağı. Orada olan kartlar kalır ve bu kapalıyken onlara başka bir şey gönderilmez."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Her şirketi, şirketle uyum içinde tutulan kendi kartı olarak yazın (adı ve web sitesiyle bir şirket kartı)."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Kendi bilgilerinizi kendi kartına tek yönlü yazın: telefondaki bir değişiklik profilinize asla ulaşmaz."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "kendi kartınız"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Kendi kartınız gönderilmedi: profilinizde ad yok."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Kendi kartınız adres defterinden kaldırıldı; korundu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "“%(href)s” okunamadı: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "“%(name)s” burada değişti, ama telefonda daha sonra değişti; onlarınki alındı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "“%(name)s” iki tarafta aynı anda değişti; bir sonraki çalıştırma karar verecek."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "“%(name)s” her iki tarafta da değişti ve telefondan gelen kartta zaman bilgisi yok: telefondaki sürüm alındı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "“%(name)s” telefonda değişti, ama burada daha sonra değişti; bizimki korundu."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "“%(name)s” bir görüşmeye dönüştürülemedi: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "“%(name)s” bir görüşmeye dönüştürülemedi: saati okunamıyor."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "“%(name)s” bir takvim değil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "“%(name)s” bir görev listesi değil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "“%(name)s” bir adres defteri değil."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "“%(name)s” sizinle yalnızca okuma için paylaşılmış; telefondaki değişiklik uygulanmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "“%(name)s” sunucuda başka bir adrese taşındı; eşleşmesi sürüyor."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "“%(name)s” karttan değiştirilmedi: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” adres defterinden kaldırıldı; burada saklandı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "“%(name)s” atlandı: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "“%(name)s”: karttaki %(what)s alınmadı, böylece burada saklananlardan hiçbiri kaybolmaz."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "“%(name)s”: karttaki bir numara, adres veya web adresi alınmadı: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "“%(name)s”: karttaki e-posta alınmadı: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "“%(name)s”: karttaki numara burada zaten başka bir kayıtta bulunuyor, bu nedenle alınmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "“%(name)s”: karttaki numara alınmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "“%(name)s”: karttaki web adresi geçerli bir web adresi değil, bu nedenle alınmadı."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "“%(name)s”: karttaki web adresi alınmadı."
