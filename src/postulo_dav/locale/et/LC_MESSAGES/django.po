#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d kogum valitud"
msgstr[1] "%(count)d kogumit valitud"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d kalendrisündmust ei pärine Postulost ja jäeti puutumata."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d kirjet on seotud millegagi väljaspool valitud kogumit ja jäeti puutumata."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d kirjet ei saadetud, sest seda liiki saatmine on välja lülitatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d ülesanne ülesandeloendis pole Postulost ja jäeti puutumata."
msgstr[1] "%(count)d ülesannet ülesandeloendis pole Postulost ja jäeti puutumata."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s eemaldati kalendrist teises seadmes; siin alles jäetud."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s ei ole üks varukoopiatest, mida see sihtkoht hoiab, seega seda ei kustutatud."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(ettevõte puudub)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(pealkirjata)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Kaardist ei saa seda teha."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Siin kustutatud kontakti oli pärast viimast sünkroonimist telefonis muudetud. Kaart jäeti aadressiraamatusse ja naaseb järgmisel käivitusel kontaktina."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Kaustas on juba teine fail nimega %(name)s ja seda ei kirjutatud üle."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Meeldetuletust muudeti mõlemal poolel korraga; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Siin kustutatud meeldetuletust oli telefonis pärast viimast sünkroonimist muudetud. Ülesanne jäeti ülesandeloendisse."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Väljaspool valitud kogumeid tehtud päringut ei saadetud."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Ülesannet muudeti mõlemal poolel korraga; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Ülesanne viidi teisele aadressile; on endiselt seotud."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "aadressiraamat"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Aadressiraamat"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Aadressiraamatud"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "aadressid"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Kõik kaustas, kirjeldavate nimedega"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Kõik"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Hoia ülesandeloendis iga kandideerimise kohta ka kaks ülesannet: üks kandideerimiseks, mille märkimine saadab teile ettepaneku, ja teine vastuse ootamiseks, mis suletakse, kui kandideerimine lõpeb. Kandideerimise meeldetuletused asuvad selle avatud ülesande all."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Kirjuta kalendrisse ka lehe Kalender terved päevad (kandideerimistähtajad, kuulutuste sulgemiskuupäevad ja kuupäevad, milleks tuleb pakkumisele vastata) terve päeva sündmustena, ühes suunas: telefonis tehtud muudatus kirjutatakse üle. Eeldab, et Postulo teab oma aadressi."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Rakenduse parool, kui server seda pakub. Salvestatakse krüptitult."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Intervjuu muutus korraga mõlemal poolel; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Siin kustutatud intervjuud oli pärast viimast sünkroonimist telefonis muudetud. Sündmus jäeti kalendrisse."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Intervjuu liikus kalendris teisele aadressile; seos on alles."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Kandideeri ametikohale %(role)s ettevõttes %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Ettevõtte ja rolli järgi, igaüks oma kaustas"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalender"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendrid"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Kalendris tühistatud."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV ja CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Siin muudetud %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Siin muudetud, kuid hiljem telefonis uuesti muudetud; võeti telefoni versioon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonis muudetud %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonis muudetud, kuid hiljem siin uuesti muudetud; jäeti meie versioon."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Kogumid"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Tähtajad ja kuupäevad"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Kausta aadress"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Leiti: %(what)s „%(name)s“ (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Leiti aadressiraamat „%(book)s“ (%(book_href)s) ja kalender „%(calendar)s“ (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Leiti ülesandeloend „%(name)s“ (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Kaardilt „%(name)s“: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Oota vastust ettevõttelt %(company)s ametikoha %(role)s kohta"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Kuidas failid on paigutatud"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "seda ei saanud siin salvestada"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "sellel pole ajavööndit"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "see on terve päeva sündmus"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "selle aadress või identifikaator on liiga pikk"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "selle aega ei saa lugeda"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "selle ajavöönd „%(zone)s“ pole siin teada"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Märgiti ülesandeloendis kandideerituks"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Valitud on rohkem kui üks %(what)s ja ühendus sünkroonib ainult ühte: ühtegi ei kasutatud. Lisage iga jaoks oma ühendus või jätke teised kõrvale."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Rohkem kui ühe kogumi nimi on „%(name)s“. Valige üks neist nime asemel aadressi järgi."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Ära kunagi kirjuta serverisse, isegi mitte aadressiraamatu, kalendri või ülesandeloendi loomiseks. Kontaktid, intervjuud ja meeldetuletused tulevad endiselt sisse; midagi ei lähe välja."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Puudub"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ükski valitud kogumitest pole serveris."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numbrid"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// kaudu liigub parool võrgus krüptimata ja „%(host)s“ ei ole teie enda võrgu aadress. Kasutage https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Parool või rakenduse parool"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Vajutage Otsi serverist ning valige siis üks aadressiraamat, üks kalender ja üks ülesandeloend. Ainult neid loetakse või kirjutatakse ning siin seatud režiim on Postulo sõna, mitte serveri lukk: rakenduse parooli ei saa piirata ühe kogumiga. Sünkroonitakse terved kogumid."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Lugemine ja kirjutamine"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "lugemine ja kirjutamine"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Ainult lugemiseks"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "ainult lugemiseks"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "„Ainult lugemiseks“ on sisse lülitatud, seega midagi ei looda: looge see serveris või nimetage mõni, mis on juba olemas."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Serveris ainult lugemiseks"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Meeldetuletusi ei sünkroonitud: ülesandeloendit ei saanud kasutada. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Saada ettevõtted"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Saada kontaktid"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Saada minu enda kaart"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveri aadress"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Salvestatakse krüptituna. See avab kausta kõigi kontode varukoopiatega ja vanu eemaldatakse kustutamise teel: kasutage kontot, mis ulatub ainult selle kaustani, näiteks Hetzner Storage Boxi alamkontot või varukoopiate jaoks loodud kontot, ja mitte midagi muud."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Salvestatakse krüptituna. Enamik servereid ei saa parooli ühe kaustaga piirata; üleslaadimist lubav Nextcloudi avalik jagamine või Hetzner Storage Boxi alamkonto saab."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "ülesandeloend"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Ülesandeloend"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Ülesandeloendid"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Kandideerimistega seotud ülesanded"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Seda kaarti on pärast loendisse panemist muudetud."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Seda kaarti pole valitud aadressiraamatus."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Seda ülesannet on pärast loendisse panemist muudetud."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Seda ülesannet pole valitud ülesandeloendis."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "„%(kind)s“ on seotud sündmusega, millel on korraldaja, seega loetakse seda kalendrist ja sinna kunagi ei kirjutata."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Kalendris olev sündmus (%(kind)s) lõpeb enne, kui algab, seega seda ei teisaldatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Aadressiraamatut „%(name)s“ serveris ei ole."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Aadress peab algama https:// – näiteks %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Varukoopiat pole pärast üleslaadimist kaustas."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalender „%(name)s“ ei võta sündmusi vastu, seega seda ei kasutatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendrit „%(name)s“ serveris ei ole."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kaarti ei saanud lugeda, seega seda ei muudetud."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kaardil pole nime, millest ettevõtet teha."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kaardil pole nime, millest kontakti teha."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Kogumit „%(href)s“ pole enam serveris. Seda ei tehtud uuesti; valige mõni teine või jätke see kõrvale."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Esimene sünkroonimine loob puuduva."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Kausta %(path)s ei saanud luua: selle kohal olevat kausta pole."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Kausta %(path)s serveris pole. Looge see seal kõigepealt: Postulo ei loo kausta, kus varukoopiaid hoitakse."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Kausta %(path)s serveris pole. Looge see seal kõigepealt: Postulo loob ainult selle all olevad kaustad."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Kaust %(path)s on olemas ja selles on %(count)d üksust."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Kaust %(path)s on olemas ja selles on %(count)d Postulo varukoopiat."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Kaustas on ruumi %(free)s jaoks ja varukoopia vajab %(needed)s, seega midagi ei saadetud."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Kaustas on sellest %(found)d baiti ja varukoopia on %(size)d: pole kinnitatud."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Kaust on täis: serveris pole failile ruumi."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Server vastas päringule %(method)s %(path)s: HTTP %(status)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Server ei luba teil kirjutada kogumisse „%(name)s“: ainult lugemiseks."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "Server ei nimeta kalendrite kodukausta."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "Server ei nimeta aadressiraamatute kodukausta."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Server ei ütle, kui suur fail on, seega ei saa seda kinnitada."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Server ei ütle, kus %(kind)s konto on."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Server ei ütle, kas sinna tohib kirjutada"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Server suunas oma hostist väljapoole (%(host)s); seda ei järgitud."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Server suunas aadressi %(path)s ümber liiga palju kordi."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Server suunas üleslaadimise ümber, mida ei järgita."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Server lükkas kasutajanime või parooli tagasi."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Server ei tahtnud ülesandeloendit luua, seega ei pruugi ta ülesandeid hoida."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serveri aadress, nt https://cloud.example.org, või selle DAV-teenuse aadress, kui see asub mingi tee all, nt https://example.org/dav.php/. Sealt leiab Postulo aadressiraamatute ja kalendrite kodukaustad."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serveri vastust ei õnnestunud lugeda: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serveri vastus aadressile %(path)s oli liiga suur või liiga aeglane ja seda ei loetud."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Ülesannet ei saanud lugeda, seega seda ei muudetud."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "„%(name)s“ ülesanne eemaldati ülesandeloendist; meeldetuletus jäeti alles."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Ülesandel pole tähtaega, millest meeldetuletust teha."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Ülesandeloendit „%(name)s“ pole serveris."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Ülesandel „%(name)s“ pole tähtaega, seega sellest ei tehtud meeldetuletust."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Ülesanne „%(name)s“ eemaldati ülesandeloendist; seda ei tehta uuesti."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Selle üleslaadimise aeg sai otsa."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Kalendris olevat sündmust (%(kind)s) ei teisaldatud, sest selle aega ei saanud kasutada (%(why)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Ülesande „%(name)s“ aega ei saanud kasutada (%(why)s), seega meeldetuletust ei nihutatud."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Ruumi on veel %(size)s jaoks."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "See kogum on siin ainult lugemiseks, seega %(method)s-päringut ei saadetud."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Selles kaustas on juba liiga palju faile nimega %(name)s."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Kasutatakse ainult siis, kui allpool pole ühtegi kogumit valitud. Kalendri nimi või aadress; kui seda pole, loob selle esimene sünkroonimine, välja arvatud juhul, kui ainult lugemise režiim on sees. Sünkroonitakse kogu kalender ja nime, mida kaks kalendrit jagavad, ei võeta vastu."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Kasutatakse ainult siis, kui allpool pole ühtegi kogumit valitud. Ülesandeloendi nimi või aadress, kuhu oma meeldetuletused panna; tühjana ei kasutata ühtegi. Nime, mida pole, loob esimene sünkroonimine, välja arvatud juhul, kui ainult lugemise režiim on sees. Vajab serverit, mis hoiab ülesandeid."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Kasutatakse ainult siis, kui allpool pole ühtegi kogumit valitud. Aadressiraamatu nimi või aadress; kui seda pole, loob selle esimene sünkroonimine, välja arvatud juhul, kui ainult lugemise režiim on sees. Sünkroonitakse kogu aadressiraamat ja nime, mida kaks aadressiraamatut jagavad, ei võeta vastu."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Kasutajanimi"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "veebiaadressid"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV-i kaust"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Millistele kontaktidele tehakse aadressiraamatusse kaart. Juba olemasolevad kaardid jäävad ja neile ei saadeta enam midagi, kuni see on välja lülitatud."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Kirjuta iga ettevõte omaette kaardina (ettevõtte kaart koos nime ja veebisaidiga), mida hoitakse ettevõttega kooskõlas."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Kirjuta oma andmed omaette kaardile ühes suunas: telefonis tehtud muudatus ei jõua kunagi teie profiili."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "teie enda kaart"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Teie enda kaarti ei saadetud: teie profiilil pole nime."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Teie enda kaart eemaldati aadressiraamatust; jäeti alles."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s“ ei saanud lugeda: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s“ muutus siin, aga muutus hiljem ka telefonis; võeti telefoni oma."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ muutus korraga mõlemal poolel; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ muutus mõlemal poolel ja telefoni kaardil pole aega: võeti telefoni versioon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s“ muutus telefonis, aga muutus hiljem ka siin; jäeti meie oma."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s“ ei saanud intervjuuks teha: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s“ ei saanud intervjuuks teha: selle aega ei saa lugeda."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s“ pole kalender."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s“ pole ülesandeloend."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s“ pole aadressiraamat."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s“ on teiega jagatud ainult lugemiseks; telefonis tehtud muudatust ei rakendatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s“ liikus serveris teisele aadressile; seos on alles."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s“ ei muudetud kaardi järgi: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ eemaldati aadressiraamatust; siin alles jäetud."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "„%(name)s“ jäeti vahele: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "„%(name)s“: kaardil olevat ei võetud üle: %(what)s, et midagi siin hoitavast ei läheks kaotsi."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "„%(name)s“: kaardil olevat numbrit, aadressi või veebiaadressi ei võetud üle: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "„%(name)s“: kaardil olevat e-posti ei võetud üle: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s“: kaardil olev number kuulub siin juba teisele kirjele, seega seda ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s“: kaardil olevat numbrit ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s“: kaardil olev veebiaadress ei ole veebiaadress, seega seda ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s“: kaardil olevat veebiaadressi ei võetud üle."
