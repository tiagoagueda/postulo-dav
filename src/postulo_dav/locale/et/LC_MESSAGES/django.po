#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d kalendrisündmust ei pärine Postulost ja jäeti puutumata."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s eemaldati kalendrist teises seadmes; siin alles jäetud."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(ettevõte puudub)"

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Siin kustutatud kontakti oli pärast viimast sünkroonimist telefonis muudetud. Kaart jäeti aadressiraamatusse ja naaseb järgmisel käivitusel kontaktina."

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Aadressiraamat"

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Rakenduse parool, kui server seda pakub. Salvestatakse krüptitult."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Intervjuu muutus korraga mõlemal poolel; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Siin kustutatud intervjuud oli pärast viimast sünkroonimist telefonis muudetud. Sündmus jäeti kalendrisse."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Intervjuu liikus kalendris teisele aadressile; seos on alles."

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Kalendris tühistatud."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV ja CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Siin muudetud %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Siin muudetud, kuid hiljem telefonis uuesti muudetud; võeti telefoni versioon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonis muudetud %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonis muudetud, kuid hiljem siin uuesti muudetud; jäeti meie versioon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Leiti aadressiraamat „%(book)s“ ja kalender „%(calendar)s“."

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "seda ei saanud siin salvestada"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "sellel pole ajavööndit"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "see on terve päeva sündmus"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "selle aadress või identifikaator on liiga pikk"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "selle aega ei saa lugeda"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "selle ajavöönd „%(zone)s“ pole siin teada"

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Luuakse esimesel sünkroonimisel serverisse, kui seda seal pole, välja arvatud juhul, kui „Ainult lugemiseks“ on sisse lülitatud. Puudutatakse ainult seda aadressiraamatut."

#: src/postulo_dav/sync.py
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Luuakse esimesel sünkroonimisel serverisse, kui seda seal pole, välja arvatud juhul, kui „Ainult lugemiseks“ on sisse lülitatud. Puudutatakse ainult seda kalendrit."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Mitte kunagi kirjutada serverisse – isegi mitte aadressiraamatu ega kalendri loomiseks. Kontaktid ja intervjuud tulevad ikka sisse; midagi ei lähe välja."

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "http:// kaudu liigub parool võrgus krüptimata ja „%(host)s“ ei ole teie enda võrgu aadress. Kasutage https://."

#: src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Parool või rakenduse parool"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Ainult lugemiseks"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "ainult lugemiseks"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "„Ainult lugemiseks“ on sisse lülitatud, seega midagi ei looda: looge see serveris või nimetage mõni, mis on juba olemas."

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveri aadress"

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "Kalendris olev sündmus (%(kind)s) lõpeb enne, kui algab, seega seda ei teisaldatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Aadressiraamatut „%(name)s“ serveris ei ole."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Aadress peab algama https:// – näiteks %(example)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalendrit „%(name)s“ serveris ei ole."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Esimene sünkroonimine loob puuduva."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Server vastas päringule %(method)s %(path)s: HTTP %(status)d."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "Server ei nimeta kalendrite kodukausta."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "Server ei nimeta aadressiraamatute kodukausta."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Server ei ütle, kus %(kind)s konto on."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Server suunas oma hostist väljapoole (%(host)s); seda ei järgitud."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Server suunas aadressi %(path)s ümber liiga palju kordi."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Server lükkas kasutajanime või parooli tagasi."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serveri aadress, nt https://cloud.example.org, või selle DAV-teenuse aadress, kui see asub mingi tee all, nt https://example.org/dav.php/. Sealt leiab Postulo aadressiraamatute ja kalendrite kodukaustad."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serveri vastust ei õnnestunud lugeda: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serveri vastus aadressile %(path)s oli liiga suur või liiga aeglane ja seda ei loetud."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Kalendris olevat sündmust (%(kind)s) ei teisaldatud, sest selle aega ei saanud kasutada (%(why)s)."

#: src/postulo_dav/sync.py
msgid "Username"
msgstr "Kasutajanimi"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ muutus korraga mõlemal poolel; järgmine käivitus otsustab."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "„%(name)s“ muutus mõlemal poolel ja telefoni kaardil pole aega: võeti telefoni versioon."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "„%(name)s“ on teiega jagatud ainult lugemiseks; telefonis tehtud muudatust ei rakendatud."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "„%(name)s“ liikus serveris teisele aadressile; seos on alles."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ eemaldati aadressiraamatust; siin alles jäetud."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "„%(name)s“ jäeti vahele: %(reason)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "„%(name)s“: kaardil olev number kuulub siin juba teisele kirjele, seega seda ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "„%(name)s“: kaardil olevat numbrit ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "„%(name)s“: kaardil olev veebiaadress ei ole veebiaadress, seega seda ei võetud üle."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "„%(name)s“: kaardil olevat veebiaadressi ei võetud üle."
