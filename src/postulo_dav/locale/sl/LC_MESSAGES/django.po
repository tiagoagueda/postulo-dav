#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "Izbrana je %(count)d zbirka"
msgstr[1] "Izbrani sta %(count)d zbirki"
msgstr[2] "Izbrane so %(count)d zbirke"
msgstr[3] "Izbranih je %(count)d zbirk"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Dogodki v koledarju, ki niso iz Postula, so ostali nedotaknjeni: %(count)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d zapisov je povezanih z nečim zunaj izbrane zbirke in niso bili spremenjeni."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d zapisov ni bilo poslanih, ker je pošiljanje te vrste izklopljeno."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d naloga na seznamu nalog ni iz Postula in je bila pustena pri miru."
msgstr[1] "%(count)d nalogi na seznamu nalog nista iz Postula in sta bili pusteni pri miru."
msgstr[2] "%(count)d naloge na seznamu nalog niso iz Postula in so bile pustene pri miru."
msgstr[3] "%(count)d nalog na seznamu nalog ni iz Postula in so bile pustene pri miru."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s: odstranjeno iz koledarja na drugi napravi; tukaj ohranjeno."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s ni ena od varnostnih kopij, ki jih hrani ta cilj, zato ni bila izbrisana."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(brez podjetja)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(brez naslova)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Kartice ni mogoče spremeniti v to."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Stik, izbrisan tukaj, je bil od zadnje sinhronizacije spremenjen v telefonu. Vizitka je ostala v imeniku in se ob naslednji sinhronizaciji vrne kot stik."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "Druga datoteka se v mapi že imenuje %(name)s in ni bila prepisana."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Opomnik se je hkrati spremenil na obeh straneh; odloči naslednji zagon."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Opomnik, izbrisan tukaj, se je od zadnje sinhronizacije spremenil na telefonu. Naloga je ostala na seznamu nalog."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Zahteva zunaj izbranih zbirk ni bila poslana."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Naloga se je hkrati spremenila na obeh straneh; odloči naslednji zagon."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Naloga je bila premaknjena na drug naslov; še vedno je povezana."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "imenik"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Imenik"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Imeniki"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "naslovi"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Vse v mapi, z opisnimi imeni"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Vse"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Na seznamu nalog hrani tudi dve nalogi za vsako prijavo: eno za oddajo prijave, katere odkljukanje vam pošlje predlog, in eno za odgovor, ki se zapre, ko se prijava konča. Opomniki o prijavi so pod njeno odprto nalogo."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "V koledar zapiši tudi cele dni s strani Koledar (roke prijav, datume zaprtja oglasov in datume, do katerih je treba odgovoriti na ponudbo) kot celodnevne dogodke, enosmerno: sprememba, narejena na telefonu, se prepiše. Zahteva, da primerek pozna lasten naslov."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Geslo za aplikacije, kjer ga strežnik ponuja. Shranjeno šifrirano."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Razgovor je bil hkrati spremenjen na obeh straneh; odloči naslednja sinhronizacija."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Razgovor, izbrisan tukaj, je bil od zadnje sinhronizacije spremenjen v telefonu. Dogodek je ostal v koledarju."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Razgovor se je v koledarju preselil na drug naslov; še vedno je povezan."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Prijava na delovno mesto %(role)s v podjetju %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Po podjetju in vlogi, vsako v svoji mapi"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "koledar"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Koledar"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Koledarji"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Preklicano v koledarju."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV in CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Spremenjeno tukaj %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Spremenjeno tukaj, a pozneje spremenjeno v telefonu; prevzeta je različica iz telefona."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Spremenjeno v telefonu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Spremenjeno v telefonu, a pozneje spremenjeno tukaj; ohranjena je tukajšnja različica."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Zbirke"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Roki in datumi"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Naslov mape"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Najdeno: %(what)s „%(name)s“ (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Najden imenik „%(book)s“ (%(book_href)s) in koledar „%(calendar)s“ (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Najden seznam nalog „%(name)s“ (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Iz kartice „%(name)s“: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Odgovor podjetja %(company)s glede delovnega mesta %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Kako so datoteke urejene"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "tukaj ga ni bilo mogoče shraniti"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "nima časovnega pasu"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "to je celodnevni dogodek"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "naslov ali identifikator je predolg"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "časa ni mogoče prebrati"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "njegov časovni pas »%(zone)s« tukaj ni znan"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Na seznamu nalog označeno kot oddano"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Izbranih je več elementov vrste „%(what)s“, povezava pa sinhronizira samo enega: noben ni bil uporabljen. Dodajte povezavo za vsakega ali pustite druge."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Več zbirk se imenuje „%(name)s“. Izberite eno od njih po naslovu namesto po imenu."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Nikoli ne piši na strežnik – niti za ustvarjanje imenika, koledarja ali seznama nalog. Stiki, razgovori in opomniki še vedno prihajajo; nič ne odhaja."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Brez"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Nobena od izbranih zbirk ni na strežniku."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "številke"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Prek http:// gre geslo po omrežju nešifrirano, »%(host)s« pa ni naslov v vašem lastnem omrežju. Uporabite https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Geslo ali geslo za aplikacije"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Pritisnite Poišči na strežniku in nato izberite en imenik, en koledar in en seznam nalog. Samo ti se berejo ali pišejo, način, nastavljen tukaj, pa je beseda Postula, ne ključavnica strežnika: geslo aplikacije ni mogoče omejiti na eno zbirko. Sinhronizirajo se cele zbirke."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Branje in pisanje"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "branje in pisanje"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Samo za branje"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "samo za branje"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Vklopljeno je samo branje, zato se nič ne ustvari: ustvarite ga na strežniku ali navedite takega, ki že obstaja."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Na strežniku samo za branje"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Opomniki niso bili sinhronizirani: seznama nalog ni bilo mogoče uporabiti. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Pošlji podjetja"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Pošlji stike"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Pošlji mojo kartico"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Naslov strežnika"

#: src/postulo_dav/backup.py
#, fuzzy
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Shranjeno šifrirano. Odpre mapo z varnostnimi kopijami vseh računov, brisanje pa je način, kako se odstranijo stare: uporabite tak račun, ki seže samo v to mapo, na primer podračun Hetzner Storage Box ali račun, narejen za varnostne kopije, in nič drugega."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Shranjeno šifrirano. Večina strežnikov ne more omejiti gesla na eno mapo; lahko pa javna Nextcloudova skupna raba, ki dovoljuje nalaganje, ali podračun Hetzner Storage Box."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "seznam nalog"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Seznam nalog"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Seznami nalog"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Naloge o prijavah"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Ta kartica se je spremenila, odkar je bila navedena."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Te kartice ni v izbranem imeniku."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Ta naloga se je spremenila, odkar je bila navedena."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Te naloge ni na izbranem seznamu nalog."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "Element „%(kind)s“ je povezan z dogodkom, ki ima organizatorja, zato se bere iz koledarja in se vanj nikoli ne piše."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s v koledarju se konča, preden se začne, zato ni bil premaknjen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Imenika »%(name)s« ni na strežniku."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Naslov se mora začeti s https:// — na primer %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Varnostne kopije po nalaganju ni v mapi."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Koledar „%(name)s“ ne sprejema dogodkov, zato ni bil uporabljen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Koledarja »%(name)s« ni na strežniku."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kartice ni bilo mogoče prebrati, zato ni bila spremenjena."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kartica nima imena, iz katerega bi nastalo podjetje."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kartica nima imena, iz katerega bi nastal stik."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Zbirke „%(href)s“ ni več na strežniku. Ni bila ustvarjena znova; izberite drugo ali jo pustite."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Prva sinhronizacija bo ustvarila, kar manjka."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Mape %(path)s ni bilo mogoče ustvariti: mape nad njo ni."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Mape %(path)s na strežniku ni. Najprej jo ustvarite tam: Postulo ne ustvari mape, v kateri se hranijo varnostne kopije."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Mape %(path)s na strežniku ni. Najprej jo ustvarite tam: Postulo ustvari le mape pod njo."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Mapa %(path)s obstaja, v njej je elementov: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Mapa %(path)s obstaja, v njej je varnostnih kopij Postula: %(count)d."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Mapa ima prostora za %(free)s, varnostna kopija pa potrebuje %(needed)s, zato ni bilo poslano nič."

#: src/postulo_dav/backup.py
#, fuzzy, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Mapa vsebuje %(found)d bajtov kopije, varnostna kopija pa jih ima %(size)d: ni potrjeno."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Mapa je polna: strežnik nima prostora za datoteko."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr "Polni naslov mape, ki mora obstajati. V Nextcloudu: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Postulo ustvari mape pod njo po potrebi in nikoli ne piše zunaj nje.</folder></user>"

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Use a folder for the archives alone."
msgstr "Polni naslov mape, ki mora obstajati. V Nextcloudu: https://cloud.example.org/remote.php/dav/files/<user>/<folder>/. Uporabite mapo samo za arhive.</folder></user>"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Strežnik je na %(method)s %(path)s odgovoril s HTTP %(status)d."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Strežnik ne dovoli pisanja v „%(name)s“: samo za branje."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name a calendar home."
msgstr "Strežnik ne navede domače zbirke koledarjev."

#: src/postulo_dav/dav.py
#, fuzzy
msgid "The server does not name an address book home."
msgstr "Strežnik ne navede domače zbirke imenikov."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Strežnik ne sporoča velikosti datoteke, zato ne more potrditi."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Strežnik ne pove, kje je račun %(kind)s."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Strežnik ne pove, ali je vanj dovoljeno pisati"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Strežnik je preusmeril na naslov zunaj svojega (%(host)s); Postulo mu ni sledil."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Strežnik je prevečkrat preusmeril %(path)s."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Strežnik je preusmeril nalaganje in preusmeritvi se ne sledi."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Strežnik je zavrnil uporabniško ime ali geslo."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Strežnik ni hotel ustvariti seznama nalog, zato morda ne hrani nalog."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Naslov strežnika, npr. https://cloud.example.org, ali naslov njegove storitve DAV, če je ta pod potjo, npr. https://example.org/dav.php/. Postulo od tam poišče domači zbirki imenikov in koledarjev."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Odgovora strežnika ni bilo mogoče prebrati: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Odgovor strežnika za %(path)s je bil prevelik ali prepočasen, zato ni bil prebran."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Naloge ni bilo mogoče prebrati, zato ni bila spremenjena."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Naloga za „%(name)s“ je bila odstranjena s seznama nalog; opomnik je bil ohranjen."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Naloga nima roka, iz katerega bi nastal opomnik."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Seznama nalog „%(name)s“ ni na strežniku."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Naloga „%(name)s“ nima roka, zato iz nje ni nastal opomnik."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Naloga „%(name)s“ je bila odstranjena s seznama nalog; ne bo ustvarjena znova."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Čas za to nalaganje se je iztekel."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "%(kind)s v koledarju ima čas, ki ga ni bilo mogoče uporabiti (%(why)s), zato ni bil premaknjen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Časa naloge „%(name)s“ ni bilo mogoče uporabiti (%(why)s), zato opomnik ni bil premaknjen."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Prostora je še za %(size)s."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Ta zbirka je tukaj samo za branje, zato zahteva %(method)s ni bila poslana."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "Preveč datotek se v tej mapi že imenuje %(name)s."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Uporabljeno samo, dokler spodaj ni izbrana nobena zbirka. Ime ali naslov koledarja; tisti, ki ga ni, ustvari prva sinhronizacija, razen če je vklopljeno samo za branje. Sinhronizira se celoten koledar, ime, ki ga imata dva koledarja, pa je zavrnjeno."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Uporabljeno samo, dokler spodaj ni izbrana nobena zbirka. Ime ali naslov seznama nalog, v katerem hranite opomnike; če je prazno, ni uporabljen noben. Ime, ki ga ni, ustvari prva sinhronizacija, razen če je vklopljeno samo za branje. Potrebuje strežnik, ki hrani naloge."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Uporabljeno samo, dokler spodaj ni izbrana nobena zbirka. Ime ali naslov imenika; tisti, ki ga ni, ustvari prva sinhronizacija, razen če je vklopljeno samo za branje. Sinhronizira se celoten imenik, ime, ki ga imata dva imenika, pa je zavrnjeno."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Uporabniško ime"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "spletni naslovi"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "Mapa WebDAV"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Kateri stiki dobijo kartico v imeniku. Kartice, ki so že tam, ostanejo in nič več se jim ne pošilja, dokler je to izklopljeno."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Vsako podjetje zapiši kot svojo kartico (kartico podjetja z imenom in spletnim mestom), usklajeno s podjetjem."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Svoje podatke zapiši na svojo kartico, enosmerno: sprememba na telefonu nikoli ne doseže vašega profila."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "vaša kartica"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Vaša kartica ni bila poslana: vaš profil nima imena."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Vaša kartica je bila odstranjena iz imenika; ohranjena."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "„%(href)s“ ni bilo mogoče prebrati: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "„%(name)s“ se je spremenil tukaj, a se je pozneje spremenil na telefonu; vzeta je njihova različica."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "»%(name)s« je bil hkrati spremenjen na obeh straneh; odloči naslednja sinhronizacija."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "»%(name)s« je bil spremenjen na obeh straneh, vizitka iz telefona pa ne navaja časa: prevzeta je različica iz telefona."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "„%(name)s“ se je spremenil na telefonu, a se je pozneje spremenil tukaj; ohranjena je naša različica."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "„%(name)s“ ni bilo mogoče spremeniti v razgovor: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "„%(name)s“ ni bilo mogoče spremeniti v razgovor: časa ni mogoče prebrati."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "„%(name)s“ ni koledar."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "„%(name)s“ ni seznam nalog."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "„%(name)s“ ni imenik."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "»%(name)s« je z vami deljen samo za branje; sprememba v telefonu ni bila uveljavljena."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "»%(name)s« se je na strežniku preselil na drug naslov; še vedno je povezan."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "„%(name)s“ ni bilo spremenjeno iz kartice: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "»%(name)s« je bil odstranjen iz imenika; tukaj je ohranjen."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "»%(name)s« je bil preskočen: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "„%(name)s“: %(what)s na kartici niso bili prevzeti, da se nič od tukaj shranjenega ne izgubi."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "„%(name)s“: številka, naslov ali spletni naslov na kartici ni bil prevzet: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "„%(name)s“: e-pošta na kartici ni bila prevzeta: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "»%(name)s«: številko na vizitki tukaj že ima drug zapis, zato ni bila prevzeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "»%(name)s«: številka na vizitki ni bila prevzeta."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "»%(name)s«: spletni naslov na vizitki ni veljaven spletni naslov, zato ni bil prevzet."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "»%(name)s«: spletni naslov na vizitki ni bil prevzet."
