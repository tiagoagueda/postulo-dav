#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d dogodkov v koledarju ni iz aplikacije Postulo in so ostali nedotaknjeni."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s odstranjeno iz koledarja na drugi napravi; tukaj ohranjeno."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(brez podjetja)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Kontakt izbrisan tukaj je bil spremenjen po telefonu od zadnje sinhronizacije. Kartica je ostala v adresarju, in se vrne kot stik v naslednjem teku."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Imenik"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Geslo za aplikacije, kjer ga strežnik ponuja. Shranjeno šifrirano."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Razgovor se je spremenil na obeh straneh hkrati; odloči naslednji zagon."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Intervju zbrisan tukaj je bil spremenjen po telefonu od zadnje sinhronizacije. Dogodek je ostal na koledarju."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Koledar"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Preklicano v koledarju."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV in CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Spremenjeno tukaj %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Spremenjeno tukaj, a pozneje spremenjeno na telefonu; prevzeta njihova različica."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Spremenjeno na telefonu %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Spremenjeno na telefonu, a pozneje spremenjeno tukaj; ohranjena naša različica."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Najden imenik „%(book)s“ in koledar „%(calendar)s“."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Narejeno na strežniku s prvo sinhronizacijo, če je ni, razen če je samo branje vključeno. Samo ta adresar je ganjen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Narejeno na strežniku s prvo sinhronizacijo, če je ni, razen če je samo branje vključeno. Samo ta koledar je ganjen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Nikoli ne pišite strežniku – niti zato, da bi naredili adresarja ali koledar. Kontakti in intervjuji še vedno prihajajo, nič ne gre ven."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Nad http:// geslo gre preko omrežja v čistem, in »%(host)s« ni naslov na vašem lastnem omrežju. Uporabi https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Geslo ali geslo za aplikacije"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Samo za branje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "samo za branje"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Branje je samo na, tako da ni nič narejeno: ustvarite ga na strežniku, ali pa ime tistega, ki je že tam."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Naslov strežnika"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresar »%(name)s« ni na strežniku."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Naslov se mora začeti s https:// — na primer %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Koledar »%(name)s« ni na strežniku."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Prva uskladitev bo naredila, kar manjka."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Koren strežnika, npr. https://cloud.example.org. Postulo od tam najde, kje sta imenik in koledar."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Uporabniško ime"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ se je spremenil na obeh straneh hkrati; odloči naslednji zagon."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ je bil odstranjen iz imenika; tukaj ohranjen."
