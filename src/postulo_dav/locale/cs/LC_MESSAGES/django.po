#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Které kontakty dostanou kartu v adresáři. Karty, které už tam jsou, zůstanou a dokud je to vypnuto, nic dalšího se jim neposílá."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Zapisovat každou firmu jako samostatnou kartu (firemní karta s názvem a webem), udržovanou v souladu s firmou."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Zapisovat vaše vlastní údaje do samostatné karty, jen jedním směrem: změna v telefonu se do vašeho profilu nikdy nedostane."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "vaše vlastní karta"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Vaše vlastní karta nebyla odeslána: váš profil nemá jméno."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Vaše vlastní karta byla z adresáře odstraněna; ponechána."

