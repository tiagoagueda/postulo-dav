#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d hendelser i kalenderen er ikke fra Postulo og ble igjen alene."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s fjernet fra kalenderen på en annen enhet; holdt her."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(ingen selskap)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt slettet her hadde blitt endret på telefonen siden den siste synkroniseringen. Kortet ble igjen i adresseboken og kommer tilbake som kontakt på neste løp."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adressebok"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Et apppassord der serveren tilbyr ett. Oppbevart kryptert."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Et intervju endret seg på begge sider samtidig; neste løp bestemmer."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Et intervju slettet her hadde blitt endret på telefonen siden siste synkronisering. Hendelsen ble igjen i kalenderen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Avlyst i kalenderen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV og CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Endret her på %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Endret her, men endret seg på telefonen senere; tok deres."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Endret på telefonen på %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Endret på telefonen, men endret seg her senere; holdt vår."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Fant adresseboken «%(book)s» og kalenderen «%(calendar)s»."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Laget på serveren av den første synkroniseringen hvis den ikke er der, med mindre det bare er skrive på. Bare denne adresseboken er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Laget på serveren av den første synkroniseringen hvis den ikke er der, med mindre det bare er skrive på. Bare denne kalenderen er rørt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Aldri skrive til serveren - ikke engang å lage adresseboken eller kalenderen. Kontakter og intervjuer kommer fortsatt inn, ingenting går ut."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http:// passordet går over nettverket i det klare, og \\\"%(host)s\\\" er ikke en adresse på ditt eget nettverk. Bruk https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Passord eller app-passord"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Les bare"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "les bare"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Les bare på, så ingenting er laget: Opprett den på serveren, eller navn på en som allerede er der."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradresse"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresseboken «%(name)s» er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adressen må begynne med https:// — for eksempel %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenderen «%(name)s» er ikke på serveren."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Første synkronisering vil gjøre det som mangler."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Serverens rot, for eksempel https://cloud.example.org. Postulo finner adressebok og kalenderhus derfra."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Brukernavn"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» endret seg på begge sider samtidig; neste løp bestemmer."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "“%(name)s” ble fjernet fra adresseboken; holdt her."
