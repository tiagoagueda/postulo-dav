#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "%(count)d samling valgt"
msgstr[1] "%(count)d samlinger valgt"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d hendelser i kalenderen er ikke fra Postulo og ble ikke rørt."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d poster er koblet til noe utenfor den valgte samlingen og ble latt være."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d poster ble ikke sendt, fordi sending av den typen er slått av."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d oppgave i oppgavelisten er ikke fra Postulo og ble latt være."
msgstr[1] "%(count)d oppgaver i oppgavelisten er ikke fra Postulo og ble latt være."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s ble fjernet fra kalenderen på en annen enhet; beholdt her."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s er ikke en av sikkerhetskopiene dette målet oppbevarer, så den ble ikke slettet."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(intet selskap)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(uten tittel)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "Et kort kan ikke gjøres om til det."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "En kontakt som ble slettet her, hadde blitt endret på telefonen siden forrige synkronisering. Kortet ble liggende i adresseboken og kommer tilbake som kontakt ved neste kjøring."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "En annen fil heter allerede %(name)s i mappen, og den ble ikke overskrevet."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "En påminnelse ble endret på begge sider samtidig; neste kjøring avgjør."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "En påminnelse som ble slettet her, var endret på telefonen siden forrige synkronisering. Oppgaven ble liggende i oppgavelisten."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "En forespørsel utenfor de valgte samlingene ble ikke sendt."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "En oppgave ble endret på begge sider samtidig; neste kjøring avgjør."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "En oppgave ble flyttet til en annen adresse; fortsatt koblet."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "adressebok"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Adressebok"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Adressebøker"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "adresser"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Alt i mappen, med beskrivende navn"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Alle"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Hold også to oppgaver for hver søknad i oppgavelisten: én for å søke, som når den krysses av sender deg et forslag, og én for å høre tilbake, som lukkes når søknaden avsluttes. Påminnelser om en søknad ligger under den åpne oppgaven."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Skriv også hele dager fra Kalender-siden (søknadsfrister, stengedatoer for utlysninger og datoer et tilbud må besvares innen) til kalenderen som heldagshendelser, enveis: en endring gjort på telefonen overskrives. Krever at instansen kjenner sin egen adresse."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Et app-passord, der serveren tilbyr det. Lagres kryptert."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Et intervju ble endret på begge sider samtidig; neste kjøring avgjør."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Et intervju som ble slettet her, hadde blitt endret på telefonen siden forrige synkronisering. Hendelsen ble liggende i kalenderen."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Et intervju ble flyttet til en annen adresse i kalenderen; fortsatt sammenkoblet."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Søk på %(role)s hos %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "Etter selskap og stilling, hver i sin egen mappe"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "kalender"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Kalender"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Kalendere"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Avlyst i kalenderen."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV og CalDAV"

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Endret her %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Endret her, men endret på telefonen senere; tok deres versjon."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Endret på telefonen %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Endret på telefonen, men endret her senere; beholdt vår versjon."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Samlinger"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Frister og datoer"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Mappeadresse"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Fant %(what)s «%(name)s» (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Fant adresseboken «%(book)s» (%(book_href)s) og kalenderen «%(calendar)s» (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Fant oppgavelisten «%(name)s» (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "Fra kortet «%(name)s»: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Hør tilbake fra %(company)s om %(role)s"

#: src/postulo_dav/store.py
msgid "How files are arranged"
msgstr "Hvordan filene ordnes"

#: src/postulo_dav/sync.py
msgid "it could not be saved here"
msgstr "det kunne ikke lagres her"

#: src/postulo_dav/sync.py
msgid "it has no time zone"
msgstr "det har ingen tidssone"

#: src/postulo_dav/sync.py
msgid "it is an all-day event"
msgstr "det er en heldagshendelse"

#: src/postulo_dav/sync.py
msgid "its address or identifier is too long"
msgstr "adressen eller identifikatoren er for lang"

#: src/postulo_dav/sync.py
msgid "its time cannot be read"
msgstr "tidspunktet kan ikke leses"

#: src/postulo_dav/sync.py
#, python-format
msgid "its time zone “%(zone)s” is not known here"
msgstr "tidssonen «%(zone)s» er ukjent her"

#: src/postulo_dav/sync.py
msgid "Marked as applied in the task list"
msgstr "Merket som søkt i oppgavelisten"

#: src/postulo_dav/sync.py
#, python-format
msgid "More than one %(what)s is chosen, and a connection syncs one: none was used. Add a connection for each, or let the others go."
msgstr "Mer enn én %(what)s er valgt, og en tilkobling synkroniserer én: ingen ble brukt. Legg til en tilkobling for hver, eller slipp de andre."

#: src/postulo_dav/dav.py
#, python-format
msgid "More than one collection is called “%(name)s”. Choose one of them, by its address, instead of by name."
msgstr "Mer enn én samling heter «%(name)s». Velg en av dem med adressen i stedet for navnet."

#: src/postulo_dav/sync.py
msgid "Never write to the server — not even to make the address book, the calendar or the task list. Contacts, interviews and reminders still come in; nothing goes out."
msgstr "Skriv aldri til serveren, ikke engang for å lage adresseboken, kalenderen eller oppgavelisten. Kontakter, intervjuer og påminnelser kommer fortsatt inn; ingenting går ut."

#: src/postulo_dav/sync.py
msgid "None"
msgstr "Ingen"

#: src/postulo_dav/sync.py
msgid "None of the chosen collections is on the server."
msgstr "Ingen av de valgte samlingene finnes på serveren."

#: src/postulo_dav/sync.py
msgid "numbers"
msgstr "numre"

#: src/postulo_dav/sync.py
#, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Over http:// går passordet ukryptert over nettverket, og «%(host)s» er ikke en adresse på ditt eget nettverk. Bruk https://."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Password or app password"
msgstr "Passord eller app-passord"

#: src/postulo_dav/sync.py
msgid "Press Look on the server, then choose one address book, one calendar and one task list. Only those are read or written, and a mode set here is Postulo's word, not the server's lock: an app password cannot be narrowed to one collection. Whole collections sync."
msgstr "Trykk Se etter på serveren, og velg så én adressebok, én kalender og én oppgaveliste. Bare disse leses eller skrives til, og en modus satt her er Postulos ord, ikke serverens lås: et appassord kan ikke begrenses til én samling. Hele samlinger synkroniseres."

#: src/postulo_dav/sync.py
msgid "Read and write"
msgstr "Lese og skrive"

#: src/postulo_dav/sync.py
msgid "read and write"
msgstr "lese og skrive"

#: src/postulo_dav/sync.py
msgid "Read only"
msgstr "Skrivebeskyttet"

#: src/postulo_dav/sync.py
msgid "read only"
msgstr "skrivebeskyttet"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Skrivebeskyttelse er slått på, så ingenting opprettes: opprett den på serveren, eller oppgi en som allerede finnes."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Skrivebeskyttet på serveren"

#: src/postulo_dav/sync.py
#, python-format
msgid "Reminders were not synced: the task list could not be used. %(why)s"
msgstr "Påminnelser ble ikke synkronisert: oppgavelisten kunne ikke brukes. %(why)s"

#: src/postulo_dav/sync.py
msgid "Send companies"
msgstr "Send selskaper"

#: src/postulo_dav/sync.py
msgid "Send contacts"
msgstr "Send kontakter"

#: src/postulo_dav/sync.py
msgid "Send my own card"
msgstr "Send mitt eget kort"

#: src/postulo_dav/sync.py
msgid "Server address"
msgstr "Serveradresse"

#: src/postulo_dav/backup.py
msgid "Stored encrypted. It opens a folder of every account's backups, and deleting is how old ones are removed: use one that reaches only this folder, such as a Hetzner Storage Box sub-account or an account made for backups, and nothing else."
msgstr "Lagres kryptert. Den åpner en mappe med alle kontoers sikkerhetskopier, og sletting er måten gamle fjernes på: bruk en som bare når denne mappen, for eksempel en underkonto i Hetzner Storage Box eller en konto laget for sikkerhetskopier, og ingenting annet."

#: src/postulo_dav/store.py
msgid "Stored encrypted. Most servers cannot narrow a password to one folder; a Nextcloud public share that allows uploads, or a Hetzner Storage Box sub-account, can."
msgstr "Lagres kryptert. De fleste servere kan ikke begrense et passord til én mappe; en offentlig Nextcloud-deling som tillater opplasting, eller en underkonto i Hetzner Storage Box, kan det."

#: src/postulo_dav/sync.py
msgid "task list"
msgstr "oppgaveliste"

#: src/postulo_dav/sync.py
msgid "Task list"
msgstr "Oppgaveliste"

#: src/postulo_dav/sync.py
msgid "Task lists"
msgstr "Oppgavelister"

#: src/postulo_dav/sync.py
msgid "Tasks about applications"
msgstr "Oppgaver om søknader"

#: src/postulo_dav/sync.py
msgid "That card has changed since it was listed."
msgstr "Det kortet er endret siden det ble listet."

#: src/postulo_dav/sync.py
msgid "That card is not in the chosen address book."
msgstr "Det kortet finnes ikke i den valgte adresseboken."

#: src/postulo_dav/sync.py
msgid "That task has changed since it was listed."
msgstr "Den oppgaven er endret siden den ble listet."

#: src/postulo_dav/sync.py
msgid "That task is not in the chosen task list."
msgstr "Den oppgaven finnes ikke i den valgte oppgavelisten."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s is paired with an event that has an organizer, so it is read from the calendar and never written to it."
msgstr "%(kind)s er koblet til en hendelse med en arrangør, så den leses fra kalenderen og skrives aldri til den."

#: src/postulo_dav/sync.py
#, python-format
msgid "The %(kind)s on the calendar ends before it starts, so it was not moved."
msgstr "%(kind)s i kalenderen slutter før den starter, så den ble ikke flyttet."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Adresseboken «%(name)s» er ikke på serveren."

#: src/postulo_dav/sync.py
#, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Adressen må begynne med https:// – for eksempel %(example)s."

#: src/postulo_dav/backup.py
msgid "The backup is not in the folder after the upload."
msgstr "Sikkerhetskopien er ikke i mappen etter opplastingen."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” does not take events, so it was not used."
msgstr "Kalenderen «%(name)s» tar ikke imot hendelser, så den ble ikke brukt."

#: src/postulo_dav/sync.py
#, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Kalenderen «%(name)s» er ikke på serveren."

#: src/postulo_dav/sync.py
msgid "The card could not be read, so it was not changed."
msgstr "Kortet kunne ikke leses, så det ble ikke endret."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a company of."
msgstr "Kortet har ikke noe navn å lage et selskap av."

#: src/postulo_dav/sync.py
msgid "The card has no name to make a contact of."
msgstr "Kortet har ikke noe navn å lage en kontakt av."

#: src/postulo_dav/sync.py
#, python-format
msgid "The collection “%(href)s” is no longer on the server. It was not made again; choose another, or let it go."
msgstr "Samlingen «%(href)s» finnes ikke lenger på serveren. Den ble ikke laget på nytt; velg en annen, eller slipp den."

#: src/postulo_dav/sync.py
msgid "The first sync will make what is missing."
msgstr "Første synkronisering oppretter det som mangler."

#: src/postulo_dav/files.py
#, python-format
msgid "The folder %(path)s could not be made: the folder above it is not there."
msgstr "Mappen %(path)s kunne ikke opprettes: mappen over den finnes ikke."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo does not make the folder the backups are kept in."
msgstr "Mappen %(path)s finnes ikke på serveren. Opprett den der først: Postulo oppretter ikke mappen sikkerhetskopiene oppbevares i."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is not there on the server. Make it there first: Postulo makes only the folders below it."
msgstr "Mappen %(path)s finnes ikke på serveren. Opprett den der først: Postulo oppretter bare mappene under den."

#: src/postulo_dav/store.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d items in it."
msgstr "Mappen %(path)s finnes, med %(count)d elementer i."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder %(path)s is there, with %(count)d of Postulo's backups in it."
msgstr "Mappen %(path)s finnes, med %(count)d av Postulos sikkerhetskopier i."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder has room for %(free)s and the backup needs %(needed)s, so nothing was sent."
msgstr "Mappen har plass til %(free)s og sikkerhetskopien trenger %(needed)s, så ingenting ble sendt."

#: src/postulo_dav/backup.py
#, python-format
msgid "The folder holds %(found)d bytes of it and the backup is %(size)d: not confirmed."
msgstr "Mappen inneholder %(found)d byte av den, og sikkerhetskopien er %(size)d: ikke bekreftet."

#: src/postulo_dav/files.py
msgid "The folder is full: the server has no room for the file."
msgstr "Mappen er full: serveren har ikke plass til filen."

#: src/postulo_dav/store.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Postulo makes the folders below it as it needs them and never writes outside it."
msgstr ""

#: src/postulo_dav/backup.py
msgid "The folder's full address, which has to exist. On Nextcloud: https://cloud.example.org/remote.php/dav/files/USER/FOLDER/. Use a folder for the archives alone."
msgstr ""

#: src/postulo_dav/dav.py
#, python-format
msgid "The server answered HTTP %(status)d for %(method)s %(path)s."
msgstr "Serveren svarte HTTP %(status)d for %(method)s %(path)s."

#: src/postulo_dav/sync.py
#, python-format
msgid "The server does not let you write to “%(name)s”: read only."
msgstr "Serveren lar deg ikke skrive til «%(name)s»: skrivebeskyttet."

#: src/postulo_dav/dav.py
msgid "The server does not name a calendar home."
msgstr "Serveren oppgir ingen kalenderrot."

#: src/postulo_dav/dav.py
msgid "The server does not name an address book home."
msgstr "Serveren oppgir ingen adressebokrot."

#: src/postulo_dav/backup.py
msgid "The server does not say how big the file is, so it cannot confirm."
msgstr "Serveren oppgir ikke hvor stor filen er, så den kan ikke bekrefte."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server does not say where the %(kind)s account is."
msgstr "Serveren sier ikke hvor %(kind)s-kontoen er."

#: src/postulo_dav/sync.py
msgid "The server does not say whether it may be written"
msgstr "Serveren sier ikke om det kan skrives til den"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server pointed to an address outside its own (%(host)s); it was not followed."
msgstr "Serveren pekte på en adresse utenfor sin egen (%(host)s); den ble ikke fulgt."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server redirected %(path)s too many times."
msgstr "Serveren omdirigerte %(path)s for mange ganger."

#: src/postulo_dav/files.py
msgid "The server redirected an upload, which is not followed."
msgstr "Serveren omdirigerte en opplasting, og omdirigeringen følges ikke."

#: src/postulo_dav/dav.py
msgid "The server refused the user name or password."
msgstr "Serveren avviste brukernavnet eller passordet."

#: src/postulo_dav/sync.py
msgid "The server would not make a task list, so it may not keep tasks."
msgstr "Serveren ville ikke lage en oppgaveliste, så den kan hende ikke lagrer oppgaver."

#: src/postulo_dav/sync.py
msgid "The server's address, e.g. https://cloud.example.org, or the address of its DAV service where it lives under a path, e.g. https://example.org/dav.php/. Postulo finds the address book and calendar homes from there."
msgstr "Serverens adresse, f.eks. https://cloud.example.org, eller adressen til DAV-tjenesten der den ligger under en sti, f.eks. https://example.org/dav.php/. Postulo finner adressebokroten og kalenderroten derfra."

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer could not be read: %(error)s"
msgstr "Serverens svar kunne ikke leses: %(error)s"

#: src/postulo_dav/dav.py
#, python-format
msgid "The server's answer for %(path)s was too large or too slow, and was not read."
msgstr "Serverens svar for %(path)s var for stort eller for tregt, og ble ikke lest."

#: src/postulo_dav/sync.py
msgid "The task could not be read, so it was not changed."
msgstr "Oppgaven kunne ikke leses, så den ble ikke endret."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task for “%(name)s” was removed from the task list; the reminder was kept."
msgstr "Oppgaven for «%(name)s» ble fjernet fra oppgavelisten; påminnelsen ble beholdt."

#: src/postulo_dav/sync.py
msgid "The task has no due time to make a reminder of."
msgstr "Oppgaven har ingen frist å lage en påminnelse av."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task list “%(name)s” is not on the server."
msgstr "Oppgavelisten «%(name)s» finnes ikke på serveren."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” has no due time, so it was not made a reminder."
msgstr "Oppgaven «%(name)s» har ingen frist, så det ble ikke laget en påminnelse av den."

#: src/postulo_dav/sync.py
#, python-format
msgid "The task “%(name)s” was removed from the task list; it is not made again."
msgstr "Oppgaven «%(name)s» ble fjernet fra oppgavelisten; den lages ikke på nytt."

#: src/postulo_dav/backup.py
msgid "The time for this upload ran out."
msgstr "Tiden for denne opplastingen gikk ut."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the %(kind)s on the calendar could not be used (%(why)s), so it was not moved."
msgstr "Tidspunktet for %(kind)s i kalenderen kunne ikke brukes (%(why)s), så den ble ikke flyttet."

#: src/postulo_dav/sync.py
#, python-format
msgid "The time of the task “%(name)s” could not be used (%(why)s), so the reminder was not moved."
msgstr "Tidspunktet for oppgaven «%(name)s» kunne ikke brukes (%(why)s), så påminnelsen ble ikke flyttet."

#: src/postulo_dav/backup.py src/postulo_dav/store.py
#, python-format
msgid "There is room for %(size)s more."
msgstr "Det er plass til %(size)s til."

#: src/postulo_dav/dav.py
#, python-format
msgid "This collection is read only here, so a %(method)s was not sent."
msgstr "Denne samlingen er skrivebeskyttet her, så en %(method)s-forespørsel ble ikke sendt."

#: src/postulo_dav/store.py
#, python-format
msgid "Too many files already have the name %(name)s in that folder."
msgstr "For mange filer har allerede navnet %(name)s i den mappen."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a calendar; one that is not there is made by the first sync, unless read only is on. The whole calendar syncs, and a name two calendars share is refused."
msgstr "Brukes bare mens ingen samling er valgt nedenfor. Et navn eller en adresse til en kalender; en som ikke finnes, lages ved første synkronisering, med mindre skrivebeskyttet er på. Hele kalenderen synkroniseres, og et navn som to kalendere deler, avvises."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of a task list to keep your reminders in; blank, and none is used. A name that is not there is made by the first sync, unless read only is on. Needs a server that keeps tasks."
msgstr "Brukes bare mens ingen samling er valgt nedenfor. Et navn eller en adresse til en oppgaveliste å ha påminnelsene dine i; tomt betyr at ingen brukes. Et navn som ikke finnes, lages ved første synkronisering, med mindre skrivebeskyttet er på. Krever en server som lagrer oppgaver."

#: src/postulo_dav/sync.py
msgid "Used only while no collection is chosen below. A name or an address of an address book; one that is not there is made by the first sync, unless read only is on. The whole address book syncs, and a name two address books share is refused."
msgstr "Brukes bare mens ingen samling er valgt nedenfor. Et navn eller en adresse til en adressebok; en som ikke finnes, lages ved første synkronisering, med mindre skrivebeskyttet er på. Hele adresseboken synkroniseres, og et navn som to adressebøker deler, avvises."

#: src/postulo_dav/backup.py src/postulo_dav/store.py src/postulo_dav/sync.py
msgid "Username"
msgstr "Brukernavn"

#: src/postulo_dav/sync.py
msgid "web addresses"
msgstr "nettadresser"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "WebDAV folder"
msgstr "WebDAV-mappe"

#: src/postulo_dav/sync.py
msgid "Which contacts get a card in the address book. Cards already there stay, and nothing more is sent to them while this is off."
msgstr "Hvilke kontakter som får et kort i adresseboken. Kort som allerede er der, blir, og ingenting mer sendes til dem mens dette er av."

#: src/postulo_dav/sync.py
msgid "Write each company as a card of its own (a company card, with its name and website), kept in step with the company."
msgstr "Skriv hvert selskap som et eget kort (et selskapskort, med navn og nettsted), holdt i takt med selskapet."

#: src/postulo_dav/sync.py
msgid "Write your own details to a card of its own, one way: a change on the phone never reaches your profile."
msgstr "Skriv dine egne opplysninger til et eget kort, én vei: en endring på telefonen når aldri profilen din."

#: src/postulo_dav/sync.py
msgid "your own card"
msgstr "ditt eget kort"

#: src/postulo_dav/sync.py
msgid "Your own card was not sent: your profile has no name."
msgstr "Det egne kortet ditt ble ikke sendt: profilen din har ikke noe navn."

#: src/postulo_dav/sync.py
msgid "Your own card was removed from the address book; kept."
msgstr "Ditt eget kort ble fjernet fra adresseboken; beholdt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(href)s” could not be read: %(error)s"
msgstr "«%(href)s» kunne ikke leses: %(error)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed here, but changed on the phone later; took theirs."
msgstr "«%(name)s» ble endret her, men senere endret på telefonen; tok deres."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "«%(name)s» ble endret på begge sider samtidig; neste kjøring avgjør."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on both sides, and the card from the phone gives no time: the phone's version was taken."
msgstr "«%(name)s» ble endret på begge sider, og kortet fra telefonen oppgir ikke noe tidspunkt: telefonens versjon ble valgt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” changed on the phone, but changed here later; kept ours."
msgstr "«%(name)s» ble endret på telefonen, men senere endret her; beholdt vår."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: %(why)s"
msgstr "«%(name)s» kunne ikke gjøres om til et intervju: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” could not be made into an interview: its time cannot be read."
msgstr "«%(name)s» kunne ikke gjøres om til et intervju: tidspunktet kan ikke leses."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a calendar."
msgstr "«%(name)s» er ikke en kalender."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not a task list."
msgstr "«%(name)s» er ikke en oppgaveliste."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is not an address book."
msgstr "«%(name)s» er ikke en adressebok."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” is shared with you to read only; the change on the phone was not applied."
msgstr "«%(name)s» er delt med deg med bare lesetilgang; endringen på telefonen ble ikke tatt i bruk."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” moved to another address on the server; still paired."
msgstr "«%(name)s» ble flyttet til en annen adresse på serveren; fortsatt sammenkoblet."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was not changed from the card: %(why)s"
msgstr "«%(name)s» ble ikke endret ut fra kortet: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "«%(name)s» ble fjernet fra adresseboken; beholdt her."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s” was skipped: %(reason)s"
msgstr "«%(name)s» ble hoppet over: %(reason)s"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s”: %(what)s on the card were not taken, so that none kept here is lost."
msgstr "«%(name)s»: %(what)s på kortet ble ikke tatt med, slik at ingenting som oppbevares her går tapt."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: a number, address or web address on the card was not taken: %(why)s"
msgstr "«%(name)s»: et nummer, en adresse eller en nettadresse på kortet ble ikke tatt med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the email on the card was not taken: %(why)s"
msgstr "«%(name)s»: e-postadressen på kortet ble ikke tatt med: %(why)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card is already held by another record here, so it was not taken."
msgstr "«%(name)s»: nummeret på kortet tilhører allerede en annen oppføring her, så det ble ikke tatt med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the number on the card was not taken."
msgstr "«%(name)s»: nummeret på kortet ble ikke tatt med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card is not a web address, so it was not taken."
msgstr "«%(name)s»: webadressen på kortet er ikke en gyldig webadresse, så den ble ikke tatt med."

#: src/postulo_dav/sync.py
#, python-format
msgid "“%(name)s”: the web address on the card was not taken."
msgstr "«%(name)s»: webadressen på kortet ble ikke tatt med."
