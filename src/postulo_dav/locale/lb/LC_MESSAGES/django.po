#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d Evenementer am Kalenner sinn net vum Postulo a goufen a Rou gelooss."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s gouf op engem aneren Apparat aus dem Kalenner ewechgeholl; hei behalen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(keng Firma)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "E Kontakt, deen hei geläscht gouf, war zënter der leschter Synchronisatioun um Telefon geännert ginn. D'Kaart gouf am Adressbuch gelooss a kënnt beim nächsten Duerchgang als Kontakt zréck."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Adressbuch"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "En App-Passwuert, wou de Server eent ubitt. Verschlësselt gespäichert."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "En Entretien gouf op béide Säite gläichzäiteg geännert; den nächsten Duerchgang entscheet."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "En Entretien, deen hei geläscht gouf, war zënter der leschter Synchronisatioun um Telefon geännert ginn. D'Evenement gouf am Kalenner gelooss."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Kalenner"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Am Kalenner annuléiert."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV a CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Hei geännert den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Hei geännert, mä méi spéit um Telefon geännert; hir Versioun iwwerholl."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Um Telefon geännert den %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Um Telefon geännert, mä méi spéit hei geännert; eis Versioun behalen."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "D'Adressbuch „%(book)s“ an de Kalenner „%(calendar)s“ fonnt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Gëtt bei der éischter Synchronisatioun um Server ugeluecht, wann et net do ass, ausser wann „Nëmme liesen“ ugeschalt ass. Nëmmen dëst Adressbuch gëtt ugepaakt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Gëtt bei der éischter Synchronisatioun um Server ugeluecht, wann en net do ass, ausser wann „Nëmme liesen“ ugeschalt ass. Nëmmen dëse Kalenner gëtt ugepaakt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Ni op de Server schreiwen — och net, fir d'Adressbuch oder de Kalenner unzeleeën. Et kommen ëmmer nach Kontakter an Entretienen eran; näischt geet eraus."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Iwwer http:// geet d'Passwuert onverschlësselt iwwer d'Netzwierk, an „%(host)s“ ass keng Adress an Ärem eegenen Netzwierk. Benotzt https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Passwuert oder App-Passwuert"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Nëmme liesen"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "nëmme liesen"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "„Nëmme liesen“ ass ugeschalt, dofir gëtt näischt ugeluecht: leet et um Server un oder nennt eent, dat do schonn existéiert."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Serveradress"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "D'Adressbuch „%(name)s“ ass net um Server."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "D'Adress muss mat https:// ufänken — zum Beispill %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "De Kalenner „%(name)s“ ass net um Server."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Déi éischt Synchronisatioun leet un, wat feelt."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "D'Wuerzel vum Server, z. B. https://cloud.example.org. Vun do aus fënnt de Postulo d'Adressbuch- an d'Kalennerverzeechnes."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Benotzernumm"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ gouf op béide Säite gläichzäiteg geännert; den nächsten Duerchgang entscheet."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ gouf aus dem Adressbuch ewechgeholl; hei behalen."
