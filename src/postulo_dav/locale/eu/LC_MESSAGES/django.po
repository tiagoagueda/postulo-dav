#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "Egutegiko gertaerak ez dira Postulokoak eta bakarrik geratu dira."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s egutegitik kendua beste gailu batean, hemen gordea."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(enpresarik ez)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Hemen ezabatutako kontaktu bat aldatu egin zen azken sinkronizaziotik. Txartela helbide-liburuan utzi eta kontaktu gisa itzultzen da hurrengo lasterketan."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Helbide-liburua"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Aplikazioaren pasahitza, zerbitzariak eskaintzen duena. Enkriptatua."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Elkarrizketa bat aldatu zen bi aldeetan, eta hurrengo exekuzioak erabakitzen du."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Hemen ezabatutako elkarrizketa bat aldatu egin zen telefonoz azken sinkronizaziotik. Gertaera egutegian geratu zen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Egutegia"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Egutegian bertan behera utzita."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV eta CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Hemen aldatua %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Hemen aldatu zen, baina gero telefonoan aldatu zen."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Telefonoz aldatua %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Telefonoz aldatu zen, baina hemen aldatu zen geroago; gurea gorde zuen."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "\"%(book)s\" helbide-liburua eta \"%(calendar)s\" egutegia aurkitu zituen."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Zerbitzarian lehen sinkronizazioan egina, han ez badago, irakurtzeko soilik ez bada. Helbide-liburu hau bakarrik ukitzen da."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Zerbitzarian lehen sinkronizazioan egina, han ez badago, irakurtzeko soilik ez bada. Egutegi hau bakarrik ukitzen da."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Ez idatzi inoiz zerbitzarira, ezta helbide-liburua edo egutegia egiteko ere. Kontaktuak eta elkarrizketak sartzen dira oraindik; ez da ezer irteten."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Http:// pasahitza sarean zehar doa, eta \"%(host)s\" ez da zure sareko helbide bat. Erabili https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Pasahitza edo aplikazioaren pasahitza"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Irakurtzeko soilik"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "irakurtzeko soilik"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Irakurri besterik ez dago, beraz, ez da ezer egiten: sortu zerbitzarian, edo deitu lehendik dagoen bat."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Zerbitzariaren helbidea"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "\"%(name)s\" helbide-liburua ez dago zerbitzarian."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Helbidea https://-ekin hasi behar da, adibidez %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "\"%(name)s\" egutegia ez dago zerbitzarian."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Lehenengo sinkronizazioak falta dena egingo du."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Zerbitzariaren erroa, adibidez: https://cloud.adibidea.org. Postulok helbide-liburua eta egutegi-etxeak aurkitzen ditu handik."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Erabiltzaile-izena"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "\"%(name)s\" bat-batean aldatu zen bi aldeetan; hurrengo exekuzioak erabakitzen du."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "\"%(name)s\" helbide-liburutik kendu zuten, hemen gordea."
