msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Променено тук, но по-късно променено на телефона; взета е тяхната версия."

#: src/postulo_dav/sync.py
#, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Променено на телефона на %(when)s: %(text)s"

#: src/postulo_dav/sync.py
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Променено на телефона, но по-късно променено тук; запазена е нашата версия."

#: src/postulo_dav/sync.py
msgid "Collections"
msgstr "Колекции"

#: src/postulo_dav/sync.py
msgid "Deadlines and dates"
msgstr "Крайни срокове и дати"

#: src/postulo_dav/backup.py src/postulo_dav/store.py
msgid "Folder address"
msgstr "Адрес на папката"

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the %(what)s “%(name)s” (%(how)s)."
msgstr "Намерено: %(what)s „%(name)s“ (%(how)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the address book “%(book)s” (%(book_href)s) and the calendar “%(calendar)s” (%(calendar_href)s)."
msgstr "Намерени са адресната книга „%(book)s“ (%(book_href)s) и календарът „%(calendar)s“ (%(calendar_href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "Found the task list “%(name)s” (%(href)s)."
msgstr "Намерен е списъкът със задачи „%(name)s“ (%(href)s)."

#: src/postulo_dav/sync.py
#, python-format
msgid "From the card “%(name)s”: %(details)s"
msgstr "От картата „%(name)s“: %(details)s"

#: src/postulo_dav/sync.py
#, python-format
msgid "Hear back from %(company)s about %(role)s"
msgstr "Отговор от %(company)s за %(role)s"

