#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d collection chosen"
msgid_plural "%(count)d collections chosen"
msgstr[0] "Избрана е %(count)d колекция"
msgstr[1] "Избрани са %(count)d колекции"

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d събития в календара не са от Postulo и бяха оставени без промяна."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records are paired with something outside the chosen collection and were left alone."
msgstr "%(count)d записа са сдвоени с нещо извън избраната колекция и бяха оставени непроменени."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d records were not sent, because sending that kind is switched off."
msgstr "%(count)d записа не бяха изпратени, защото изпращането на този вид е изключено."

#: src/postulo_dav/sync.py
#, python-format
msgid "%(count)d task in the task list is not from Postulo and was left alone."
msgid_plural "%(count)d tasks in the task list are not from Postulo and were left alone."
msgstr[0] "%(count)d задача в списъка със задачи не е от Postulo и беше оставена непроменена."
msgstr[1] "%(count)d задачи в списъка със задачи не са от Postulo и бяха оставени непроменени."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s е премахнато от календара на друго устройство; запазено тук."

#: src/postulo_dav/backup.py
#, python-format
msgid "%(name)s is not one of the backups this destination keeps, so it was not deleted."
msgstr "%(name)s не е едно от резервните копия, които това местоназначение пази, затова не беше изтрит."

#: src/postulo_dav/sync.py
msgid "(no company)"
msgstr "(без компания)"

#: src/postulo_dav/sync.py
msgid "(no title)"
msgstr "(без заглавие)"

#: src/postulo_dav/sync.py
msgid "A card cannot be made into that."
msgstr "От картата не може да се направи това."

#: src/postulo_dav/sync.py
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Контакт, изтрит тук, е бил променен на телефона след последната синхронизация. Картата беше оставена в адресната книга и ще се върне като контакт при следващото изпълнение."

#: src/postulo_dav/backup.py
#, python-format
msgid "A different file is already called %(name)s in the folder, and it was not overwritten."
msgstr "В папката вече има друг файл с име %(name)s и той не беше презаписан."

#: src/postulo_dav/sync.py
msgid "A reminder changed on both sides at once; next run decides."
msgstr "Напомняне е променено и от двете страни едновременно; следващото изпълнение ще реши."

#: src/postulo_dav/sync.py
msgid "A reminder deleted here had been changed on the phone since the last sync. The task was left in the task list."
msgstr "Напомняне, изтрито тук, е било променено в телефона след последното синхронизиране. Задачата беше оставена в списъка със задачи."

#: src/postulo_dav/dav.py src/postulo_dav/files.py
msgid "A request outside the chosen collections was not sent."
msgstr "Заявка извън избраните колекции не беше изпратена."

#: src/postulo_dav/sync.py
msgid "A task changed on both sides at once; next run decides."
msgstr "Задача е променена и от двете страни едновременно; следващото изпълнение ще реши."

#: src/postulo_dav/sync.py
msgid "A task moved to another address; still paired."
msgstr "Задача е преместена на друг адрес; все още е сдвоена."

#: src/postulo_dav/sync.py
msgid "address book"
msgstr "адресна книга"

#: src/postulo_dav/sync.py
msgid "Address book"
msgstr "Адресна книга"

#: src/postulo_dav/sync.py
msgid "Address books"
msgstr "Адресни книги"

#: src/postulo_dav/sync.py
msgid "addresses"
msgstr "адреси"

#: src/postulo_dav/store.py
msgid "All in the folder, with descriptive names"
msgstr "Всичко в папката, с описателни имена"

#: src/postulo_dav/sync.py
msgid "All of them"
msgstr "Всички"

#: src/postulo_dav/sync.py
msgid "Also keep two tasks for each application in the task list: one to apply, which ticking sends to you as a suggestion, and one to hear back, which closes when the application ends. Reminders about an application sit under its open task."
msgstr "Пазете и две задачи за всяка кандидатура в списъка със задачи: една за кандидатстване, чието отметване ви изпраща предложение, и една за отговор, която се затваря, когато кандидатурата приключи. Напомнянията за кандидатура стоят под отворената ѝ задача."

#: src/postulo_dav/sync.py
msgid "Also write the whole days of the Calendar page (application deadlines, closing dates of listings and dates an offer must be answered by) to the calendar as all-day events, one way: a change made on the phone is written over. Needs the instance to know its own address."
msgstr "Записване в календара и на целите дни от страницата „Календар“ (крайни срокове за кандидатстване, дати на затваряне на обяви и дати, до които трябва да се отговори на оферта) като събития за цял ден, еднопосочно: промяна, направена на телефона, се презаписва. Изисква инстанцията да знае собствения си адрес."

#: src/postulo_dav/sync.py
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Парола за приложение, където сървърът предлага такава. Съхранява се шифровано."

#: src/postulo_dav/sync.py
msgid "An interview changed on both sides at once; next run decides."
msgstr "Интервю е променено едновременно от двете страни; следващото изпълнение решава."

#: src/postulo_dav/sync.py
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Интервю, изтрито тук, е било променено на телефона след последната синхронизация. Събитието беше оставено в календара."

#: src/postulo_dav/sync.py
msgid "An interview moved to another address on the calendar; still paired."
msgstr "Интервю се премести на друг адрес в календара; все още е сдвоено."

#: src/postulo_dav/sync.py
#, python-format
msgid "Apply to %(role)s at %(company)s"
msgstr "Кандидатстване за %(role)s в %(company)s"

#: src/postulo_dav/store.py
msgid "By company and role, each in its own folder"
msgstr "По компания и длъжност, всяка в своя папка"

#: src/postulo_dav/sync.py
msgid "calendar"
msgstr "календар"

#: src/postulo_dav/sync.py
msgid "Calendar"
msgstr "Календар"

#: src/postulo_dav/sync.py
msgid "Calendars"
msgstr "Календари"

#: src/postulo_dav/sync.py
msgid "Cancelled on the calendar."
msgstr "Отменено в календара."

#: src/postulo_dav/sync.py
msgid "CardDAV and CalDAV"
msgstr "CardDAV и CalDAV"

