#: src/postulo_dav/sync.py
msgid "read only"
msgstr "само за четене"

#: src/postulo_dav/sync.py
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "„Само за четене“ е включено, затова нищо не се създава: създайте го на сървъра или посочете вече съществуващ."

#: src/postulo_dav/sync.py
msgid "Read only on the server"
msgstr "Само за четене на сървъра"

