#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(count)d events on the calendar are not from Postulo and were left alone."
msgstr "%(count)d събития в календара не са от Postulo и бяха оставени без промяна."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "%(kind)s removed from the calendar on another device; kept here."
msgstr "%(kind)s е премахнато от календара на друго устройство; запазено тук."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "(no company)"
msgstr "(без компания)"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "A contact deleted here had been changed on the phone since the last sync. The card was left in the address book, and comes back as a contact on the next run."
msgstr "Контакт изтрит тук е бил променен по телефона от последния синхрон. Картата беше оставена в указателя, и се връща като контакт при следващото движение."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Address book"
msgstr "Адресна книга"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An app password where the server offers one. Stored encrypted."
msgstr "Парола за приложение, където сървърът предлага такава. Съхранява се шифровано."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview changed on both sides at once; next run decides."
msgstr "Интервю е променено едновременно от двете страни; следващото изпълнение решава."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "An interview deleted here had been changed on the phone since the last sync. The event was left on the calendar."
msgstr "Интервю изтрито тук е променено по телефона от последния синхрон. Събитието беше оставено в календара."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Calendar"
msgstr "Календар"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Cancelled on the calendar."
msgstr "Отменено в календара."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "CardDAV and CalDAV"
msgstr "CardDAV и CalDAV"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed here on %(when)s: %(text)s"
msgstr "Променено тук на %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed here, but changed on the phone later; took theirs."
msgstr "Променено тук, но по-късно променено на телефона; взета е тяхната версия."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Changed on the phone on %(when)s: %(text)s"
msgstr "Променено на телефона на %(when)s: %(text)s"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Changed on the phone, but changed here later; kept ours."
msgstr "Променено на телефона, но по-късно променено тук; запазена е нашата версия."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Found the address book “%(book)s” and the calendar “%(calendar)s”."
msgstr "Намерени са адресната книга „%(book)s“ и календарът „%(calendar)s“."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this address book is touched."
msgstr "Направено на сървъра от първия синхрон, ако не е там, освен ако само четете. Само този адресник е докоснат."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Made on the server by the first sync if it is not there, unless read only is on. Only this calendar is touched."
msgstr "Направено на сървъра от първия синхрон, ако не е там, освен ако само четете. Само този календар е докоснат."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Never write to the server — not even to make the address book or the calendar. Contacts and interviews still come in; nothing goes out."
msgstr "Никога не пишете на сървъра, дори за да направите адресника или календара. Контакти и интервюта все още идват; нищо не излиза."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "Over http:// the password goes across the network in the clear, and “%(host)s” is not an address on your own network. Use https://."
msgstr "Над http://password преминава през мрежата в ясно, и %(host)s... не е адрес в собствената си мрежа. Да се използва https://."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Password or app password"
msgstr "Парола или парола за приложение"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only"
msgstr "Само за четене"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "read only"
msgstr "само за четене"

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Read only is on, so nothing is made: create it on the server, or name one that is already there."
msgstr "Прочетете само, така че нищо не е направено: да го създадете на сървъра, или име, което вече е там."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Server address"
msgstr "Адрес на сървъра"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address book “%(name)s” is not on the server."
msgstr "Адресната книга не е на сървъра."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The address must start with https:// — for example %(example)s."
msgstr "Адресът трябва да започне с https://  год. например %(example)s."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "The calendar “%(name)s” is not on the server."
msgstr "Календарът не е на сървъра."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The first sync will make what is missing."
msgstr "Първият синхрон ще направи това, което липсва."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "The server's root, e.g. https://cloud.example.org. Postulo finds the address book and calendar homes from there."
msgstr "Коренът на сървъра, напр. https://cloud.example.org. Оттам Postulo намира местоположенията на адресната книга и календара."

#: src/postulo_dav/sync.py
#, fuzzy
msgid "Username"
msgstr "Потребителско име"

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” changed on both sides at once; next run decides."
msgstr "„%(name)s“ е променен едновременно от двете страни; следващото изпълнение решава."

#: src/postulo_dav/sync.py
#, fuzzy, python-format
msgid "“%(name)s” was removed from the address book; kept here."
msgstr "„%(name)s“ е премахнат от адресната книга; запазен тук."
